#!/bin/sh
# Gerbang pre-push (4 Nov 2026): 12 run terbit.yml gagal di langkah uji dan tak ada yang tahu ~14 jam.
# Uji dijalankan di clone lokal sementara dari commit yang DIDORONG, bukan working tree (sering memuat suntingan sesi lain).
# Bukan git worktree: worktree terdaftar ikut dibersihkan proses lain di tengah uji (4 Nov 2026, dua kali "Cannot find module").
# Lewati (hanya pemilik manusia): LEWATI_UJI=1 git push, atau git push --no-verify.
PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
[ -n "$LEWATI_UJI" ] && exit 0

nol=0000000000000000000000000000000000000000
pakai=
sha_dorong=
while read -r lref lsha rref rsha; do
  [ "$lsha" = "$nol" ] && continue
  case "$rref" in refs/heads/main|refs/heads/staging) ;; *) continue ;; esac
  if [ "$rsha" = "$nol" ] || ! git cat-file -e "$rsha" 2>/dev/null; then
    dasar=$(git merge-base origin/main "$lsha" 2>/dev/null) || dasar=
  else
    dasar=$rsha
  fi
  if [ -z "$dasar" ]; then berkas=$(git ls-tree -r --name-only "$lsha"); else berkas=$(git diff --name-only "$dasar" "$lsha"); fi
  # Jalur pemicu terbit (terbit_antre.yml on.push.paths) ditambah gerbang uji itu sendiri.
  for f in $berkas; do
    case "$f" in
      public/data/*|public/banjir/data/*) ;;
      public/*|src/*|wrangler.jsonc|migrations/*|tests/agen/*|tests/warga/*|tests/sippa/*|package.json|package-lock.json) pakai=1; sha_dorong=$lsha; sha_github=$rsha; ref_github=$rref ;;
    esac
  done
done
[ -z "$pakai" ] && exit 0

utama=$(git rev-parse --show-toplevel)
if [ ! -d "$utama/node_modules" ]; then
  echo "pre-push: node_modules tidak ada. Jalankan 'npm ci' dulu, lalu push lagi." >&2
  exit 1
fi
# Satu uji push sekaligus per repo: beberapa sesi yang mendorong bersamaan membuat uji peramban lewat batas waktu (4 Nov 2026).
# Kunci = direktori berisi pid; kunci milik proses yang sudah mati diambil alih.
kunci="$(git rev-parse --git-common-dir)/uji-push.kunci"
until mkdir "$kunci" 2>/dev/null; do
  lain=$(cat "$kunci/pid" 2>/dev/null)
  if [ -n "$lain" ] && ! kill -0 "$lain" 2>/dev/null; then rm -f "$kunci/pid"; rmdir "$kunci" 2>/dev/null; continue; fi
  [ -z "$tunggu" ] && { echo "pre-push: menunggu uji push lain selesai ..." >&2; tunggu=1; }
  sleep 5
done
echo $$ > "$kunci/pid"
tmp=$(mktemp -d "${TMPDIR:-/tmp}/uji-push.XXXXXX") || exit 1
rmdir "$tmp"
bersih() { rm -rf "$tmp"; rm -f "$kunci/pid"; rmdir "$kunci" 2>/dev/null; }
trap bersih EXIT INT TERM HUP
# git membaca posisi GitHub sebelum hook ini jalan. Kalau main bergerak selama antre atau uji, push ini pasti ditolak ("cannot lock ref");
# berhenti di sini dengan pesan yang bisa dibaca, dan jangan buang menit uji. npm run dorong menyusul lalu mengulang sendiri (10 Nov 2026).
cek_github() {
  kini=$(git ls-remote "${1:-origin}" "$ref_github" 2>/dev/null | cut -f1)
  [ -z "$kini" ] || [ "$kini" = "$sha_github" ] && return 0
  echo "pre-push DIHENTIKAN: main di GitHub sudah maju saat push ini menunggu. Tidak ada yang rusak. Tarik dulu lalu push lagi, atau npm run dorong." >&2
  exit 1
}
cek_github "$1"
# git mengisi GIT_DIR dkk. untuk hook; tanpa unset, checkout dan git di dalam uji menyasar repo utama
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_PREFIX
{ git clone -q --shared --no-checkout "$utama" "$tmp" && git -C "$tmp" checkout -q --detach "$sha_dorong"; } >/dev/null 2>&1 || { echo "pre-push: gagal membuat salinan uji." >&2; exit 1; }
# node_modules terlacak git sebagai symlink relatif ke node_modules.nosync (trik iCloud). Jangan sentuh symlink terlacak itu
# (gerbang jalur mutlak membacanya); sediakan node_modules.nosync di salinan uji yang menunjuk ke modul nyata checkout utama.
modul=$(cd "$utama/node_modules" && pwd -P) || { echo "pre-push: node_modules tidak terbaca." >&2; exit 1; }
if [ -L "$tmp/node_modules" ]; then ln -s "$modul" "$tmp/$(readlink "$tmp/node_modules")"; else ln -s "$modul" "$tmp/node_modules"; fi
echo "pre-push: uji di commit $(echo "$sha_dorong" | cut -c1-9) ..." >&2
gagal=
(cd "$tmp" && npm run uji:agen) >&2 || gagal="uji:agen"
if [ -z "$gagal" ]; then (cd "$tmp" && npm run uji:warga) >&2 || gagal="uji:warga"; fi
if [ -z "$gagal" ]; then (cd "$tmp" && npm run uji:sippa) >&2 || gagal="uji:sippa"; fi
if [ -n "$gagal" ]; then
  echo "pre-push DITOLAK: $gagal gagal. Betulkan ujinya dulu; deploy akan gagal juga di GitHub." >&2
  echo "(Hanya pemilik manusia, darurat: LEWATI_UJI=1 git push, atau git push --no-verify.)" >&2
  exit 1
fi
cek_github "$1"
exit 0
