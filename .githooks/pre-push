#!/bin/sh
# Gerbang pre-push (4 Nov 2026): 12 run terbit.yml gagal di langkah uji dan tak ada yang tahu ~14 jam.
# Uji dijalankan di clone lokal sementara dari commit yang DIDORONG, bukan working tree (sering memuat suntingan sesi lain).
# Bukan git worktree: worktree terdaftar ikut dibersihkan proses lain di tengah uji (4 Nov 2026, dua kali "Cannot find module").
# Lewati (hanya pemilik manusia): LEWATI_UJI=1 git push, atau git push --no-verify.
PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
[ -n "$LEWATI_UJI" ] && exit 0

nol=0000000000000000000000000000000000000000
# Profil peramban tidak pernah boleh terbit (10 Nov 2026: commit "gas" menyapu undefined.prof/ berisi Cookies dan Login Data; repo ini publik).
if git log origin/main..HEAD --name-only --format= 2>/dev/null | grep -qE '(^|/)[^/]*\.prof/'; then
  echo "pre-push DITOLAK: ada profil peramban (*.prof/) di commit yang belum terbit. Buang dari riwayat dulu, jangan cuma git rm." >&2
  exit 1
fi
pakai=
sha_dorong=
while read -r lref lsha rref rsha; do
  [ "$lsha" = "$nol" ] && continue
  case "$rref" in refs/heads/main|refs/heads/staging) ;; *) continue ;; esac
  if [ "$rsha" = "$nol" ] || ! git cat-file -e "$rsha" 2>/dev/null; then
    dasar=$(git merge-base origin/main "$lsha" 2>/dev/null) || dasar=
  else
    dasar=$rsha
  fi
  if [ -z "$dasar" ]; then berkas=$(git ls-tree -r --name-only "$lsha"); else berkas=$(git diff --name-only "$dasar" "$lsha"); fi
  # Jalur pemicu terbit (terbit_antre.yml on.push.paths) ditambah gerbang uji itu sendiri.
  for f in $berkas; do
    case "$f" in
      public/data/*|public/banjir/data/*) ;;
      public/*|src/*|wrangler.jsonc|migrations/*|tests/agen/*|tests/warga/*|tests/sippa/*|package.json|package-lock.json) pakai=1; sha_dorong=$lsha; dasar_dorong=$dasar; sha_github=$rsha; ref_github=$rref ;;
    esac
    # uji:sippa hanya bila berkas SIPPA ikut berubah (pemilik 20 Nov 2026: "seringnya ga berubah"); terbit.yml tetap menjalankannya penuh
    case "$f" in public/pipa/*|tests/sippa/*|src/sippa*|migrations/005[5-7]*|package.json|package-lock.json) sippa=1 ;; esac
  done
done
[ -z "$pakai" ] && exit 0
# Sidik kode = pohon commit tanpa berkas data (public/**/data/). Workflow data meng-commit ke main hampir tiap jam; tanpa ini tiap commit data
# di tengah uji 20 menit membuang uji yang sudah lolos dan mengulangnya dari nol untuk kode yang sama (pemilik 20 Nov 2026: "kenapa sering lama").
lolos="$(git rev-parse --git-common-dir)/uji-lolos"
sidik=$(git ls-tree -r "$sha_dorong" | grep -vE '	public/(.+/)?data/' | git hash-object --stdin)
if [ -n "$sidik" ] && grep -qx "$sidik" "$lolos" 2>/dev/null; then
  echo "pre-push: kode $(echo "$sha_dorong" | cut -c1-9) sama dengan yang sudah lolos uji (hanya data yang berbeda); uji dilewati." >&2
  exit 0
fi

utama=$(git rev-parse --show-toplevel)
if [ ! -d "$utama/node_modules" ]; then
  echo "pre-push: node_modules tidak ada. Jalankan 'npm ci' dulu, lalu push lagi." >&2
  exit 1
fi
# Satu uji push sekaligus per repo: beberapa sesi yang mendorong bersamaan membuat uji peramban lewat batas waktu (4 Nov 2026).
# Kunci = direktori berisi pid; kunci milik proses yang sudah mati diambil alih.
kunci="$(git rev-parse --git-common-dir)/uji-push.kunci"
until mkdir "$kunci" 2>/dev/null; do
  lain=$(cat "$kunci/pid" 2>/dev/null)
  if [ -n "$lain" ] && ! kill -0 "$lain" 2>/dev/null; then rm -f "$kunci/pid"; rmdir "$kunci" 2>/dev/null; continue; fi
  [ -z "$tunggu" ] && { echo "pre-push: menunggu uji push lain selesai ..." >&2; tunggu=1; }
  sleep 5
done
echo $$ > "$kunci/pid"
# Uji yang dibunuh paksa (SIGKILL, timeout sesi) tidak sempat menjalankan trap/finally; salinan repo 1,5-5 GB per uji
# menumpuk sampai disk penuh (24 Nov 2026: 27 GB, uji _headers gagal ENOSPC). Sapu sisa >2 jam; uji yang sedang jalan jauh lebih muda.
find "${TMPDIR:-/tmp}" -maxdepth 1 -type d \( -name 'uji-push.*' -o -name 'uji-push-log.*' -o -name 'headers-*' -o -name 'uji-layar-*' \) -mmin +120 -exec rm -rf {} + 2>/dev/null
tmp=$(mktemp -d "${TMPDIR:-/tmp}/uji-push.XXXXXX") || exit 1
rmdir "$tmp"
log=$(mktemp -d "${TMPDIR:-/tmp}/uji-push-log.XXXXXX") || exit 1
bersih() { rm -rf "$tmp" "$log"; rm -f "$kunci/pid"; rmdir "$kunci" 2>/dev/null; }
trap bersih EXIT INT TERM HUP
# git membaca posisi GitHub sebelum hook ini jalan. Kalau main bergerak selama antre atau uji, push ini pasti ditolak ("cannot lock ref");
# berhenti di sini dengan pesan yang bisa dibaca, dan jangan buang menit uji. npm run dorong menyusul lalu mengulang sendiri (10 Nov 2026).
cek_github() {
  kini=$(git ls-remote "${1:-origin}" "$ref_github" 2>/dev/null | cut -f1)
  [ -z "$kini" ] || [ "$kini" = "$sha_github" ] && return 0
  echo "pre-push DIHENTIKAN: main di GitHub sudah maju saat push ini menunggu. Tidak ada yang rusak. Tarik dulu lalu push lagi, atau npm run dorong." >&2
  exit 1
}
cek_github "$1"
# git mengisi GIT_DIR dkk. untuk hook; tanpa unset, checkout dan git di dalam uji menyasar repo utama
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_PREFIX
{ git clone -q --shared --no-checkout "$utama" "$tmp" && git -C "$tmp" checkout -q --detach "$sha_dorong"; } >/dev/null 2>&1 || { echo "pre-push: gagal membuat salinan uji." >&2; exit 1; }
# node_modules terlacak git sebagai symlink relatif ke node_modules.nosync (trik iCloud). Jangan sentuh symlink terlacak itu
# (gerbang jalur mutlak membacanya); sediakan node_modules.nosync di salinan uji yang menunjuk ke modul nyata checkout utama.
modul=$(cd "$utama/node_modules" && pwd -P) || { echo "pre-push: node_modules tidak terbaca." >&2; exit 1; }
if [ -L "$tmp/node_modules" ]; then ln -s "$modul" "$tmp/$(readlink "$tmp/node_modules")"; else ln -s "$modul" "$tmp/node_modules"; fi
echo "pre-push: uji di commit $(echo "$sha_dorong" | cut -c1-9) ..." >&2
# uji:agen dan uji:warga bersamaan (tidak saling bergantung); keluaran ke berkas supaya tidak bertumpuk, dicetak bila gagal
echo "pre-push: uji:agen dan uji:warga jalan bersamaan${sippa:+, lalu uji:sippa}" >&2
# Hanya uji yang terdampak (pemilik 20 Nov 2026, pola pangantara): scripts/agents/uji_pilih.mjs memilih dari peta ketergantungan yang
# dicatat tiap kali uji jalan (.git/uji-peta-<suite>.json, satu berkas per suite karena suite jalan bersamaan). Belum ada peta atau
# yang berubah pemicu besar = PENUH. Salinan tanpa pemilih (commit lama) = npm run penuh seperti dulu. terbit.yml tetap penuh.
uji() {   # uji <skrip npm>
  if [ -f "$tmp/scripts/agents/uji_pilih.mjs" ]; then
    (cd "$tmp" && node scripts/agents/uji_pilih.mjs "$1" ${dasar_dorong:+--dasar "$dasar_dorong"} --sampai "$sha_dorong" --peta "$umum/uji-peta-$1.json")
  else
    (cd "$tmp" && npm run "$1")
  fi
}
umum=$(cd "$(git rev-parse --git-common-dir)" && pwd)
gagal=
uji uji:agen >"$log/agen" 2>&1 & pa=$!   # npm run uji:agen
uji uji:warga >"$log/warga" 2>&1 & pw=$!   # npm run uji:warga
wait $pa || gagal="uji:agen"
wait $pw || gagal="${gagal:+$gagal dan }uji:warga"
if [ -z "$gagal" ] && [ -n "$sippa" ]; then uji uji:sippa >"$log/sippa" 2>&1 || gagal="uji:sippa"; fi   # npm run uji:sippa
for u in agen warga sippa; do [ -f "$log/$u" ] && grep -E '^uji_pilih|^ℹ (pass|fail) ' "$log/$u" | sed "s/^/pre-push uji:$u: /" >&2; done
if [ -n "$gagal" ]; then
  for u in agen warga sippa; do [ -f "$log/$u" ] && grep -qE '^ℹ fail [1-9]|ERR!|Error' "$log/$u" && { echo "---- uji:$u (80 baris terakhir) ----" >&2; tail -80 "$log/$u" >&2; }; done
  echo "pre-push DITOLAK: $gagal gagal. Betulkan ujinya dulu; deploy akan gagal juga di GitHub." >&2
  echo "(Hanya pemilik manusia, darurat: LEWATI_UJI=1 git push, atau git push --no-verify.)" >&2
  exit 1
fi
# catat sidik yang lolos SEBELUM cek posisi: bila main bergerak karena commit data, percobaan ulang dorong tidak menguji ulang kode yang sama
{ [ -f "$lolos" ] && tail -49 "$lolos"; echo "$sidik"; } > "$lolos.baru" && mv "$lolos.baru" "$lolos"
cek_github "$1"
exit 0
