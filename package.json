{
  "private": true,
  "type": "module",
  "scripts": {
    "uji:warga": "node --test --test-concurrency=1 tests/warga/*.test.mjs",
    "uji:banjir": "node --test --test-concurrency=1 tests/banjir/*.test.mjs",
    "uji:prediksi": "node --test --test-concurrency=1 tests/prediksi/*.test.mjs",
    "uji:udara": "node --test --test-concurrency=1 tests/udara/*.test.mjs",
    "uji:sippa": "node --test --test-concurrency=1 tests/sippa/*.test.mjs",
    "uji": "npm run uji:agen; a=$?; npm run uji:warga; b=$?; npm run uji:sippa; e=$?; npm run uji:banjir; c=$?; npm run uji:udara; d=$?; npm run uji:prediksi; f=$?; [ $a$b$e$c$d$f = 000000 ]",
    "dev:warga": "wrangler dev --local -c wrangler.warga.jsonc --port 8787",
    "agents:build": "node scripts/agents/build.mjs",
    "agents:check": "node scripts/agents/build.mjs --cek",
    "uji:agen": "node --test tests/agen/*.test.mjs",
    "uji:layar": "node --test --test-concurrency=1 tests/bnpb/*.test.mjs",
    "bencana:js": "python3 scripts/umum/bencana.py js",
    "bencana:cek": "python3 scripts/umum/bencana.py cek"
  },
  "devDependencies": {
    "miniflare": "3.20250718.3",
    "wrangler": "^4.151.0"
  }
}
