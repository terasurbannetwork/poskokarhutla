+    def skala_logo_bnpb(self):
+        """Logo BNPB di sampul dan penutup 1,3x ukuran tema (pemilik 2 Nov 2026: "logo bnpb-nya agak gedein", sampul dan penutup).
+        Spek deck boleh menulis "skala_logo_bnpb": <angka> (1 = ukuran tema)."""
+        return float(self.spek.get('skala_logo_bnpb', 1.3))
+
+    def logo_kris(self):
+        """Logo KRIS (Kolaborasi, Responsif, Integratif, Sinkronisasi): akar proyek foto/kris.png, atau aset bersama skill."""
+        for p_ in (self.akar / 'foto/kris.png', Path(__file__).resolve().parents[1] / 'assets/logo-bersama/kris.png'):
+            if p_.exists():
+                return p_.resolve()
+        return None
+
+    def pasang_kris(self, kv, bx_kanan, by, bh, pad, radius, bayang, j):
+        """Logo KRIS resmi dalam kotak putih bersudut membulat tepat di kiri kotak BerAKHLAK, tinggi dan gaya kotak sama, di sampul
+        dan penutup (pemilik 2 Nov 2026: "taruh di dalam rounded box dan di samping kiri gambar BerAkhlak", "cover penutup juga").
+        Pengecualian beralasan: spek deck atau slide "tanpa_kris": "<alasan dari pemilik>"."""
+        if j['spek'].get('tanpa_kris') or self.spek.get('tanpa_kris'):
+            return
+        src = self.logo_kris()
+        if not src:
+            return
+        from PIL import Image
+        self.masukan.add(src)
+        lw_, lh_ = Image.open(src).size
+        ih = bh - 2 * pad; iw = ih * lw_ / lh_
+        kw = iw + 2 * pad * 1.4
+        kx = bx_kanan - 6 - kw
+        kv.bentuk('bulat', kx, by, kw, bh, 'kertas', radius=radius, bayang=bayang)
+        kv.gambar(src, kx + (kw - iw) / 2, by + pad, iw, ih, 'logo')
