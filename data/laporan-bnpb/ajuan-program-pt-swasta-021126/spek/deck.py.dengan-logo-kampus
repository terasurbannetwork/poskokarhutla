def berkas_font(t, bobot):
    """Roboto untuk metrik: ROBOTO_DIR, lalu tema.json font.berkas (font sistem yang juga dipakai soffice), lalu
    assets/fonts di skill. Font sistem tetap wajib untuk PDF; pdffonts di periksa.py menangkap substitusi."""
    nama = Path(t['font']['berkas'][bobot]).name
    calon = ([Path(os.environ['ROBOTO_DIR']) / nama] if os.environ.get('ROBOTO_DIR') else []) + [
        Path(t['font']['berkas'][bobot]).expanduser(), FONT_SKILL / nama]
    for p in calon:
        if p.exists():
            return p
    raise DeckGalat(f'font {nama} tidak ada di {", ".join(map(str, calon))}; pasang Roboto atau setel ROBOTO_DIR')


def soffice():
    """LibreOffice: SOFFICE, lalu soffice/libreoffice di PATH, lalu lokasi baku Homebrew dan macOS."""
    for p in (os.environ.get('SOFFICE'), shutil.which('soffice'), shutil.which('libreoffice'),
              '/opt/homebrew/bin/soffice', '/Applications/LibreOffice.app/Contents/MacOS/soffice'):
        if p and Path(p).exists():
            return p
    raise DeckGalat('soffice (LibreOffice) tidak ditemukan; pasang LibreOffice atau setel SOFFICE')


def sha(p):
    return hashlib.sha256(Path(p).read_bytes()).hexdigest()


def peran_token(t, tok):
    """Peran warna bawaan dari nama token (PEDOMAN B1, gerbang D-24): kategori.<k>, skala.<ramp>, permukaan, inti, aksen."""
    bag = tok.split('.')
    if bag[0] in ('kategori', 'skala'):
        return f'{bag[0]}.{bag[1]}'
    if bag[0] == 'tint':
        return 'permukaan'
    return 'inti' if tok in t['warna']['inti'] else 'aksen'


class Ukur:
    """Lebar teks dari metrik Roboto (PyMuPDF), untuk pas judul, lebar pil, dan cek muat baris."""

    def __init__(self, t):
        self.f = {False: pymupdf.Font(fontfile=str(berkas_font(t, 'regular'))),
                  True: pymupdf.Font(fontfile=str(berkas_font(t, 'bold')))}

    def lebar(self, runs):
        return sum(self.f[r[2]].text_length(r[0], fontsize=r[3]) + r[4] * len(r[0]) for r in runs)

    def baris(self, paras, w):
        """Jumlah baris bila paragraf run dibungkus per kata ke lebar w (pt), seperti renderer."""
        n = 0
        for runs in paras:
            kata, cur = [], []
            for r in runs:
                if r[0] == '\n':  # patah baris paksa
                    kata.append(cur)
                    kata.append(None)
                    cur = []
                    continue
                for i, bag in enumerate(re.split(r'( )', r[0])):
                    if bag == ' ':
                        kata.append(cur)
                        cur = []
                    elif bag:
                        cur.append((bag,) + tuple(r[1:]))
            kata.append(cur)
            garis, isi = 1, 0.0
            for k in kata:
                if k is None:
                    garis, isi = garis + 1, 0.0
                    continue
                lk = self.lebar(k)
                spasi = self.lebar([(' ',) + tuple(k[0][1:])]) if k else 0
                if isi and isi + spasi + lk > w * 0.98:
                    garis, isi = garis + 1, lk
                else:
                    isi += (spasi if isi else 0) + lk
            n += garis
        return n


class Kanvas:
    """Satu slide: bentuk, teks, garis, gambar, ikon dalam satuan pt."""

    def __init__(self, d, slide):
        self.d, self.sh = d, slide.shapes

    def bentuk(self, jenis, x, y, w, h, isi=None, garis=None, tebal=0.75, radius=None, putar=0, bayang=False):
        s = self.sh.add_shape(BENTUK[jenis], E(x), E(y), E(max(w, 0.1)), E(max(h, 0.1)))
        gaya = s._element.find(qn('p:style'))
        if gaya is not None:
            s._element.remove(gaya)
        if isi:
            s.fill.solid()
            s.fill.fore_color.rgb = self.d.rgb(isi)
        else:
            s.fill.background()
        if garis:
            s.line.color.rgb = self.d.rgb(garis)
            s.line.width = Pt(tebal)
        else:
            s.line.fill.background()
        if radius is not None and jenis in ('bulat', 'atas'):
            s.adjustments[0] = min(0.5, radius / max(min(w, h), 0.1))
        if jenis == 'atas':
            s.adjustments[1] = 0.0
        if putar:
            s.rotation = putar
        if bayang:  # bayangan tipis di bawah kontainer membulat (pemilik 26 Okt): turun 1,5 pt, blur 5 pt, gelap 14%
            hx = self.d.catat_warna('teks')[1].lstrip('#').upper()
            sp = s._element.spPr
            sp.append(parse_xml(f'<a:effectLst {nsdecls("a")}><a:outerShdw blurRad="{E(5)}" dist="{E(1.5)}" dir="5400000" '
                                f'algn="t" rotWithShape="0"><a:srgbClr val="{hx}"><a:alpha val="14000"/></a:srgbClr></a:outerShdw></a:effectLst>'))
        return s

    def isi_teks(self, tf, paras, rata='l', jangkar='t', bungkus=True, spasi=None, kiri=0, kanan=0):
        lebar_bentuk = getattr(tf._parent, 'width', None)
        if not bungkus and lebar_bentuk:  # teks tanpa bungkus tidak boleh lebih lebar dari bentuknya (pil R-M03 terpotong, 26 Okt)
            ruang = lebar_bentuk / 12700 - kiri - kanan
            for runs in paras:
                baris = [[]]
                for r in runs:
                    if r[0] == '\n':
                        baris.append([])
                    else:
                        baris[-1].append(r)
                for b in baris:
                    lb = self.d.u.lebar(b)
                    if lb > ruang + 0.5:
                        raise DeckGalat(f'teks "{"".join(r[0] for r in b)[:40]}" {lb:.1f} pt lebih lebar dari bentuknya {ruang:.1f} pt; lebarkan bentuk dari ukuran teks (dari {" < ".join(f.function for f in __import__("inspect").stack()[1:4])})')
        tf.word_wrap = bungkus
        tf.auto_size = MSO_AUTO_SIZE.NONE
        bp = tf._txBody.find(qn('a:bodyPr'))
        for a, v in (('lIns', kiri), ('tIns', 0), ('rIns', kanan), ('bIns', 0)):
            bp.set(a, str(E(v)))
        tf.vertical_anchor = JANGKAR[jangkar]
        if rata == 'j':  # patah baris di teks rata kanan-kiri jadi paragraf baru, supaya baris judul tidak ikut diregangkan
            pecah = []
            for runs in paras:
                pecah.append([])
                for r_ in runs:
                    if r_[0] == '\n':
                        pecah.append([])
                    else:
                        pecah[-1].append(r_)
            paras = pecah
        ruang_j = (lebar_bentuk / 12700 - kiri - kanan) if (rata in ('j', 'l') and bungkus and lebar_bentuk) else None
        for i, runs in enumerate(paras):
            p = tf.paragraphs[0] if i == 0 else tf.add_paragraph()
            p.alignment = RATA[rata]
            if rata == 'l' and ruang_j and runs and not any(r_[0] == '\n' for r_ in runs) and self.d.u.baris([runs], ruang_j) >= 3:
                # pemilik 2 Nov 2026: paragraf lebih dari 2 baris WAJIB rata kanan-kiri, juga bila modul meminta rata kiri
                p.alignment = RATA['j']
            elif rata == 'j' and ruang_j and runs and self.d.u.baris([runs], ruang_j * 0.94) < 3:
                # pemilik 2 Nov 2026: "kalau ada teks yang 2 baris, itu rata kiri juga gapapa, tapi kalau ada yang >2 baris, itu harus justify".
                # Lebar dihitung 6% lebih sempit supaya paragraf yang nyaris 3 baris tetap rata kanan-kiri (tidak pernah salah ke kiri).
                p.alignment = RATA['l']
            if spasi:
                p.line_spacing = spasi
            for teks, wtok, tebal, ukuran, spc in runs:
                if teks == '\n':  # patah baris di dalam paragraf (judul seimbang)
                    p.add_line_break()
                    continue
                semua_miring = wtok.endswith('~i')  # token warna "x~i": seluruh run miring (isi baris sumber, pemilik 26 Okt)
                wtok = wtok.removesuffix('~i')
                for bag, miring in self.d.pecah_asing(teks):  # istilah asing dimiringkan (pemilik 26 Okt)
                    miring = miring or semua_miring
                    r = p.add_run()
                    r.text = bag
                    f = r.font
                    f.name, f.size, f.bold = 'Roboto', Pt(ukuran), tebal
                    if miring:
                        f.italic = True
                    f.color.rgb = self.d.rgb(wtok)
                    rpr = r._r.get_or_add_rPr()
                    rpr.set('lang', 'id-ID')
                    if spc:
                        rpr.set('spc', str(int(round(spc * 100))))
                continue
                r = p.add_run()
                r.text = teks
                f = r.font
                f.name, f.size, f.bold = 'Roboto', Pt(ukuran), tebal
                f.color.rgb = self.d.rgb(wtok)
                rpr = r._r.get_or_add_rPr()
                rpr.set('lang', 'id-ID')
                if spc:
                    rpr.set('spc', str(int(round(spc * 100))))

    def teks(self, x, y, w, h, paras, rata='l', jangkar='t', bungkus=True, spasi=None, kanan=0, rotasi=None):
        if paras and isinstance(paras[0], tuple):
            paras = [paras]
        tb = self.sh.add_textbox(E(x), E(y), E(max(w, 0.1)), E(max(h, 0.1)))
        # rata='j': paragraf 3 baris ke atas rata kanan-kiri, 1-2 baris rata kiri (pemilik 2 Nov 2026), diputuskan per paragraf di isi_teks
        self.isi_teks(tb.text_frame, paras, rata, jangkar, bungkus, spasi, kanan=kanan)
        if rotasi:   # derajat searah jarum jam (putaran 5c)
            tb.rotation = rotasi
        return tb

    def garis(self, x1, y1, x2, y2, wtok, tebal=0.75, putus=False):
        c = self.sh.add_connector(MSO_CONNECTOR.STRAIGHT, E(x1), E(y1), E(x2), E(y2))
        gaya = c._element.find(qn('p:style'))
        if gaya is not None:
            c._element.remove(gaya)
        c.line.color.rgb = self.d.rgb(wtok)
        c.line.width = Pt(tebal)
        if putus:   # penghubung putus-putus (putaran 5f)
            c.line.dash_style = MSO_LINE.DASH
        return c

    def kurva(self, titik, wtok, tebal=1.25, bawah=None):
        """Garis melengkung halus (Catmull-Rom, 8 ruas per pasang titik) lewat titik [(x, y)] pt; y dipotong di 'bawah' (dasar sumbu)."""
        p = [titik[0]] + list(titik) + [titik[-1]]
        hal = []
        for i in range(1, len(p) - 2):
            (x0, y0), (x1, y1), (x2, y2), (x3, y3) = p[i - 1], p[i], p[i + 1], p[i + 2]
            for k in range(8):
                t = k / 8
                f = lambda a, b, c, d: 0.5 * (2 * b + (c - a) * t + (2 * a - 5 * b + 4 * c - d) * t * t + (3 * b - a - 3 * c + d) * t ** 3)
                hal.append((f(x0, x1, x2, x3), min(f(y0, y1, y2, y3), bawah) if bawah is not None else f(y0, y1, y2, y3)))
        hal.append(titik[-1])
        fb = self.sh.build_freeform(E(hal[0][0]), E(hal[0][1]), scale=1.0)
        fb.add_line_segments([(E(a), E(b)) for a, b in hal[1:]], close=False)
        s = fb.convert_to_shape()
        gaya = s._element.find(qn('p:style'))
        if gaya is not None:
            s._element.remove(gaya)
        s.fill.background()
        s.line.color.rgb = self.d.rgb(wtok)
        s.line.width = Pt(tebal)
        s.name = 'Kurva tren'
        return s

    def gambar(self, path, x, y, w, h, jenis=None):
        """jenis: logo, foto, peta, ikon; dicatat per halaman untuk laporan QA deck (Buku Pegangan S37, S39)."""
        if self.d.hal is not None:
            self.d.hal.setdefault('gambar', []).append(jenis or ('logo' if Path(path).resolve() == self.d.logo else 'lain'))
        return self.sh.add_picture(str(path), E(x), E(y), E(w), E(h))

    def ikon(self, konsep, wtok, x, y, d, tebal=2):
        return self.gambar(self.d.ikon(konsep, wtok, tebal), x, y, d, d, 'ikon')

    def bulat_ikon(self, x, y, d, isi, konsep, wtok, rasio):
        self.bentuk('elips', x, y, d, d, isi)
        putih = wtok == 'kertas'  # glif putih di lingkaran gelap: besar dan tebal supaya terbaca (pemilik 26 Okt: "samsek ga keliatan")
        di = d * (max(rasio, 0.64) if putih else rasio)
        self.ikon(konsep, wtok, x + (d - di) / 2, y + (d - di) / 2, di, 2.6 if putih else 2)

    def segitiga(self, x, y, s, naik, wtok):
        return self.bentuk('segitiga', x, y, s, s * 0.8, wtok, putar=0 if naik else 180)


class Deck:
    def __init__(self, spek, nama='spek', akar=None, keluaran=None, berkas_spek=None, registri=None):
        akar = Path(akar or os.environ.get('DECK_AKAR') or AKAR).resolve()
        registri = Path(registri).resolve() if registri else akar / 'data/angka.json'
        self.k = Konteks(akar, angka=json.loads(registri.read_text(encoding='utf-8'))['angka'])
        self.t = self.k.tema
        self.S, self.T, self.K = self.t['slide'], self.t['slide']['tipografi'], self.t['slide']['komponen']
        self.u = Ukur(self.t)
        self.ui = {**UI, **self.t.get('ui', {})}
        import naskah as _nk
        _nk.LOKAL = self.t.get('bahasa', 'id')
        self.spek, self.nama, self.akar = spek, nama, Path(akar)
        for sp_ in spek.get('slide', []):   # putaran 5f: bebas tanpa kepala slide = bingkai kosong (BINGKAI), hanya sah untuk pembatas
            if sp_.get('jenis') == 'bebas' and sp_.get('tanpa_kepala_slide'):
                sp_['jenis'] = 'bebas-polos'
        fmt = spek.get('format')
        if fmt is not None:   # format laporan: bingkai bawaan per jenis laporan (pemilik 31 Okt 2026)
            if fmt not in FORMAT:
                raise DeckGalat(f'{nama}: format {fmt!r} tidak dikenal: {", ".join(FORMAT)}')
            for k, v in FORMAT[fmt].items():
                spek.setdefault(k, v)
        self.keluaran = Path(keluaran or akar / 'keluaran')  # cache ikon dan potongan foto
        self.logo = (self.akar / self.t['header_footer']['header']['logo']).resolve()
        cek_logo_transparan(self.logo)   # pemilik 1 Nov 2026: logo berkotak putih di sampul ditolak
        self.catatan = []  # (asal, butir, nilai) untuk gerbang
        self.peringatan = []   # D-46: butir rekomendasi yang belum berdasar/berisiko (deck lama), dicetak CLI dan masuk manifest
        self._no_gambar = {}   # nomor eksibit per deck: (slide, judul panel) -> N, lintasan gambar kedua memakai nomor yang sama
        self.keputusan_log = []   # D-46: jejak butir keputusan {slide, kode, dasar, lembaga, tenggat, risiko}
        self.hal = None  # halaman yang sedang digambar: nomor, keluarga warna, warna tercatat, judul, struktur, peta
        self.halaman = []  # rekaman per halaman untuk manifest (D-8, D-17, D-24, angka struktur)
        self.masukan = {self.akar / 'tema.json', registri, TEMPLAT, self.logo}
        if berkas_spek:
            self.masukan.add(Path(berkas_spek).resolve())
        self.prs = Presentation(TEMPLAT)
        daftar = self.prs.slides._sldIdLst
        for sid in list(daftar):  # slide templat dibuang; master, tema, layout tetap
            self.prs.part.drop_rel(sid.rId)
            daftar.remove(sid)
        self.lay = {lay.name: lay for lay in self.prs.slide_layouts}
        kaj = spek.get('kajian')
        if kaj not in self.t['kajian'] or not isinstance(self.t['kajian'][kaj], dict):
            raise DeckGalat(f'{nama}: kajian "{kaj}" tidak ada di tema.json kajian')
        self.kaj = self.t['kajian'][kaj]
        self.tgl = date.fromisoformat(spek['tanggal'])
        self.X0, self.W = self.S['margin_kiri_pt'], self.S['lebar_isi_pt']
        self.X1 = self.X0 + self.W
        if spek.get('horizon_label'):  # label chip waktu, mis. "100 hari sejak penetapan"; kode tetap dari kosakata
            asing = set(spek['horizon_label']) - set(self.t['kosakata']['horizon'])
            if asing:
                raise DeckGalat(f'{nama}: horizon_label {sorted(asing)} bukan kode kosakata.horizon')
            self.t['kosakata']['horizon'] = dict(self.t['kosakata']['horizon'], **spek['horizon_label'])
        if spek.get('judul_sampul_maks_baris'):  # Buku Pegangan: judul paling banyak dua baris, huruf dikecilkan
            self.T['judul_sampul'] = dict(self.T['judul_sampul'], maks_baris=spek['judul_sampul_maks_baris'],
                                          ukuran_pt=spek.get('judul_sampul_pt', self.T['judul_sampul']['ukuran_pt']))

    # ------------------------------------------------------------------ dasar
    def visual(self, jenis):
        """Grafik native, tabel native (termasuk matriks dan kisi), atau peta di halaman ini (Buku Pegangan S36)."""
        if self.hal is not None:
            self.hal.setdefault('visual', set()).add(jenis)

    def catat_warna(self, tok):
        """'token' atau 'token@peran' -> hex; dicatat per halaman (hex, peran) untuk gerbang D-24 (PEDOMAN B1.8)."""
        tok, _, peran = tok.partition('@')
        h = warna(self.t, tok)
        if self.hal is not None:
            self.hal['warna'].add((h[1:], peran or peran_token(self.t, tok)))
        return tok, h

    def rgb(self, tok):
        return RGBColor.from_string(self.catat_warna(tok)[1][1:])

    def ikon(self, konsep, wtok, tebal=2):
        return ikon_png(self.t, konsep, self.catat_warna(wtok)[0], self.keluaran / 'ikon', tebal)

    def st(self, teks):
        """Teks berangka buatan mesin (nomor halaman, kode, tanggal, label kosakata): dicatat sebagai struktur, bukan data."""
        if self.hal is not None:
            self.hal['struktur'].append(teks)
        return teks

    def berkeluarga(self):
        """Halaman menampilkan kategori atau ramp api/basah (B1.5, B1.8): arah memakai teks-2 dan katanya ditulis."""
        return bool(self.hal and self.hal['keluarga'] & {'api', 'basah'})

    def arah(self, nilai):
        """Token arah halaman ini: naik oranye, turun biru, 0 teks-3; di halaman berkeluarga api/basah teks-2."""
        A = self.t['warna']['arah']
        tok = A['nol'] if not nilai else A['berkeluarga'] if self.berkeluarga() else A['naik' if nilai > 0 else 'turun']
        return tok + '@arah'

    def kata_arah(self, nilai):
        """Kata naik/turun di depan angka arah: wajib di halaman berkeluarga, karena warnanya tidak lagi membawa arah."""
        return (self.ui['naik'] if nilai > 0 else self.ui['turun']) if self.berkeluarga() and nilai else ''

    def sumber_olah(self, *sumber):
        """Sumber angka turunan: tiap sumber asal diberi awalan pengolahan, sehingga baris Sumber menulis label_olah tema ('diolah BNPB')."""
        aw = self.K['bingkai']['sumber']['awalan_olah']
        bag = []
        for s in sumber:
            for b in (x.strip() for x in s.split(';')):
                b = b[len(aw):].strip() if b.startswith(aw) else b
                if b and not aw.startswith(b) and b not in bag:
                    bag.append(b)
        return '; '.join(f'{aw} {b}' for b in bag)

    def turunan(self, kunci, tampil, nilai, asal, keyakinan, *sumber, dari=()):
        self.k.manifest.append({'kunci': f'turunan:{asal}#{kunci}', 'tampil': tampil, 'nilai': nilai, 'naskah': asal,
                                'keyakinan': keyakinan, 'sumber': self.sumber_olah(*sumber), 'dari': list(dari)})

    def cek_kelas(self, teks, wt, asal):
        """Kartu berlabel kelas indeks (Rendah/Sedang/Tinggi) wajib warna kelas skala.irbi; merah ditolak (T8, B1.1)."""
        m = RE_KELAS.search(teks)
        if not m:
            return
        ir = self.t['warna']['skala']['irbi']
        harus = f'skala.{ir["ramp"]}.{ir["kelas"][ir["label"].index(m[1].capitalize())]}'
        if wt.partition('@')[0] != harus:
            raise DeckGalat(f'{asal}: "{teks[:50]}" berlabel kelas indeks {m[1]}; warna harus {harus}, bukan {wt} '
                            '(T8; PEDOMAN B1.1: merah tidak untuk kelas indeks)')

    def cek_ilustrasi(self, kunci, asal):
        """Angka registri dari baris berlabel ilustrasi (utama=false atau 'hanya ilustrasi') tidak boleh tampil di deck."""
        e = self.k.angka.get(kunci, {})
        jalur = e.get('jalur') or e.get('jalur_rendah') or ''
        catatan = e.get('catatan', '')
        if 'berkas' in e and '].' in jalur:
            baris = ikuti(self.k._muat(e['berkas']), jalur.rsplit('.', 1)[0])
            if isinstance(baris, dict):
                catatan += ' ' + str(baris.get('catatan', ''))
                if str(baris.get('utama', '')).lower() == 'false':
                    catatan += ' hanya ilustrasi'
        if 'hanya ilustrasi' in catatan.lower():
            raise DeckGalat(f'{asal}: angka {kunci} bersumber baris berlabel ilustrasi (utama=false atau "hanya ilustrasi" '
                            f'di {e.get("berkas")}); pakai pasangan utama')

    def pecah_asing(self, teks):
        """[(bagian, miring)]: istilah asing (tema kosakata.asing atau ASING bawaan) dicetak miring."""
        if not hasattr(self, '_re_asing'):
            daftar = self.t.get('kosakata', {}).get('asing') or ASING
            self._re_asing = re.compile(r'(?<![\w-])(' + '|'.join(sorted(map(re.escape, daftar), key=len, reverse=True)) + r')(?![\w-])', re.I)
        out, i = [], 0
        for m in self._re_asing.finditer(teks):
            if m.start() > i:
                out.append((teks[i:m.start()], False))
            out.append((m.group(0), True))
            i = m.end()
        if i < len(teks) or not out:
            out.append((teks[i:], False))
        return out

    def R(self, teks, g, warna_=None, tebal=None, ukuran=None):
        """Satu run dari gaya tipografi: (teks, token warna, tebal, pt, spasi huruf pt)."""
        return (teks, warna_ or g.get('warna', 'teks'), g.get('bobot') == 'bold' if tebal is None else tebal,
                ukuran or pt_dari(g), g.get('spasi_huruf_pt', 0))

    @staticmethod
    def cek_bank(spek, nama):
        """D-10 diperluas (putaran 5c): pasangan koreksi/larangan ber-pola di bank kalimat menolak build bila kena teks tampil."""
        import bank
        kena = bank.periksa_tampil(bank.muat(), spek)
        if kena:
            baris = [f'{j}: "{t[:80]}" kena [{e["jenis"]}] "{e["kalimat"][:60]}", pola /{e["pola"]}/, pengganti: {e["pengganti"] or "(tulis ulang)"}, sumber aturan: {e["sumber"]}'
                     for j, t, e in kena[:8]]
            raise DeckGalat(f'{nama}: {len(kena)} kalimat melanggar bank kalimat pemilik (D-10)\n  ' + '\n  '.join(baris))

    def cek_teks(self, teks, asal):
        for c, nama in DILARANG.items():
            if c in teks:
                raise DeckGalat(f'{asal}: {nama} (U+{ord(c):04X}) di "{teks[:60]}"')
        if RE_EMOJI.search(teks):
            raise DeckGalat(f'{asal}: emoji di "{teks[:60]}"')
        for ist in self.t['kosakata']['istilah']['terlarang']:
            if re.search(rf'(?<!\w){re.escape(ist)}(?!\w)', teks, re.I):
                raise DeckGalat(f'{asal}: istilah terlarang "{ist}" (D-10) di "{teks[:60]}"')
        for pola, aturan in ISTILAH_PEMILIK:
            if re.search(pola, teks, re.I):
                raise DeckGalat(f'{asal}: istilah pemilik (D-10, {aturan}) di "{teks[:60]}"')

    def urai(self, teks, asal):
        """Teks spek -> [(teks, jenis, tebal)]; jenis teks/angka/tempat/sorot. Angka disuntik dari registri."""
        self.cek_teks(teks, asal)
        polos = RE_TOK.sub(lambda m: '' if m[1] else m[3], teks)
        if RE_SISA.search(polos):
            raise DeckGalat(f'{asal}: token tidak dikenal di "{teks[:60]}"; yang ada {{{{angka:}}}}, {{{{tempat:}}}}, {{{{sorot:}}}}')
        sisa = RE_BOLEH.sub('', RE_TOK.sub(lambda m: m[2] if m[1] in ('tempat', 'sorot') else '' if m[1] else m[3], teks))
        if self.hal is not None and self.hal.get('pembatas'):   # slide pembatas: angka biasa (nomor bab, tahun, nomor aturan), dicatat bangun() sebagai urutan spek
            for d_ in re.findall(r'\d+(?:[.,]\d+)?', RE_TOK.sub(lambda m: m[2] if m[1] in ('tempat', 'sorot') else '' if m[1] else m[3], teks)):
                self.hal.setdefault('bab_angka', {})[d_] = float(d_.replace(',', '.'))
        elif re.search(r'\d', sisa):
            raise DeckGalat(f'{asal}: angka diketik di "{teks[:60]}" (D-22); pakai {{{{angka:kunci}}}}')
        segs, pos = [], 0
        for m in RE_TOK.finditer(teks):
            if m.start() > pos:
                segs.append((teks[pos:m.start()], 'teks', False))
            if m[1] == 'angka':
                kunci, _, opsi = m[2].partition('|')
                oranye = '|oranye' in '|' + opsi   # |oranye: angka judul disorot oranye walau halaman berkeluarga api (pemilik 27 Okt: "2,13 kali" di-highlight)
                opsi = '|'.join(o for o in opsi.split('|') if o != 'oranye')
                try:
                    segs.append((self.k.suntik(kunci.strip(), '|' + opsi, asal), 'sorot' if oranye else 'angka', False))
                except (KeyError, ValueError) as e:
                    raise DeckGalat(f'{asal}: {str(e).strip(chr(34))}')
                self.cek_ilustrasi(kunci.strip(), asal)
            elif m[1]:
                segs.append((m[2], m[1], False))
            else:
                segs.append((m[3], 'teks', True))
            pos = m.end()
        if pos < len(teks):
            segs.append((teks[pos:], 'teks', False))
        return segs

    def runs(self, teks, g, asal, mode='isi', warna_=None, ukuran=None, tebal=None):
        """Teks spek -> run bergaya. mode judul: angka dan sorot oranye, tempat biru lembaga; mode isi: angka tebal."""
        out = []
        api = bool(self.hal and 'api' in self.hal['keluarga'])  # B1.8: kategori atau ramp api tampil -> angka judul navy
        for s, jenis, b in self.urai(teks, asal):
            w, tb = warna_, (tebal if tebal is not None else (b or None))
            if mode == 'judul' and jenis == 'angka':
                w = g['warna_angka_berkeluarga' if api else 'warna_angka'] + '@angka-judul'
            elif mode == 'judul' and jenis == 'sorot':
                w = 'kategori.api' if api else g['warna_angka']   # halaman berkeluarga api: sorot judul memakai warna api yang sama artinya (jumlah hotspot), bukan aksen kedua (B1.8)
            elif mode == 'judul' and jenis == 'tempat':
                w = g.get('warna_tempat', 'biru-lembaga')
            elif jenis != 'teks':
                tb = True
            out.append(self.R(s, g, w, tb, ukuran))
        return out

    def muat(self, paras, w, maks, asal, butir):
        if paras and isinstance(paras[0], tuple):
            paras = [paras]
        n = self.u.baris(paras, w)
        if n > maks:
            teks = ''.join(r[0] for r in paras[0])[:60]
            raise DeckGalat(f'{asal}: {butir} {n} baris > {maks} pada lebar {w:.0f} pt ("{teks}"); pendekkan')
        return n

    def tint(self, wtok):
        wtok = wtok.partition('@')[0]
        warna(self.t, wtok)  # token tak dikenal ditolak dulu dengan pesan tema.py
        m = self.K['kartu']['tint_ikon']
        if wtok in m:
            return m[wtok]
        if wtok.startswith('kategori.'):
            return f"tint.{self.t['warna']['kategori'][wtok.split('.')[1]]['tint']}.pita"
        if wtok.startswith('skala.'):  # B1.4: kelas 1 tiap ramp = tint pita keluarganya, jadi kelas berlatar tint netral
            return 'tint.netral.pita'
        raise DeckGalat(f'warna "{wtok}" tidak punya tint di slide.komponen.kartu.tint_ikon')

    def gelap(self, j):
        """Semua halaman terang (pemilik 26 Okt 2026 "Semua terang", 31 Okt 2026 "Jadikan terang" untuk penutup dan
        pembatas lampiran). Halaman berlatar navy, lewat tema slide.layout.gelap_untuk atau "layout": "gelap" di spek
        slide, ditolak. Panel daftar isi berfoto ("panel_sisi": "gelap") bukan halaman navy dan tetap boleh."""
        if j['spek'].get('layout') == 'gelap' or j['jenis'] in self.S['layout'].get('gelap_untuk', []):
            raise DeckGalat(f"{j['asal']}: halaman berlatar navy dilarang (pemilik 31 Okt 2026: semua halaman terang)")
        return False

    def bawah(self, ada_sumber=True):
        B = self.K['bingkai']
        return self.S['area_isi_y_pt'][1]  # sumber pindah ke baris kaki (pemilik 26 Okt), isi boleh sampai batas area isi

    # ------------------------------------------------------------------ data CSV
    def opsi_fmt(self, f):
        o = {'flag': set()}
        for bag in filter(None, str(f).split('|')):
            if bag.isdigit():
                o['fmt'] = bag
            else:
                o['flag'].add(bag)
        return o

    def tampil(self, v, f, kyk):
        """Angka sel; kolom 'arah' tanpa kata (segitiga yang membawa arah), kecuali di halaman berkeluarga (B1.5)."""
        o = self.opsi_fmt(f)
        if 'arah' in o['flag'] and not self.berkeluarga():
            o['flag'].discard('arah')
            v = abs(v)
        return format_angka(v, None, None, '', kyk, o)

    def data(self, sp, asal):
        """Tabel dari CSV (saring, urut, batas, kolom) seperti tabel csv naskah; tiap angka masuk manifest."""
        for w in ('csv', 'kolom', 'sumber', 'keyakinan'):
            if w not in sp:
                raise DeckGalat(f'{asal}: data tanpa "{w}"')
        kyk = sp['keyakinan'].split(';')[0].strip()
        if kyk not in self.t['kosakata']['keyakinan']:
            raise DeckGalat(f'{asal}: keyakinan "{kyk}" bukan salah satu dari lima label (tema.json kosakata.keyakinan)')
        p = self.akar / sp['csv']
        if not p.exists():
            raise DeckGalat(f'{asal}: csv {sp["csv"]} tidak ada (relatif ke akar proyek {self.akar})')
        self.masukan.add(p)
        with p.open(encoding='utf-8') as f:
            rows = list(csv.DictReader(f))
        for syarat in filter(None, (s.strip() for s in sp.get('saring', '').split(';'))):
            beda = '!=' in syarat
            k_, _, v = syarat.partition('!=' if beda else '=')
            rows = [r for r in rows if (r.get(k_.strip()) == v.strip()) != beda]
        if not rows:
            raise DeckGalat(f'{asal}: {sp["csv"]} kosong setelah saring "{sp.get("saring", "")}"')
        if sp.get('urut'):
            u = sp['urut'].lstrip('-')
            rows.sort(key=lambda r: float(r[u]) if r[u] != '' else float('-inf'), reverse=sp['urut'].startswith('-'))
        if sp.get('batas'):
            rows = rows[:int(sp['batas'])]
        kolom = [c if isinstance(c, dict) else {'nama': c} for c in sp['kolom']]
        ganti = self.t['kosakata']['istilah']['ganti']
        for c in kolom:
            if c['nama'] not in rows[0]:
                raise DeckGalat(f'{asal}: kolom "{c["nama"]}" tidak ada di {sp["csv"]}')
            self.cek_teks(c.get('kepala', ''), asal)
        baris = []
        for r in rows:
            sel = []
            for c in kolom:
                v = r[c['nama']]
                if c.get('fmt') and v != '':
                    x = float(v)
                    s = self.tampil(x, c['fmt'], kyk)
                    self.k.manifest.append({'kunci': f'csv:{sp["csv"]}#{c["nama"]}', 'tampil': s, 'nilai': x, 'naskah': asal,
                                            'keyakinan': sp['keyakinan'], 'sumber': sp['sumber']})
                    sel.append({'teks': s, 'nilai': x})
                else:
                    s = c.get('ganti', {}).get(v) or ganti.get(v, v) if v != '' else '–'  # ganti per kolom: kode besaran -> label tampil
                    self.cek_teks(s, asal)
                    if re.search(r'\d', s):  # teks sel berangka dari CSV ("274.000 liter, 23 desa"): bersumber, dicatat agar D-22 tahu asalnya
                        self.k.manifest.append({'kunci': f'csvteks:{sp["csv"]}#{c["nama"]}', 'tampil': s, 'nilai': None, 'naskah': asal,
                                                'keyakinan': sp['keyakinan'], 'sumber': sp['sumber']})
                    sel.append({'teks': s, 'nilai': None})
            baris.append(sel)
        return {'kolom': kolom, 'baris': baris, 'keyakinan': sp['keyakinan'], 'sumber': sp['sumber'],
                'sorot': set(sp.get('sorot', []))}

    def seimbang(self, teks, g, w, maks, asal):
        """Patah baris seimbang untuk judul sampul: tiap baris muat, baris terpanjang sependek mungkin (tanpa yatim)."""
        kata = teks.split(' ')
        lebar = lambda ks: self.u.lebar([self.R(' '.join(ks), g)])
        if lebar(kata) <= w * 0.98:
            return [teks]
        from itertools import combinations
        for n in range(2, maks + 1):
            calon = []
            for potong in combinations(range(1, len(kata)), n - 1):
                bag = [kata[a:b] for a, b in zip((0,) + potong, potong + (len(kata),))]
                lw = [lebar(b) for b in bag]
                if max(lw) <= w * 0.98:
                    calon.append((max(lw), [' '.join(b) for b in bag]))
            if calon:
                return min(calon)[1]
        raise DeckGalat(f'{asal}: judul sampul lebih dari {maks} baris; pendekkan')

    # ------------------------------------------------------------------ komponen
    def lebar_pil(self, runs, h, ikon=False):
        C = self.K['chip']
        pad = h * C['pad_rasio']
        return pad * 2 + self.u.lebar(runs) + (h * C['ikon_rasio'] + pad * 0.6 if ikon else 0)

    def pil(self, kv, x, y, runs, h, isi=None, garis=None, ikon=None, warna_ikon=None, w=None, rata='c', kanan=False, geser=0):
        """Pil membulat penuh berteks (dan ikon). x = tepi kiri, atau tepi kanan bila kanan=True. Kembalikan lebar."""
        C = self.K['chip']
        di = h * C['ikon_rasio'] if ikon else 0
        pad = h * C['pad_rasio']
        lebar = w or self.lebar_pil(runs, h, bool(ikon))
        if kanan:
            x -= lebar
        pil = lambda tok: tok and (tok if '@' in tok or tok.startswith(('kategori.', 'skala.')) else tok + '@pil')  # pil berteks: arti di teksnya
        s = kv.bentuk('bulat', x, y, lebar, h, pil(isi or 'kertas'), pil(garis), radius=h / 2)
        kiri = (pad + di + pad * 0.6 if ikon else pad) + geser   # geser: ruang segitiga panah di depan teks
        kv.isi_teks(s.text_frame, [runs], rata='l' if ikon else rata, jangkar='m', bungkus=False,
                    kiri=kiri if ikon or rata == 'l' else 0)
        if ikon:
            kv.ikon(ikon, warna_ikon, x + pad, y + (h - di) / 2, di)
        return lebar

    def pil_nada(self, kv, x, y, teks, g, h, nada, ikon=None, kanan=False):
        """Pil berkosakata nada_pil/keyakinan/status_usulan: {pil_isi | pil_garis, pil_teks}."""
        tw = nada['pil_teks']
        return self.pil(kv, x, y, [self.R(teks, g, tw)], h, nada.get('pil_isi', 'kertas'), nada.get('pil_garis'),
                        ikon, tw, kanan=kanan)

    def pil_keyakinan(self, kv, x_kanan, y, h, kode):
        kyk, *tamb = [p.strip() for p in kode.split(';')]
        if kyk not in self.t['kosakata']['keyakinan']:
            raise DeckGalat(f'keyakinan "{kyk}" bukan salah satu dari lima label (D-14)')
        v = self.t['kosakata']['keyakinan'][kyk]
        if not self.S.get('pil_keyakinan', False):  # pemilik 26 Okt 2026: pil Resmi/Terverifikasi tidak ditampilkan; label tetap di manifest
            return 0
        return self.pil_nada(kv, x_kanan, y, v['label'] + (', ' + tamb[0] if tamb else ''), self.T['chip'], h, v, kanan=True)

    def pil_bagian(self, kv, x, y, teks, ikon, nada):
        P = self.K['pil_bagian']
        n = self.t['kosakata']['nada_pil'][nada]
        return self.pil(kv, x, y, [self.R(teks.upper(), self.T['pil_bagian'], n['pil_teks'])], P['tinggi_pt'],
                        n.get('pil_isi', 'kertas'), n.get('pil_garis'), ikon, n['pil_teks'])

    def grup_kartu(self, kv, grup, y, asal):
        G, KR = self.K['grup_kartu'], self.K['kartu']
        n = sum(len(g['kartu']) for g in grup)
        tetap = sum(2 * G['pad_pt'] + (len(g['kartu']) - 1) * KR['jarak_pt'] for g in grup) + G['jarak_pt'] * (len(grup) - 1)
        cw = (self.W - tetap) / n
        if cw < KR['lebar_pt'][0]:
            raise DeckGalat(f'{asal}: {n} kartu terlalu banyak (lebar {cw:.0f} pt < {KR["lebar_pt"][0]} pt)')
        x = self.X0
        for g in grup:
            nada = g.get('nada', 'data')
            gw = 2 * G['pad_pt'] + len(g['kartu']) * cw + (len(g['kartu']) - 1) * KR['jarak_pt']
            if not self.terbuka():
                kv.bentuk('bulat', x, y, gw, G['tinggi_pt'], G['nada'][nada]['warna_latar'], radius=G['radius_pt'])
            bw = self.pil_bagian(kv, x + G['pad_pt'], y + G['pil_dy_pt'], g['pil'], g.get('ikon', 'data'), nada)
            m0 = len(self.k.manifest)
            for i, k in enumerate(g['kartu']):
                self.kartu(kv, x + G['pad_pt'] + i * (cw + KR['jarak_pt']), y + G['kartu_dy_pt'], cw, k, asal)
            baru = self.k.manifest[m0:]
            if not baru:
                raise DeckGalat(f'{asal}: grup "{g["pil"]}" tanpa angka registri; label keyakinan kartu tidak bisa diturunkan (KERANGKA 4)')
            kyk = max((m['keyakinan'] for m in baru), key=lambda v: URUT_YAKIN.index(v.split(';')[0].strip()))
            C, PB = self.K['chip'], self.K['pil_bagian']
            yw = self.pil_keyakinan(kv, x + gw - G['pad_pt'], y + G['pil_dy_pt'] + (PB['tinggi_pt'] - C['tinggi_pt']) / 2, C['tinggi_pt'], kyk)
            if bw + yw + G['pad_pt'] > gw - 2 * G['pad_pt']:
                raise DeckGalat(f'{asal}: pil grup "{g["pil"]}" menabrak pil keyakinan; pendekkan pil atau tambah kartu')
            x += gw + G['jarak_pt']
        return y + G['tinggi_pt']

    def kartu(self, kv, x, y, w, k, asal):
        KR = self.K['kartu']
        wt, h, d = k.get('warna', 'navy'), KR['tinggi_pt'], KR['lingkaran_pt']
        self.cek_kelas(k['label'], wt, asal)
        if re.search(r'\{\{angka:[^}]*\|arah', k['nilai']):  # nilai berarah: warnanya arah halaman ini (B1.5, B1.8)
            m0 = len(self.k.manifest)
            awal = self.urai(k['nilai'], asal)[0][0]
            wt = self.arah(-1 if awal.startswith('turun') else 1 if awal.startswith('naik') else 0)
            del self.k.manifest[m0:]  # urai di atas hanya untuk membaca arah; nilai dicatat sekali di bawah
        if self.terbuka():
            kv.garis(x - KR['jarak_pt'] / 2, y + 4, x - KR['jarak_pt'] / 2, y + h - 4, 'garis')
        else:
            kv.bentuk('bulat', x, y, w, h, 'kertas', KR['warna_garis'], radius=KR['radius_pt'], bayang=True)
        kv.bulat_ikon(x + KR['lingkaran_dx_pt'], y + (h - d) / 2, d, self.tint(wt), k['ikon'], wt, KR['ikon_pt'] / d)
        tx, tw = x + KR['teks_dx_pt'], w - KR['teks_dx_pt'] - KR['lingkaran_dx_pt']
        nilai = self.runs(k['nilai'], self.T['nilai_kartu'], asal, warna_=wt, tebal=True)
        label = self.runs(k['label'], self.T['label_kartu'], asal)
        self.muat(label, tw, 1, asal, 'label kartu')
        if k.get('pil'):  # pil persen di kanan nilai ("2,2%"), warna capaian; pemilik 26 Okt: "labelnya berapa persen"
            rp = self.runs(k['pil'], dict(self.T['label_kartu'], ukuran_pt=pt_dari(self.T['label_kartu']) * 1.25), asal, tebal=True)
            pw_ = self.u.lebar(rp) + 14
            ph_ = KR['nilai_tinggi_pt'] * 0.62
            self.pil(kv, tx + tw - pw_, y + KR['nilai_dy_pt'] + (KR['nilai_tinggi_pt'] - ph_) / 2, rp, ph_, k.get('pil_isi', 'tint.api.pita'), w=pw_)
            tw_n = tw - pw_ - 6
        else:
            tw_n = tw
        self.muat(nilai, tw_n, 1, asal, 'nilai kartu')
        sn = kv.teks(tx, y + KR['nilai_dy_pt'], tw_n, KR['nilai_tinggi_pt'], nilai, jangkar='m', bungkus=False)
        sn.name = 'Nilai kartu'
        if self.hal is not None:
            self.hal.setdefault('kartu', []).append((''.join(r[0] for r in nilai), asal))
        kv.teks(tx, y + KR['label_dy_pt'], tw, KR['label_tinggi_pt'], label, jangkar='m', bungkus=False).name = 'Label kartu'

    def panel(self, kv, x, y, w, h, judul, ikon, nada='netral', hitungan=None, keyakinan=None, asal=''):
        """Panel putih berpita kepala; kembalikan kotak isi (x, y, w, h)."""
        P = self.K['panel']
        N, pita = P['nada'][nada], P['pita_pt']
        if self.S.get('judul_panel_kapital'):  # judul panel huruf kapital di awal kata (pemilik 26 Okt)
            judul = judul_kapital(judul)
        if self.hal is not None:  # D-40: badan panel (di bawah pita kepala) diukur ruang kosongnya dari render
            self.hal.setdefault('panel', []).append([round(x, 1), round(y + pita, 1), round(w, 1), round(h - pita, 1), str(judul)[:60]])
        buka = self.terbuka()
        if buka:   # tanpa kompartemen (pemilik 31 Okt: "kenapa harus dalam kompartemen"): ikon + judul + garis navy;
            kv.garis(x, y + pita, x + w, y + pita, 'navy', 1.0)   # geometri isi tetap sama dengan panel berkotak
        else:
            kv.bentuk('bulat', x, y, w, h, 'kertas', radius=P['radius_pt'], bayang=True)
            kv.bentuk('bulat', x, y, w, pita, N['warna_pita'], radius=P['radius_pt'])
            kv.bentuk('kotak', x, y + pita / 2, w, pita / 2, N['warna_pita'])
            kv.bentuk('bulat', x, y, w, h, None, P['warna_garis'], P['tebal_garis_pt'], radius=P['radius_pt'])
        d = P['lingkaran_pt']
        kv.bulat_ikon(x + P['pad_pt'], y + (pita - d) / 2, d, N['warna_ikon'], ikon, 'kertas', P['ikon_pt'] / d)
        kanan = x + w - P['pad_pt']
        if hitungan:
            r = self.runs(hitungan, self.T['hitungan_panel'], asal, warna_=N['warna_ikon'], tebal=True)
            hw = self.u.lebar(r)
            kv.teks(kanan - hw - 2, y, hw + 2, pita, r, rata='r', jangkar='m', bungkus=False)
            kanan -= hw + P['pad_pt']
        if keyakinan:
            kanan -= self.pil_keyakinan(kv, kanan, y + (pita - self.K['chip']['tinggi_pt']) / 2, self.K['chip']['tinggi_pt'], keyakinan) + P['pad_pt']
        jx = x + P['pad_pt'] + d + P['jarak_judul_pt']
        jr = self.runs(judul, self.T['judul_panel'], asal)
        uk = pt_dari(self.T['judul_panel'])
        while self.u.lebar(jr) > kanan - jx and uk > pt_dari(self.T['judul_panel']) * 0.85:   # judul panel panjang: huruf turun sampai 85%, tetap satu baris
            uk -= 0.25
            jr = self.runs(judul, self.T['judul_panel'], asal, ukuran=uk)
        self.muat(jr, kanan - jx, 1, asal, 'judul panel')
        kv.teks(jx, y, kanan - jx, pita, jr, jangkar='m', bungkus=False)
        jarak = max(self.K['jarak_isi_ke_tepi_panel_pt'], P['pad_pt'])   # jarak isi ke tepi bawah = jarak ke tepi kiri-kanan (pemilik 27 Okt)
        return x + P['pad_pt'], y + pita + P['pad_pt'] * 0.8, w - 2 * P['pad_pt'], h - pita - P['pad_pt'] * 0.8 - jarak

    def pita(self, kv, x, y, w, p, asal):
        PB = self.K['pita_bawah']
        f = p.get('skala', 1)  # pita yang ditonjolkan (Purpose of the meeting): huruf, ikon, dan tinggi ikut diperbesar
        N, h = PB['nada'][p.get('nada', 'data')], PB['tinggi_baku_pt'] * f
        PB = {k: (v * f if isinstance(v, (int, float)) and k.endswith('_pt') and k not in ('radius_pt', 'pad_pt') else v) for k, v in PB.items()}
        if self.terbuka():
            kv.garis(x, y, x + w, y, 'garis-kuat', 0.75)
        else:
            kv.bentuk('bulat', x, y, w, h, N['warna_latar'], radius=PB['radius_pt'], bayang=True)   # pita juga berbayang tipis (pemilik 27 Okt)
        kv.teks(x + PB['pad_pt'], y + PB['label_dy_pt'], w / 2, PB['label_tinggi_pt'],
                [self.R(p['label'].upper(), self.T['label_bagian'], N['warna_label'])], bungkus=False)
        kol = p['kolom']
        cw = (w - 2 * PB['pad_pt']) / len(kol)
        d = PB['lingkaran_pt']
        for i, c in enumerate(kol):
            cx = x + PB['pad_pt'] + i * cw
            if i:
                kv.garis(cx - PB['pad_pt'] / 2, y + PB['pemisah_dy_pt'], cx - PB['pad_pt'] / 2, y + h - PB['pemisah_bawah_pt'],
                         N['warna_pemisah'] + '@garis')  # garis hias, bukan kelas skala
            kv.bulat_ikon(cx, y + PB['lingkaran_dy_pt'], d, N['warna_ikon'], c['ikon'], 'kertas', PB['ikon_pt'] / d)
            tx, tw = cx + PB['teks_dx_pt'], cw - PB['teks_dx_pt'] - PB['pad_pt']
            gj, gi = self.T['judul_kolom_pita'], self.T['isi_pita']
            if f != 1:
                gj, gi = dict(gj, ukuran_pt=round(gj['ukuran_pt'] * f, 1)), dict(gi, ukuran_pt=round(gi['ukuran_pt'] * f, 1))
            jr = self.runs(c['judul'], gj, asal)
            ir = self.runs(c['isi'], gi, asal)
            self.muat(jr, tw, 1, asal, 'judul kolom pita')
            self.muat(ir, tw, 2, asal, 'isi kolom pita')
            kv.teks(tx, y + PB['judul_dy_pt'], tw, PB['judul_tinggi_pt'], jr, bungkus=False)
            kv.teks(tx, y + PB['isi_dy_pt'], tw, h - PB['isi_dy_pt'] - 4, ir, rata='j')  # teks 2-3 baris rata kanan-kiri
        return h

    def daftar_temuan(self, kv, x, y, w, h, items, asal, kolom=2):
        """Temuan bernomor (Pesan Kunci, PEDOMAN B5.26): lingkaran ikon, kode "Temuan B.1", temuan <= 3 baris, pil keyakinan kanan."""
        TM, C = self.K['temuan'], self.K['chip']
        for it in items:
            if not re.fullmatch(TM['pola_kode'], it.get('kode', '')):
                raise DeckGalat(f'{asal}: kode temuan "{it.get("kode")}" harus berbentuk "Temuan B.1" (PEDOMAN B5.26; bentuk '
                                'telanjang bertabrakan dengan "Tabel A.1" dan lampiran "A1", D-27)')
            if it.get('keyakinan', '').split(';')[0].strip() not in self.t['kosakata']['keyakinan']:
                raise DeckGalat(f'{asal}: {it["kode"]} tanpa keyakinan dari lima label (PEDOMAN B5.26: tiap temuan ditutup '
                                'label keyakinan)')
        nb = math.ceil(len(items) / kolom)
        rh = min(TM['baris_maks_pt'], h / nb)
        y += (h - rh * nb) / 2
        cw = (w - (kolom - 1) * TM['jarak_kolom_pt']) / kolom
        d, g, gk = TM['lingkaran_pt'], self.T['temuan_isi'], self.T['temuan_kode']
        # kode "Temuan A.1" tetap di spek untuk lacak, tidak ditampilkan bila tema slide.kode_temuan false (pemilik 26 Okt 2026)
        tampil_kode = self.S.get('kode_temuan', False)
        kode_w = max(self.u.lebar([self.R(it['kode'], gk)]) for it in items) + TM['jarak_pt'] if tampil_kode else 0
        yakin = lambda kyk: self.t['kosakata']['keyakinan'][kyk.split(';')[0].strip()]['label'] + (
            ', ' + kyk.split(';')[1].strip() if ';' in kyk else '')
        pil_w = max(self.lebar_pil([self.R(yakin(it['keyakinan']), self.T['chip'])], C['tinggi_pt']) for it in items)
        if not self.S.get('pil_keyakinan', False):
            pil_w = 0
        kx0 = d + TM['jarak_pt']
        tw = cw - pil_w - TM['jarak_pil_pt'] - kx0 - kode_w
        g0, m_awal = g, len(self.k.manifest)
        for f_ in (1, 0.96, 0.92, 0.88, 0.84, 0.8):   # huruf temuan mengecil sendiri sampai muat (T-7), paling kecil 80% dari yang diminta
            g = dict(g0, ukuran_pt=pt_dari(g0) * f_)
            del self.k.manifest[m_awal:]
            try:
                siap = []  # lintasan pertama: teks dan jumlah baris tiap temuan (runs mencatat manifest angka, jadi sekali saja)
                for it in items:
                    m0 = len(self.k.manifest)
                    r = self.runs(it['teks'], g, asal)
                    lemah = max((URUT_YAKIN.index(m['keyakinan'].split(';')[0].strip()) for m in self.k.manifest[m0:]), default=0)
                    if URUT_YAKIN.index(it['keyakinan'].split(';')[0].strip()) < lemah:
                        raise DeckGalat(f'{asal}: {it["kode"]} berlabel {it["keyakinan"]}, lebih kuat dari angka terlemahnya '
                                        f'({URUT_YAKIN[lemah]}); keyakinan temuan ikut angka terlemah (C6.2)')
                    maks = TM['maks_baris']
                    if self.S.get('temuan_judul_baris') and r and r[0][2] and r[0][0].rstrip().endswith('.'):
                        # judul tebal di baris sendiri, isi di bawahnya (pemilik 26 Okt: "judul dan isi dipisahkan ... label dan enter")
                        r = [(r[0][0].rstrip()[:-1],) + tuple(r[0][1:]), ('\n',) + tuple(r[0][1:])] + [((r[1][0].lstrip(),) + tuple(r[1][1:]))] + r[2:] if len(r) > 1 else r
                        maks += 1
                    r2 = []
                    for run_ in r:  # "\n" di teks spek = patah baris
                        for j_, bag in enumerate(run_[0].split('\n')):
                            if j_:
                                r2.append(('\n',) + tuple(run_[1:]))
                            if bag:
                                r2.append((bag,) + tuple(run_[1:]))
                    r = r2
                    maks += sum(1 for run_ in r if run_[0] == '\n') - (1 if self.S.get('temuan_judul_baris') and maks > TM['maks_baris'] else 0)
                    nbar = self.muat(r, tw, maks, asal, f'{it["kode"]}')
                    siap.append((it, r, nbar, nbar * pt_dari(g) * TM['tinggi_baris']))
                # tinggi baris mengikuti jumlah baris teksnya, sisa ruang dibagi rata; teks tidak menabrak garis pemisah (pemilik 26 Okt)
                tinggi = [[rh] * nb for _ in range(kolom)]
                if kolom == 1:
                    perlu = [max(d, th) + 8 for *_, th in siap]
                    h_ = h - 6  # isi tidak menempel tepi bawah panel (>= 7 pt, T-7)
                    if sum(perlu) > h_:   # jarak antarbutir dipadatkan dulu; baris rata lama membuat teks panjang menimpa butir berikutnya (T-7)
                        perlu = [max(d, th) + 2 for *_, th in siap]
                    if sum(perlu) > h_:
                        raise DeckGalat(f'{asal}: {len(siap)} temuan butuh {sum(perlu):.0f} pt, panel hanya {h_:.0f} pt; turunkan skala_huruf '
                                        'panel atau pendekkan kalimat (teks tidak boleh saling menimpa, T-7)')
                    tambah = (min(h_, TM['baris_maks_pt'] * nb) - sum(perlu)) / nb
                    tinggi = [[p_ + tambah for p_ in perlu]]
                    y = y - (h - rh * nb) / 2 + (h_ - sum(tinggi[0])) / 2
                break
            except DeckGalat:
                if f_ == 0.8:
                    raise
        for i, (it, r, nbar, th) in enumerate(siap):
            k_, b_ = i // nb, i % nb
            cx, ry = x + k_ * (cw + TM['jarak_kolom_pt']), y + sum(tinggi[k_][:b_])
            rh_i = tinggi[k_][b_]
            # baris berikon tanpa garis pemisah horizontal (pemilik 26 Okt); jarak antarbaris yang memisahkan
            kx = cx + kx0
            tx = kx + kode_w
            cy = ry + rh_i / 2  # ikon dan teks sama-sama di tengah baris
            iy = cy - d / 2
            kv.bulat_ikon(cx, iy, d, TM['warna_lingkaran'], it['ikon'], 'kertas', TM['ikon_rasio'])
            if tampil_kode:
                kv.teks(kx, iy, kode_w, d, [self.R(it['kode'], gk)], jangkar='m', bungkus=False)
            hh_ = max(th + 2, d)  # teks temuan rata tengah vertikal terhadap ikon dan kodenya (pemilik 26 Okt 2026)
            kv.teks(tx, cy - hh_ / 2, tw, hh_, r, rata='j' if nbar > 1 else 'l', jangkar='m')  # 2-3 baris selalu rata kanan-kiri, kolom sempit juga (pemilik 26 Okt: "udah gw tetapkan")
            self.pil_keyakinan(kv, cx + cw, iy + (d - C['tinggi_pt']) / 2, C['tinggi_pt'], it['keyakinan'])

    def paras_daftar(self, butir, g, asal):
        if len(butir) > 6:
            raise DeckGalat(f'{asal}: daftar {len(butir)} butir > 6 (Buku Pegangan S38: paling banyak 6 butir per daftar)')
        return [[self.R(self.t['font']['butir_1'] + '  ', g, 'teks-3')] + self.runs(b, g, asal) for b in butir]

    def tinggi_daftar(self, paras, g, w, gantung=False):
        # gantung=True (putaran 5f, dipakai skala otomatis): baris berinden gantung selebar butir, jadi teks dibungkus pada w dikurangi lebar butir;
        # ukuran ini yang sebenarnya dirender (tanpa ini daftar sempit terukur terlalu pendek dan butir terakhir menyentuh pita Sumber)
        if gantung and paras:
            return pt_dari(g) * 1.2 * self.u.baris([p[1:] for p in paras], w - self.u.lebar([paras[0][0]])) + pt_dari(g) * 0.5 * (len(paras) - 1)
        return pt_dari(g) * 1.2 * self.u.baris(paras, w) + pt_dari(g) * 0.5 * (len(paras) - 1)

    def daftar(self, kv, x, y, w, h, butir, asal, g=None, lega=False):
        g = g or self.T['isi_daftar']
        paras = self.paras_daftar(butir, g, asal)
        tinggi = self.tinggi_daftar(paras, g, w)
        if tinggi > h:
            raise DeckGalat(f'{asal}: daftar setinggi {tinggi:.0f} pt tidak muat di {h:.0f} pt; kurangi butir')
        tb = kv.teks(x, y, w, h, paras, rata='j')  # butir 2-3 baris rata kanan-kiri; baris terakhir tetap kiri (pemilik 26 Okt 2026)
        gantung = E(self.u.lebar([paras[0][0]]))
        for i, p in enumerate(tb.text_frame.paragraphs):  # inden gantung: baris lanjutan sejajar teks, bukan butir
            if i:
                ekstra = min((h - self.tinggi_daftar(paras, g, w, True)) / max(len(butir) - 1, 1) * 0.9, pt_dari(g) * 2.0) if lega else 0   # skala otomatis: sisa tinggi jadi jarak antarbutir
                p.space_before = Pt(pt_dari(g) * 0.5 + max(ekstra, 0))
            ppr = p._p.get_or_add_pPr()
            ppr.set('marL', str(gantung))
            ppr.set('indent', str(-gantung))
            # butir asli PowerPoint, bukan teks "•  ": spasi setelah butir tidak ikut melebar saat rata kanan-kiri
            p._p.remove(p.runs[0]._r)
            clr = ppr.makeelement(qn('a:buClr'), {})
            clr.append(clr.makeelement(qn('a:srgbClr'), {'val': str(self.rgb('teks-3'))}))
            ppr.append(clr)
            ppr.append(ppr.makeelement(qn('a:buFont'), {'typeface': self.t['font']['keluarga']}))  # Roboto, bukan OpenSymbol (D-4)
            ppr.append(ppr.makeelement(qn('a:buChar'), {'char': self.t['font']['butir_1']}))

    def peringkat(self, kv, x, y, w, h, tb, asal, nomor=True, total=False, ikon_baris=None):
        """Tabel peringkat native (d5 s1): nomor dalam bulatan navy, kolom metrik berpil, baris sorot, baris total navy."""
        sk = tb.get('skala_huruf')
        if sk:  # tabel berbaris lega: huruf diperbesar agar tidak banyak ruang kosong (pemilik 26 Okt)
            asli = {k: self.T[k] for k in ('label_tabel_utama', 'isi_tabel', 'nilai_tabel', 'total_tabel')}
            try:
                for k, g0 in asli.items():
                    self.T[k] = dict(g0, ukuran_pt=pt_dari(g0) * sk)
                return self.peringkat(kv, x, y, w, h, dict(tb, skala_huruf=None), asal, nomor, total, ikon_baris)
            finally:
                self.T.update(asli)
        TP = self.K['tabel_peringkat']
        kol, rows = tb['kolom'], tb['baris']
        self.visual('tabel')
        n_label = next((i for i, c in enumerate(kol) if c.get('fmt')), len(kol))
        hk, d = TP['kepala_tinggi_pt'], TP['bulatan_pt']
        grup = any(c.get('grup') for c in kol)  # kepala dua tingkat: "Ke daerah" di atas, "Unit" dan "Rp" di bawahnya (pemilik 26 Okt)
        HK = hk * 2 if grup else hk
        tot_h = max(TP['total_pt'], pt_dari(self.T['total_tabel']) * 1.8)  # pita Jumlah ikut membesar bersama hurufnya
        rh = min(tb.get('baris_maks_pt', TP['baris_maks_pt']), (h - HK - (tot_h + 4 if total else 0)) / len(rows))  # spek boleh melonggarkan tinggi baris tabel pendek
        if rh < TP['baris_min_pt']:
            raise DeckGalat(f'{asal}: {len(rows)} baris peringkat tidak muat ({rh:.1f} pt < {TP["baris_min_pt"]} pt)')
        # lebar kolom metrik: pil kepala atau isi terlebar
        lm = []
        for j in range(n_label, len(kol)):
            c = kol[j]
            isi = max(self.u.lebar([self.R(r[j]['teks'], self.T['nilai_tabel'])]) for r in rows) + (TP['segitiga_pt'] + 3 if 'arah' in str(c.get('fmt', '')) else 0)
            if c.get('pil'):
                isi += 2 * pt_dari(self.T['nilai_tabel'])  # pil berjarak 1 em kiri-kanan
            if total and c.get('jumlah', True) and 'arah' not in str(c.get('fmt', '')) and 'persen' not in str(c.get('fmt', '')):  # angka Jumlah ikut menentukan lebar kolom
                d_ = str(c.get('fmt', '')).split('|')[0]
                isi = max(isi, self.u.lebar([self.R(fmt_id(sum(r[j]['nilai'] or 0 for r in rows), int(d_) if d_.isdigit() else None), self.T['total_tabel'])]))
            # kepala kolom teks biasa, tanpa pil berlabel (pemilik 26 Okt 2026); warna kolom tetap untuk isi
            kep = self.u.lebar([self.R(c.get('kepala', '').upper(), self.T['kepala_kolom'])])
            lm.append(max(isi, kep) + TP['kolom_jarak_pt'])
        ox = 8  # isi kolom utama tidak menempel tepi kiri pita abunya (pemilik 26 Okt)
        x_label = x + ox + (d + TP['kolom_jarak_pt'] if nomor else 0)
        # label yang menyisakan ruang lebih dari 40% lebar membuat angka bertumpuk di kanan; sisanya dibagi ke kolom metrik
        lebar_isi_label = max([self.u.lebar([self.R(r[j]['teks'], self.T['label_tabel_utama'])]) for r in rows for j in range(n_label)]
                              + [self.u.lebar([self.R(kol[j].get('kepala', '').upper(), self.T['kepala_kolom'])]) + 4 for j in range(n_label)] + [0]) + 24  # kepala kolom ikut menentukan lebar; +24 pt supaya label pendek (tahun) tidak rapat ke kolom berikut (pemilik 27 Okt)
        # kolom label selebar isinya (pemilik 27 Okt: kolom pertama lebar dengan label pendek "aneh banget"); sisa ke kolom angka
        sisa_label = (x + w - sum(lm) - x_label) - lebar_isi_label * n_label
        if lm and sisa_label > 0:
            lm = [v + sisa_label / len(lm) for v in lm]
        x_metrik = x + w - sum(lm)
        lebar_label = (x_metrik - x_label) / max(n_label, 1)
        bobot = [kol[j].get('bobot', 1) for j in range(n_label)]  # lebar kolom teks sebanding bobot (default sama rata)
        LW = [(x_metrik - x_label) * b / max(sum(bobot), 1) for b in bobot]
        LX = [x_label + sum(LW[:j]) for j in range(n_label)]
        # kepala: latar navy, tulisan putih, rata tengah (pemilik 26-27 Okt 2026)
        kv.bentuk('bulat', x, y, w, HK, TP['warna_total'], radius=3).name = 'Pita kepala tabel'
        gk = dict(self.T['kepala_kolom'], warna='kertas')
        for j in range(n_label):
            kv.teks(LX[j], y, LW[j] - 4, HK, [self.R(kol[j].get('kepala', '').upper(), gk)], rata='c', jangkar='m', bungkus=False)  # kepala selalu rata tengah (pemilik 26 Okt)
        xm, rentang = x_metrik, []
        for j, lw in zip(range(n_label, len(kol)), lm):
            c = kol[j]
            ya, ha = (y + hk, hk) if c.get('grup') else (y, HK)
            kv.teks(xm, ya, lw - TP['kolom_jarak_pt'], ha, [self.R(c.get('kepala', '').upper(), gk)], rata='c', jangkar='m', bungkus=False)
            if c.get('grup'):
                if rentang and rentang[-1][0] == c['grup'] and rentang[-1][2] == xm:
                    rentang[-1][2] = xm + lw
                else:
                    rentang.append([c['grup'], xm, xm + lw])
            xm += lw
        for nama, ga, gb in rentang:  # label grup di atas kolomnya, garis tipis di bawah label
            rg = [self.R(nama.upper(), gk, tebal=True)]
            self.muat(rg, gb - ga - TP['kolom_jarak_pt'], 1, asal, f'kepala grup "{nama}"')
            kv.teks(ga, y, gb - ga - TP['kolom_jarak_pt'], hk, rg, rata='c', jangkar='m', bungkus=False)
            kv.garis(ga + 4, y + hk - 1, gb - TP['kolom_jarak_pt'] - 4, y + hk - 1, 'kertas', 0.5)
        y0 = y + HK
        pita_x1 = x
        if n_label:  # kolom pertama = parameter utama: pita biru muda di belakangnya, data di kanan merujuk ke sini (pemilik 26 Okt)
            # pita rapat ke huruf terakhir label terpanjang (+12 pt), tidak sampai menempel kolom kedua
            pita_x1 = LX[0] + LW[0] - 6  # kolom label sudah selebar isinya; pita berhenti sebelum kolom kedua
            kv.bentuk('kotak', x, y0, pita_x1 - x, len(rows) * rh, 'tint.basah.muda').name = 'Pita kolom utama'  # bukan panel (T-7)
        # kepala navy menggantikan garis atas dan garis bawah kepala; garis paling bawah tetap hitam
        kv.garis(x, y0 + len(rows) * rh, x + w, y0 + len(rows) * rh, TP['warna_garis_kepala'], 0.75)  # garis paling bawah baris data
        # sel kolom pertama yang sama berturut-turut digabung, ditulis sekali (pemilik 27 Okt: tidak menulis data berulang)
        gabung = {}
        if n_label:
            i_ = 0
            while i_ < len(rows):
                k_ = i_
                while k_ + 1 < len(rows) and rows[k_ + 1][0]['teks'] == rows[i_][0]['teks']:
                    k_ += 1
                gabung[i_] = k_ - i_ + 1
                for m_ in range(i_ + 1, k_ + 1):
                    gabung[m_] = 0
                i_ = k_ + 1
        for i, r in enumerate(rows):
            ry = y0 + i * rh
            label_teks = r[0]['teks']
            if label_teks in tb['sorot']:
                kv.bentuk('kotak', x, ry + 0.5, w, rh - 1, TP['warna_sorot'])
            elif i:  # garis baris tetap tampak di atas pita biru (pemilik 27 Okt); di dalam sel gabungan garis mulai dari kolom kedua
                kv.garis(pita_x1 if gabung.get(i) == 0 else x, ry, x + w, ry, 'garis', 0.6)  # pemisah baris abu sedang, tidak terlalu muda (pemilik 27 Okt)
            if nomor and gabung.get(i) != 0:  # sel gabungan: satu nomor di tengahnya, nomor urut per kelompok (pemilik 27 Okt)
                no_urut = sum(1 for k_ in range(i + 1) if gabung.get(k_) != 0)
                rg_ = rh * gabung.get(i, 1)
                dd = min(d, rh - 3)
                if ikon_baris and ikon_baris.get(label_teks):  # ikon jenis per baris menggantikan nomor urut (pemilik 26 Okt 2026)
                    kv.bulat_ikon(x + ox, ry + (rg_ - dd) / 2, dd, TP['warna_nomor'], ikon_baris[label_teks], 'kertas', 0.62)
                else:
                    s = kv.bentuk('elips', x + ox, ry + (rg_ - dd) / 2, dd, dd, TP['warna_nomor'])
                    kv.isi_teks(s.text_frame, [[self.R(self.st(str(no_urut)), self.T['nomor_peringkat'])]], 'c', 'm', False)
            for j in range(n_label):
                g = self.T['label_tabel_utama'] if j == 0 else self.T['isi_tabel']
                pil_kol = (kol[j].get('pil') or {}).get(r[j]['teks'])
                if pil_kol:  # label status berbentuk pil: {"nilai": ["isi", "garis", "warna teks"]} (pemilik 26 Okt 2026)
                    isi_p, garis_p, teks_p = pil_kol
                    rr = [self.R(self.st(r[j]['teks']), self.T['chip'], teks_p)]  # isi pil dari CSV (bersumber), dicatat sebagai struktur
                    ph = min(self.K['chip']['tinggi_pt'] + 2, rh - 3)
                    pw = self.lebar_pil(rr, ph)
                    self.pil(kv, LX[j] + (LW[j] - 4 - pw) / 2, ry + (rh - ph) / 2, rr, ph, isi_p, garis_p, w=pw)
                    continue
                rh_sel = rh
                if j == 0:
                    if gabung.get(i) == 0:
                        continue
                    rh_sel = rh * gabung.get(i, 1)
                rr = [self.R(r[j]['teks'], g)]
                mb = tb.get('sel_maks_baris', 2)   # sel daftar nama (KHG, pemilik 27 Okt) boleh lebih dari 2 baris bila barisnya cukup tinggi
                maks_sel = next((m_ for m_ in range(mb, 1, -1) if tb.get('sel_dua_baris') and rh_sel >= pt_dari(g) * m_ * 1.3 + 6), 1)  # baris lega: sel boleh 2 baris agar huruf bisa besar
                nb_sel = self.muat(rr, LW[j] - 4, maks_sel, asal, 'label peringkat')
                kv.teks(LX[j], ry, LW[j] - 4, rh_sel, rr, rata=kol[j].get('rata', 'c' if j else 'l'), jangkar='m', bungkus=nb_sel > 1)  # kolom teks lanjutan sejajar kepala tengah
            xm = x_metrik
            for j, lw in zip(range(n_label, len(kol)), lm):
                c, sel = kol[j], r[j]
                xr = xm + lw - TP['kolom_jarak_pt']
                if 'arah' in str(c.get('fmt', '')) and sel['nilai'] is not None:
                    naik = sel['nilai'] > 0
                    wt = self.arah(sel['nilai'])
                    rr = [self.R(sel['teks'], self.T['nilai_tabel'], wt)]
                    tw = self.u.lebar(rr)
                    kv.teks(xr - tw - 1, ry, tw + 1, rh, rr, rata='r', jangkar='m', bungkus=False)
                    if sel['nilai']:
                        s_ = TP['segitiga_pt']
                        kv.segitiga(xr - tw - 3 - s_, ry + (rh - s_ * 0.8) / 2, s_, naik, wt)
                else:
                    amb = c.get('pil_ambang')  # nilai berpil warna menurut ambang: [[min, isi, teks], ...] dari atas (pemilik 26 Okt)
                    if amb and sel['nilai'] is not None:
                        isi_p, teks_p = next((a_[1], a_[2]) for a_ in amb if sel['nilai'] >= a_[0])
                        ruang, uk = lw - TP['kolom_jarak_pt'], pt_dari(self.T['nilai_tabel'])
                        panah = c.get('pil_panah') and sel['nilai'] != 0   # segitiga naik/turun di dalam pil, angka tanpa tanda minus (pemilik 27 Okt)
                        tks = sel['teks'].lstrip('-\u2212') if panah else sel['teks']
                        if tks != sel['teks']:   # tanda minus diganti segitiga turun: manifest mencatat yang tampil (D-6, D-22)
                            for m_ in reversed(self.k.manifest):
                                if m_.get('tampil') == sel['teks']:
                                    m_['tampil'] = tks
                                    break
                        rr = [self.R(tks, self.T['nilai_tabel'], teks_p, True, uk)]
                        while self.u.lebar(rr) + 2 * uk > ruang and uk > 8:  # teks tidak mepet tepi pil: jarak kiri-kanan = 1 em (pemilik 26 Okt)
                            uk -= 0.5
                            rr = [self.R(tks, self.T['nilai_tabel'], teks_p, True, uk)]
                        ph = min(uk * 1.8, rh - 3)
                        s_ = uk * 0.6 if panah else 0
                        pw = min(self.u.lebar(rr) + 2 * uk + (s_ + 3 if panah else 0), ruang)
                        px = xm + (lw - TP['kolom_jarak_pt'] - pw) / 2
                        self.pil(kv, px, ry + (rh - ph) / 2, rr, ph, isi_p, None, w=pw, rata='l' if panah else 'c', geser=s_ + 3 if panah else 0)
                        if panah:
                            kv.segitiga(px + uk * 0.75, ry + (rh - s_ * 0.8) / 2, s_, sel['nilai'] > 0, teks_p)
                    elif (c.get('pil') or {}).get(sel['teks']):  # kolom status teks di kanan berbentuk pil berwarna (pemilik 27 Okt)
                        isi_p, garis_p, teks_p = c['pil'][sel['teks']]
                        uk = pt_dari(self.T['nilai_tabel'])
                        rr = [self.R(sel['teks'], self.T['nilai_tabel'], teks_p, True, uk)]
                        ph, pw = min(uk * 1.8, rh - 3), min(self.u.lebar(rr) + 2 * uk, lw - TP['kolom_jarak_pt'])
                        self.pil(kv, xm + (lw - TP['kolom_jarak_pt'] - pw) / 2, ry + (rh - ph) / 2, rr, ph, isi_p, garis_p, w=pw)
                    else:
                        kv.teks(xm, ry, lw - TP['kolom_jarak_pt'], rh, [self.R(sel['teks'], self.T['nilai_tabel'])], rata='c', jangkar='m', bungkus=False)  # sejajar kepala rata tengah
                xm += lw
        bawah = y0 + len(rows) * rh
        if total:
            ty = bawah + 4
            kv.bentuk('bulat', x, ty, w, tot_h, TP['warna_total'], radius=3)
            xj = max(x_label, x + 10)  # "Jumlah" tidak menempel tepi pita (pemilik 26 Okt)
            rj = [self.R(self.ui['jumlah'], self.T['total_tabel'])]
            kv.teks(xj, ty, max(lebar_label - (xj - x_label), self.u.lebar(rj) + 2), tot_h, rj, jangkar='m', bungkus=False)
            xm = x_metrik
            for j, lw in zip(range(n_label, len(kol)), lm):
                if kol[j].get('jumlah', True) and 'arah' not in str(kol[j]['fmt']) and 'persen' not in str(kol[j]['fmt']):  # jumlah: false = kolom tidak dijumlah (PM2,5)
                    jml = sum(r[j]['nilai'] or 0 for r in rows)
                    d_ = str(kol[j]['fmt']).split('|')[0]
                    tj = fmt_id(jml, int(d_) if d_.isdigit() else None)  # jumlah berdesimal sama dengan kolomnya
                    self.turunan(f'jumlah:{kol[j]["nama"]}', tj, jml, asal, tb['keyakinan'], tb['sumber'])
                    kv.teks(xm, ty, lw - TP['kolom_jarak_pt'], tot_h, [self.R(tj, self.T['total_tabel'])], rata='c', jangkar='m', bungkus=False)
                xm += lw
            bawah = ty + tot_h
        return bawah

    def grafik_batang(self, kv, x, y, w, h, g, asal):
        """Grafik batang native pola laporan harian: ujung atas membulat, nilai di atas, label dan % perubahan di bawah, tanpa sumbu Y."""
        GB = self.K['grafik_batang']
        self.visual('grafik')
        tb = self.data(g['data'], asal)
        if g['data'].get('seri') == 'kolom':
            r = tb['baris'][0]
            pasang = [(c.get('kepala', c['nama']), sel) for c, sel in zip(tb['kolom'], r)]
        else:
            pasang = [(r[0]['teks'], r[1]) for r in tb['baris']]
        if any(p[1]['nilai'] is None for p in pasang):
            raise DeckGalat(f'{asal}: grafik butuh kolom angka ber-fmt')
        if len(pasang) > GB['maks_batang']:
            raise DeckGalat(f'{asal}: {len(pasang)} batang > {GB["maks_batang"]} (G1); ringkas per periode')
        kel = GB['keluarga'][g.get('keluarga', 'netral')]
        vals = [p[1]['nilai'] for p in pasang]
        # kepala: nama metrik kiri, perubahan neto kanan (segitiga vektor + kata)
        jr = self.runs(g['judul'], self.T['judul_grafik'], asal)
        kv.teks(x, y, w * 0.6, GB['kepala_tinggi_pt'], jr, jangkar='m', bungkus=False)
        if g.get('satuan_pil'):   # satuan sumbu sebagai pil kecil di kiri atas grafik (pemilik 27 Okt: "dalam ribu titik dibuat bagus")
            ph = self.K['chip']['tinggi_pt']
            self.pil(kv, x, y + (GB['kepala_tinggi_pt'] - ph) / 2, [self.R(g['satuan_pil'], self.T['chip'], 'kertas')], ph, 'navy')
        # batang kategori (provinsi, jenis): tanpa perubahan neto dan persen antarbatang, karena urutannya bukan waktu
        if vals[0] and g.get('ubah', True):
            ubah = (vals[-1] - vals[0]) / vals[0] * 100
            naik = ubah > 0
            wt = self.arah(ubah)
            teks = (self.ui['naik'] if naik else self.ui['turun']) + fmt_id(abs(ubah), 1) + '%'
            self.turunan('ubah', teks, ubah, asal, tb['keyakinan'], tb['sumber'])
            rr = [self.R(teks, self.T['ubah_grafik'], wt)]
            tw = self.u.lebar(rr)
            kv.teks(x + w - tw - 1, y, tw + 1, GB['kepala_tinggi_pt'], rr, rata='r', jangkar='m', bungkus=False)
            s_ = GB['segitiga_kepala_pt']
            kv.segitiga(x + w - tw - 4 - s_, y + (GB['kepala_tinggi_pt'] - s_ * 0.8) / 2, s_, naik, wt)
        sorot = self.sorot_batang(g, pasang, vals, asal)
        if g.get('arah') == 'horizontal' and not (g.get('tumpuk') or g.get('ganda')):
            return self.batang_horizontal(kv, x, y + GB['kepala_tinggi_pt'] + 4, w, h - GB['kepala_tinggi_pt'] - 4, g, pasang, vals, sorot, kel, tb, asal)
        dua = g.get('tumpuk') or g.get('ganda')
        LGh = self.K['legenda']['tinggi_pt'] + 6 if dua else 0   # legenda di bawah figur (pemilik 27 Okt)
        dasar = y + h - GB['bawah_pt'] - LGh
        atas = y + GB['kepala_tinggi_pt'] + GB['nilai_tinggi_pt'] + 2
        slot = w / len(pasang)
        puncak_ganda = {}   # titik puncak tiap seri grafik ganda: kurva tren ditarik setelah semua batang
        bw = slot * GB['lebar_rasio']
        vmax = max(vals) or 1
        n = len(pasang)
        for i, (lab, sel) in enumerate(pasang):
            bx = x + i * slot + (slot - bw) / 2
            bh = max((dasar - atas) * sel['nilai'] / vmax, 0.5)
            wb = (kel['warna_pekat'] if g.get('seragam')  # satu warna: tanpa sandi warna yang perlu legenda (ANTI-SLOP 5.8)
                  else (kel['warna_pekat'] if i in sorot else kel['warna_lama']) if sorot is not None   # sorot dari data/spek (putaran 5b, celah 6)
                  else GB['warna_pembanding'] if i == 0 and g.get('pembanding', True)
                  else kel['warna_pekat'] if i >= n - GB['pekat_terakhir'] else kel['warna_lama'])
            if g.get('ganda'):  # dua batang per kategori: kolom 1 pekat, kolom 2 pembanding muda (pemilik 27 Okt: tren bulanan 2026 dibanding 2019)
                sel2 = tb['baris'][i][2]
                vm = max(max(v[1]['nilai'] or 0, v[2]['nilai'] or 0) for v in tb['baris']) or 1
                b2 = slot * 0.48   # dua batang mengisi slot: ruang kosong kecil (D-40)
                for k_, (ss, wb_) in enumerate(((sel2, kel['warna_lama']), (sel, kel['warna_pekat']))):
                    hh = max((dasar - atas) * (ss['nilai'] or 0) / vm, 0.5)
                    xx = x + i * slot + slot * 0.02 + k_ * b2
                    puncak_ganda.setdefault(k_, []).append((xx + (b2 - 1) / 2, dasar - hh - (GB['nilai_tinggi_pt'] + 4 if k_ else 0)))   # kurva di atas angka batang
                    kv.bentuk('atas', xx, dasar - hh, b2 - 1, hh, wb_, radius=b2 * GB['radius_rasio'])
                    kv.teks(xx - 4, dasar - hh - GB['nilai_tinggi_pt'] - 1, b2 + 7, GB['nilai_tinggi_pt'],   # nilai di atas tiap batang: pembanding juga terbaca (D-6)
                            [self.R(ss['teks'], self.T['nilai_batang'], 'teks' if k_ else 'teks-3')], rata='c', jangkar='b', bungkus=False)
            elif g.get('tumpuk'):  # batang 100% bertumpuk: kolom 1 pekat di bawah, kolom 2 muda di atas, nilai di dalam ruasnya (pemilik 27 Okt: bandingkan gambut dan mineral)
                sel2 = tb['baris'][i][2]
                tot = (sel['nilai'] or 0) + (sel2['nilai'] or 0) or 1
                hb = dasar - atas + GB['nilai_tinggi_pt']
                h1, h2 = hb * sel['nilai'] / tot, hb * sel2['nilai'] / tot
                kv.bentuk('atas', bx, dasar - h1 - h2, bw, h2, kel['warna_lama'], radius=bw * GB['radius_rasio'])
                kv.bentuk('kotak', bx, dasar - h1, bw, h1, kel['warna_pekat'])
                for hh, yy, ss, wt in ((h1, dasar - h1, sel, 'kertas'), (h2, dasar - h1 - h2, sel2, 'teks')):
                    if hh >= GB['nilai_tinggi_pt'] + 2:
                        kv.teks(bx, yy, bw, hh, [self.R(ss['teks'], self.T['nilai_batang'], wt)], rata='c', jangkar='m', bungkus=False)
                    elif ss is sel and ss['nilai']:   # ruas bawah terlalu tipis: callout pil gelap di atas ruas, bergaris penunjuk (pemilik 27 Okt)
                        rr = [self.R(ss['teks'], self.T['nilai_batang'], 'kertas')]
                        ph = GB['nilai_tinggi_pt'] + 2
                        pw = self.u.lebar(rr) + ph
                        kv.garis(bx + bw / 2, yy, bx + bw / 2, yy - 6, kel['warna_pekat'], 0.75)
                        self.pil(kv, bx + (bw - pw) / 2, yy - 6 - ph, rr, ph, kel['warna_pekat'], None, w=pw)
            else:
                kv.bentuk('atas', bx, dasar - bh, bw, bh, wb, radius=bw * GB['radius_rasio'])
                kv.teks(x + i * slot, dasar - bh - GB['nilai_tinggi_pt'] - 1, slot, GB['nilai_tinggi_pt'],
                        [self.R(sel['teks'], self.T['nilai_batang'])], rata='c', jangkar='b', bungkus=False)
            kv.teks(x + i * slot, dasar + 2, slot, GB['label_tinggi_pt'], [self.R(lab, self.T['tanggal_batang'])], rata='c', jangkar='t', bungkus=False)
            if i and vals[i - 1] and g.get('persen_batang', True):
                p = (vals[i] - vals[i - 1]) / vals[i - 1] * 100
                naik = p > 0
                wt = self.arah(round(p, 1))
                teks = self.kata_arah(round(p, 1)) + fmt_id(abs(p), 1) + '%'
                self.turunan(f'persen:{lab}', teks, p, asal, tb['keyakinan'], tb['sumber'])
                rr = [self.R(teks, self.T['persen_batang'], wt)]
                tw, s_ = self.u.lebar(rr), GB['segitiga_pt']
                lx = x + i * slot + (slot - tw - s_ - 2) / 2
                py = dasar + 2 + GB['label_tinggi_pt']
                if round(p, 1):
                    kv.segitiga(lx, py + (GB['persen_tinggi_pt'] - s_ * 0.8) / 2, s_, naik, wt)
                kv.teks(lx + s_ + 2, py, tw + 2, GB['persen_tinggi_pt'], rr, jangkar='m', bungkus=False)
        kv.garis(x, dasar, x + w, dasar, GB['warna_garis_dasar'], 0.75)
        if dua:  # legenda dua ruas di bawah figur, rata tengah
            self.legenda(kv, x + w / 2, y + h - self.K['legenda']['tinggi_pt'],
                         [(kel['warna_pekat'], tb['kolom'][1].get('kepala', '')), (kel['warna_lama'], tb['kolom'][2].get('kepala', ''))][::-1 if g.get('ganda') else 1], asal=asal)   # ganda: urutan legenda = urutan batang (pembanding kiri)
        if g.get('kurva') and puncak_ganda:   # garis melengkung mengikuti puncak dan turunnya tiap seri (pemilik 27 Okt)
            kv.kurva(puncak_ganda[1], kel['warna_pekat'], 1.25, bawah=dasar)   # satu kurva, seri utama; dua kurva saling silang dan menimpa angka
        return tb

    def sorot_batang(self, g, pasang, vals, asal):
        """Indeks batang yang disorot, ditentukan data/spek (celah 6): `sorot` = daftar indeks atau label, atau "tertinggi" | "terbaru"
        (pesan grafik). Tanpa medan `sorot`: None, yaitu aturan lama (batang pertama pembanding, tiga terakhir pekat)."""
        sr = g.get('sorot')
        if sr is None:
            return None
        if sr == 'tertinggi':
            return {max(range(len(vals)), key=lambda i: vals[i])}
        if sr == 'terbaru':
            return {len(vals) - 1}
        labs = [p[0] for p in pasang]
        out = set()
        for z in (sr if isinstance(sr, list) else [sr]):
            if isinstance(z, int) and not isinstance(z, bool) and 0 <= z < len(vals):
                out.add(z)
            elif z in labs:
                out.add(labs.index(z))
            else:
                raise DeckGalat(f'{asal}: sorot {z!r} bukan indeks atau label batang {labs}')
        return out

    def batang_horizontal(self, kv, x, y, w, h, g, pasang, vals, sorot, kel, tb, asal):
        """Batang horizontal (celah 6): label kiri, batang, nilai di ujung batang, anotasi opsional `anotasi: [{label, teks}]` di kanan nilai."""
        sk = g.get('skala_huruf', 1.3)
        gl = dict(self.T['tanggal_batang'], ukuran_pt=pt_dari(self.T['tanggal_batang']) * sk)
        gv = dict(self.T['nilai_batang'], ukuran_pt=pt_dari(self.T['nilai_batang']) * sk)
        n = len(pasang)
        an = {a['label']: a['teks'] for a in g.get('anotasi', [])}
        for k_ in an:
            if k_ not in [p[0] for p in pasang]:
                raise DeckGalat(f'{asal}: anotasi untuk label {k_!r} yang tidak ada di batang')
        lw = min(max(self.u.lebar([self.R(p[0], gl)]) for p in pasang) + 6, w * 0.4)
        aw = max([self.u.lebar(self.runs(t, gl, asal)) + 8 for t in an.values()] or [0])
        vw = max(self.u.lebar([self.R(p[1]['teks'], gv)]) for p in pasang) + 6
        bx0, bmax = x + lw, w - lw - vw - aw
        vmax = max(vals) or 1
        rh = h / n
        th = min(rh * 0.62, 30)
        for i, (lab, sel) in enumerate(pasang):
            cy = y + rh * i + rh / 2
            on = sorot is None or i in sorot
            tok = kel['warna_pekat'] if on else kel['warna_lama']
            r = [self.R(lab, gl)]
            self.muat(r, lw - 6, 2, asal, 'label batang')
            kv.teks(x, cy - rh / 2, lw - 6, rh, r, rata='r', jangkar='m')
            bl = max(bmax * sel['nilai'] / vmax, 0.75)
            kv.bentuk('kotak', bx0, cy - th / 2, bl, th, tok)
            kv.teks(bx0 + bl + 3, cy - rh / 2, vw, rh, [self.R(sel['teks'], gv, 'teks' if on else 'teks-2')], jangkar='m', bungkus=False)
            if lab in an:
                ra = self.runs(an[lab], gl, asal, tebal=True, warna_='navy')
                kv.teks(bx0 + bl + 3 + vw, cy - rh / 2, aw, rh, ra, jangkar='m', bungkus=False)
        kv.garis(bx0, y, bx0, y + h, 'garis', 0.75)
        return tb

    def legenda(self, kv, cx, y, items, judul=None, asal='legenda', mentah=()):
        """Legenda satu baris rata tengah: kotak warna + label; items [(token, label)]. Label di `mentah` sudah dicatat sebagai
        angka turunan (rentang kelas dari manifest peta), jadi ditulis apa adanya tanpa pemeriksaan token."""
        LG = self.K['legenda']
        g = self.T['legenda']
        runs = [[self.R(lab, g)] if lab in mentah else self.runs(lab, g, asal) for _, lab in items]  # label boleh bertoken angka (D-22)
        lj = [self.R(judul, g, tebal=True)] if judul else None
        lebar = sum(LG['kotak_pt'] + LG['jarak_kotak_pt'] + self.u.lebar(r) for r in runs) + LG['jarak_item_pt'] * (len(items) - 1)
        lebar += (self.u.lebar(lj) + LG['jarak_item_pt']) if lj else 0
        x = x0 = cx - lebar / 2
        if lj:
            jw = self.u.lebar(lj)
            kv.teks(x, y, jw + 2, LG['tinggi_pt'], lj, jangkar='m', bungkus=False)
            x += jw + LG['jarak_item_pt']
        for (tok, _), r in zip(items, runs):
            kv.bentuk('kotak', x, y + (LG['tinggi_pt'] - LG['kotak_pt']) / 2, LG['kotak_pt'], LG['kotak_pt'], tok, LG['warna_garis_kotak'], 0.5)
            x += LG['kotak_pt'] + LG['jarak_kotak_pt']
            tw = self.u.lebar(r)
            kv.teks(x, y, tw + 2, LG['tinggi_pt'], r, jangkar='m', bungkus=False)
            x += tw + LG['jarak_item_pt']
        return x0, x0 + lebar

    def item_legenda(self, lg):
        """Spek legenda -> [(token, label)]; {"irbi": [label]} dibaca dari tema.json warna.skala.irbi (T8)."""
        if isinstance(lg, dict) and 'irbi' in lg:
            ir = self.t['warna']['skala']['irbi']
            out = []
            for lab in lg['irbi']:
                if lab not in ir['label']:
                    raise DeckGalat(f'kelas IRBI "{lab}" tidak ada di tema.json skala.irbi.label')
                out.append((f'skala.{ir["ramp"]}.{ir["kelas"][ir["label"].index(lab)]}', lab))
            return out, lg.get('judul', ir['legenda'])
        return [(i['warna'], i['label']) for i in lg['item']], lg.get('judul')

    def peta(self, kv, x, y, w, h, pt, asal):
        """PNG peta dasar + legenda, unsur peta resmi, dan pil keyakinan di kaki; label pulau native tanpa tumpuk (B5.9, D-8)."""
        PT = self.K['peta']
        self.visual('peta')
        p = self.akar / pt['png']
        if not p.exists():
            raise DeckGalat(f'{asal}: PNG peta {pt["png"]} tidak ada')
        mp = p.with_suffix('.json')  # manifest perender: unsur peta resmi dan hash masukan
        if not mp.exists():
            raise DeckGalat(f'{asal}: manifest perender {mp.name} tidak ada; perender wajib menulis unsur peta (PEDOMAN B5.9, D-8)')
        mr = json.loads(mp.read_text(encoding='utf-8'))
        basi = [b for b, hs in mr.get('masukan', {}).items() if not (p.parent / b).exists() or sha(p.parent / b) != hs]  # relatif ke folder PNG
        if basi:
            raise DeckGalat(f'{asal}: peta {p.name} basi, masukan berubah sesudah dirender: {basi[:3]}; render ulang perendernya')
        un = mr.get('unsur_peta') or {}
        if not (un.get('sumber_batas') and un.get('sistem_referensi')):
            raise DeckGalat(f'{asal}: manifest {mp.name} tanpa sumber batas atau sistem referensi (PEDOMAN B5.9)')
        self.masukan |= {p, mp}
        pix = pymupdf.Pixmap(str(p))
        ekor = PT['legenda_tinggi_pt'] + PT['jarak_legenda_pt'] + PT['unsur_tinggi_pt']
        skala = min(w / pix.width, (h - ekor) / pix.height)
        mw, mh = pix.width * skala, pix.height * skala
        mx, my = x + (w - mw) / 2, y + (h - mh - ekor) / 2  # peta + kaki di bawahnya, satu blok di tengah
        kv.gambar(p, mx, my, mw, mh, 'peta')
        if pt['legenda'].get('dari_manifest'):  # kelas nilai: label rentang ditulis perender dari data ke manifest
            if not mr.get('legenda'):
                raise DeckGalat(f'{asal}: legenda dari_manifest tetapi manifest {mp.name} tanpa legenda')
            items, judul, mentah = [], pt['legenda'].get('judul'), set()
            for n, i in enumerate(mr['legenda']):  # rentang kelas = angka turunan dari data peta, dicatat di manifest angka (D-22)
                if re.search(r'\d', i['label']):
                    self.turunan(f'legenda:{p.stem}:{n}', i['label'], None, asal, pt['keyakinan'], pt['sumber'])
                    mentah.add(i['label'])
                items.append((i['warna'], i['label']))
        else:
            (items, judul), mentah = self.item_legenda(pt['legenda']), ()
        ly = my + mh + PT['jarak_legenda_pt']
        lx0, lx1 = self.legenda(kv, x + w / 2, ly, items, judul, asal, mentah)
        C = self.K['chip']
        pw = self.pil_keyakinan(kv, x + w, ly + (PT['legenda_tinggi_pt'] - C['tinggi_pt']) / 2, C['tinggi_pt'], pt['keyakinan'])
        if lx1 > x + w - pw - self.K['legenda']['jarak_item_pt']:
            raise DeckGalat(f'{asal}: legenda peta menabrak pil keyakinan; pendekkan label legenda')
        unsur = '; '.join(v for v in (un['sumber_batas'], un['sistem_referensi'], un.get('proyeksi'), un.get('catatan')) if v)
        ru = [self.R(self.st(self.ui['sumber_batas'] + unsur), self.T['catatan_kaki'])]
        self.cek_teks(ru[0][0], asal)
        self.muat(ru, w, 1, asal, 'baris unsur peta')
        if pt.get('unsur_tampil', True):   # unsur peta tetap di manifest (D-8); pemilik 27 Okt boleh menyembunyikan barisnya
            kv.teks(x, ly + PT['legenda_tinggi_pt'], w, PT['unsur_tinggi_pt'], ru, rata='c', jangkar='m', bungkus=False)
        kotak = []
        for pn in pt.get('penanda', []):  # label native: pil putih bergaris abu, posisi pecahan lebar/tinggi PNG
            px, py = mx + pn['x'] * mw, my + pn['y'] * mh
            r = [self.R(t_[0], self.T['label_peta']) for t_ in self.urai(pn['teks'], asal)]
            hp = PT['penanda_tinggi_pt']
            lw = self.u.lebar(r) + hp
            k = (px - lw / 2, py - hp / 2, px + lw / 2, py + hp / 2)
            if k[0] < mx or k[1] < my or k[2] > mx + mw or k[3] > my + mh:
                raise DeckGalat(f'{asal}: label peta "{pn["teks"]}" keluar dari batas peta (D-8)')
            g = PT['label_jarak_min_pt']
            for lain, kl in kotak:
                if k[0] < kl[2] + g and kl[0] < k[2] + g and k[1] < kl[3] + g and kl[1] < k[3] + g:
                    raise DeckGalat(f'{asal}: label peta "{pn["teks"]}" tumpang dengan "{lain}" (D-8)')
            darat = self.darat(pix, [(v - o) / skala for v, o in zip(k, (mx, my, mx, my))])
            if darat > PT['label_darat_maks']:
                raise DeckGalat(f'{asal}: label peta "{pn["teks"]}" menutup {darat:.0%} daratan berdata '
                                f'(batas {PT["label_darat_maks"]:.0%}); geser ke laut (D-8)')
            kotak.append((pn['teks'], k))
            self.pil(kv, k[0], k[1], r, hp, 'kertas', PT['warna_garis_penanda'], w=lw)
        self.hal['peta'] = {'legenda': bool(items), 'unsur_peta': un, 'resmi': not un.get('catatan'),
                            'batas': [mx, my, mx + mw, my + mh], 'label': [{'teks': t_, 'kotak': k} for t_, k in kotak],
                            'ukuran_label_pt': pt_dari(self.T['label_peta'])}
        return {'keyakinan': pt['keyakinan'], 'sumber': pt['sumber']}

    @staticmethod
    def darat(pix, kotak):
        """Pecahan piksel tak transparan (daratan berdata) di kotak PNG (x0, y0, x1, y1 dalam piksel)."""
        x0, y0, x1, y1 = (max(0, int(v)) for v in kotak)
        x1, y1 = min(x1, pix.width), min(y1, pix.height)
        n, isi = pix.n, 0
        for yy in range(y0, y1):
            baris = pix.samples_mv[(yy * pix.width + x0) * n:(yy * pix.width + x1) * n]
            isi += sum(1 for i in range(n - 1, len(baris), n) if baris[i] > 32)
        return isi / max((x1 - x0) * (y1 - y0), 1)

    # ------------------------------------------------------------------ bingkai
    def pas_judul(self, segs_fn, w, g, asal, maks=None):
        lo, hi = g['ukuran_pt']
        langkah = self.K['bingkai']['langkah_judul_pt']
        maks = maks or g['maks_baris']
        u = hi
        while u >= lo - 1e-9:
            runs = segs_fn(u)
            n = self.u.baris([runs], w)
            if n <= maks:
                self.catatan.append((asal, 'judul_baris', n))
                return runs, u
            u -= langkah
        raise DeckGalat(f'{asal}: judul lebih dari {maks} baris pada {lo} pt; pendekkan judul (Buku Pegangan: paling banyak dua baris)')

    def seimbang_runs(self, runs, w, penuh=False):
        """Judul dua baris: pindahkan patah baris ke titik yang membuat kedua baris paling seimbang (tanpa yatim).
        penuh=True: baris pertama sepanjang mungkin, baris kedua paling sedikit dua kata (judul slide isi)."""
        kata, cur = [], []
        for r in runs:
            for bag in re.split(r'( )', r[0]):
                if bag == ' ':
                    kata.append(cur)
                    cur = []
                elif bag:
                    cur.append((bag,) + tuple(r[1:]))
        kata.append(cur)
        kata = [k for k in kata if k]

        def gabung(ks):
            out = []
            for i, k in enumerate(ks):
                for c in ([(' ',) + tuple(k[0][1:])] if i else []) + k:
                    if out and out[-1][1:] == c[1:]:
                        out[-1] = (out[-1][0] + c[0],) + tuple(c[1:])
                    else:
                        out.append(c)
            return out
        calon = []
        for i in range(1, len(kata)):
            a, b = gabung(kata[:i]), gabung(kata[i:])
            la, lb = self.u.lebar(a), self.u.lebar(b)
            if max(la, lb) <= w * 0.98:
                calon.append((max(la, lb), a, b))
        if penuh:
            calon = [(-self.u.lebar(a), a, b) for _, a, b in calon if len(''.join(c[0] for c in b).split()) >= 1  # baris pertama penuh sampai tepi; baris kedua boleh satu kata (pemilik 27 Okt)
                     and self.u.lebar(a) <= w * 0.995]
        if not calon:
            return runs
        _, a, b = min(calon, key=lambda c: c[0])
        return a + [('\n',) + tuple(a[-1][1:])] + b

    def kaki_yh(self):
        """(y, tinggi) pita kaki gelap; isi kaki (sumber, hak cipta, nomor) rata tengah vertikal di pita ini."""
        gy = self.S['garis']['y_pt'][-1]
        return gy + 5, self.S['tinggi_pt'] - gy - 9

    def footer(self, kv, nomor, gelap=False):
        F, B = self.S['footer'], self.K['bingkai']
        if not gelap:  # pita kaki biru sangat muda, isi penuh tanpa gradien (pemilik 26 Okt: "lebih soft, full in")
            gy = self.S['garis']['y_pt'][-1]
            kv.bentuk('bulat', self.X0, self.kaki_yh()[0], self.W, self.kaki_yh()[1], 'navy', radius=4).name = 'Pita kaki'   # selebar garis, berjarak dari garis di atasnya, gelap, tulisan putih (pemilik 27 Okt)
        g = self.T['footer_gelap']
        gn = dict(self.T['nomor_halaman'], warna=g['warna'])
        # kaki pola MBB (pemilik 26 Okt): "© 2026 Badan ..." rata kanan dekat nomor halaman; kiri untuk baris sumber
        lk = self.u.lebar([self.R(F['teks'], g)]) + 2
        kv.teks(self.X1 - B['nomor_lebar_pt'] - 20 - lk, self.kaki_yh()[0], lk, self.kaki_yh()[1], [self.R(F['teks'], g)], rata='r', bungkus=False, jangkar='m')
        kv.teks(self.X1 - B['nomor_lebar_pt'], self.kaki_yh()[0], B['nomor_lebar_pt'], self.kaki_yh()[1],   # kotak tetap di pojok (T-6); jarak dalam kanan 10 pt: nomor tidak menempel tepi pita
                [self.R(self.st(str(nomor)), gn)], rata='r', jangkar='m', bungkus=False, kanan=10)

    def bingkai(self, kv, j):
        sp, asal = j['spek'], j['asal']
        jk, B, g = self.S['judul_kotak'], self.K['bingkai'], self.T['judul_temuan']
        cut = sp.get('cut_off')
        cut = self.spek.get('cut_off') if cut is True else cut
        if cut and not self.data_harian():   # selera 5.09 dan pemilik 1 Nov 2026 ("Gausah ada cut off gini"): pil hanya di deck data harian
            cut = None
        w = jk['lebar_dengan_pil_pt'] if cut else jk['lebar_pt']
        h = jk['tinggi_pt'][0] if sp.get('subjudul') else jk['tinggi_pt'][1]
        # logo kampus atau mitra di kiri logo BNPB (2 Nov 2026, deck flagship kampus): tinggi sama dengan logo BNPB (tidak lebih
        # besar, pemilik 27 Okt), jarak 8 pt; kotak judul menyempit supaya tidak bertumpuk. Spek slide: "logo_kampus": berkas atau daftar.
        lk_ = sp.get('logo_kampus') or []
        lk_ = [lk_] if isinstance(lk_, str) else list(lk_)
        logo_kampus = []
        if lk_:
            from PIL import Image
            L_ = self.S['logo']
            xk = L_['x_pt'] - 8
            for f_ in reversed(lk_):
                src_ = (self.akar / f_).resolve()
                if not src_.exists():
                    raise DeckGalat(f'{asal}: logo_kampus {f_} tidak ada di akar proyek')
                self.masukan.add(src_)
                iw_, ih_ = Image.open(src_).size
                hh_ = L_['tinggi_pt']
                ww_ = hh_ * iw_ / ih_
                xk -= ww_
                logo_kampus.append((src_, xk, ww_, hh_))
                xk -= 6
            w = min(w, xk - 6 - jk['x_pt'])
        judul, akhir = j.get('judul') or sp['judul'], j.get('judul_akhir', '')  # akhir dibangkitkan mesin ("(lanjutan 2/3)")
        if akhir:
            self.st(akhir)
        m0 = len(self.k.manifest)
        runs, _ = self.pas_judul(lambda u: self.runs(judul, g, asal, 'judul', ukuran=u, tebal=True)
                                 + ([self.R(akhir, g, ukuran=u, tebal=True)] if akhir else []), w, g, asal)
        m1 = len(self.k.manifest)
        del self.k.manifest[m0:m1 - len(re.findall(r'\{\{angka:', judul))]  # pas_judul mencoba beberapa ukuran; angka judul dicatat sekali
        # judul slide isi: baris pertama diisi penuh sampai tepi kotak, baris kedua tanpa kata yatim (pemilik 26 Okt 2026)
        if self.catatan[-1][2] == 2:
            runs = self.seimbang_runs(runs, w, penuh=True)
        jy, jh, jang = jk['y_pt'], h, 'b'
        if self.catatan[-1][2] == 1 and self.S.get('judul_satu_baris_tengah_logo') and not sp.get('subjudul'):
            # judul satu baris sejajar tengah logo, bukan menempel garis bawah (pemilik 26 Okt 2026)
            L = self.S['logo']
            jh = pt_dari(g) * 1.4
            jy, jang = L['y_pt'] + L['tinggi_pt'] / 2 - jh / 2, 'm'
            if self.hal is not None:
                self.hal['naik'] = max(0.0, self.S['garis']['y_pt'][0] - (max(jy + jh, L['y_pt'] + L['tinggi_pt']) + 8))
        kv.teks(jk['x_pt'], jy, w, jh, runs, jangkar=jang, spasi=B['spasi_baris_judul'])
        self.hal['judul'] = [jk['x_pt'], jy, w, jh, g['maks_baris']]  # D-17 diukur dari PDF di kotak ini
        if sp.get('subjudul'):
            r = self.runs(sp['subjudul'], self.T['subjudul'], asal)
            sw = B['subjudul_maks_x_pt'] - jk['x_pt']
            self.muat(r, sw, 1, asal, 'subjudul')
            kv.teks(jk['x_pt'], jk['y_pt'] + h + B['subjudul_jarak_pt'], sw, B['subjudul_tinggi_pt'], r, jangkar='m', bungkus=False)
        if cut:
            self.hal['cut_off'] = True
            C = self.K['cut_off']
            self.cek_teks(cut, asal)
            runs = [self.R(C['label'], self.T['cut_off_label']), self.R('   ' + self.st(cut), self.T['cut_off_nilai'])]
            lebar = min(max(self.u.lebar(runs) + 2 * C['pad_pt'], C['lebar_pt'][0]), C['lebar_pt'][1])
            lg_, hp = self.S['logo'], C['tinggi_pt'][1]
            # pil di bawah logo dengan celah 2 pt, tetap di atas garis judul (pil menempel wordmark BNPB, 31 Okt)
            cy = min(max(C['y_pt'], lg_['y_pt'] + lg_['tinggi_pt'] + 2), self.S['garis']['y_pt'][0] - hp - 1.5)
            self.pil(kv, C['x_pt'], cy, runs, hp, C['warna_isi'], w=lebar)
            if self.spek.get('pil_draf'):  # deck draf: pil kedua berpola CUT OFF tepat di atas pil batas data, lebar minimum supaya tidak menyentuh logo
                lab, _, nilai = self.spek['pil_draf'].partition('|')
                self.cek_teks(lab + nilai, asal)
                rd = [self.R(lab, self.T['cut_off_label']), self.R('   ' + self.st(nilai), self.T['cut_off_nilai'])]
                h = C['tinggi_pt'][1]
                # pil draf sejajar tinggi logo: dipersempit supaya berhenti 6 pt sebelum logo, tanpa bergeser ke kotak judul (juri 1 Nov)
                wd = min(C['lebar_pt'][0], lg_['x_pt'] - 6 - C['x_pt'])
                self.muat([rd], wd - 2 * C['pad_pt'] + 8, 1, asal, 'pil draf')
                self.pil(kv, C['x_pt'], cy - h - 4, rd, h, C['warna_isi'], w=wd)
        gs = self.S['garis']
        for n_, gy in enumerate(gs['y_pt']):
            if n_ == 0 and self.hal is not None and self.hal.get('naik'):
                gy -= self.hal['naik']  # judul satu baris: garis naik mendekati judul (pemilik 26 Okt)
            kv.garis(self.X0, gy, self.X1, gy, gs['warna'], gs['tebal_pt'])
        lg = self.S['logo']
        # di bawah tab bagian (garis y 17), tidak menempel (pemilik 31 Okt); tidak turun bila ada pil CUT OFF di bawah logo
        ly = lg['y_pt'] + (6 if j.get('bagian') and not self.hal.get('cut_off') else 0)
        kv.gambar(self.logo, lg['x_pt'], ly, lg['lebar_pt'], lg['tinggi_pt'])
        for src_, xk_, ww_, hh_ in logo_kampus:
            kv.gambar(src_, xk_, ly, ww_, hh_, 'logo')
        self.footer(kv, j['nomor'])
        if j.get('bagian'):
            self.penanda(kv, j['bagian'], asal)

    def penanda(self, kv, aktif, asal):
        """Tab bagian di pita kaki (pola tab laporan MBB): bagian aktif tebal navy dengan bilah oranye menempel garis kaki,
        bagian lain abu; pemilik 26 Okt 2026 minta penanda posisi bagian di atas atau bawah slide."""
        g = dict(self.T['footer'], ukuran_pt=8)
        x0, x1 = self.X0, self.X1  # pita paling atas slide (pemilik 26 Okt: "paling atas banget")
        cw = (x1 - x0) / len(self.bagian)
        gy, ty, th = 17, 2, 14
        kv.garis(x0, gy, x1, gy, 'garis', 0.75)
        for i, b in enumerate(self.bagian, 1):
            on = i == aktif
            r = [self.R(self.st(f'{i:02d}  '), g, 'oranye@pil' if on else 'teks-3', True), self.R(b.get('label', b['judul']), g, 'navy' if on else 'teks-3', on)]
            self.muat(r, cw - 4, 1, asal, f'label penanda bagian {i} (isi "label" pendek di spek bagian)')
            cx = x0 + (i - 1) * cw
            kv.teks(cx, ty, cw, th, r, rata='c', jangkar='m', bungkus=False)
            if on:
                kv.bentuk('kotak', cx + 6, gy - 1.25, cw - 12, 2.5, 'oranye@pil')  # bilah aktif menempel garis pita; navigasi, bukan arti data (D-24)

    def catatan_sumber(self, kv, j, tambahan=(), keyakinan=None):
        """Baris "Sumber:" 7,5 pt dengan bilah biru, disusun dari manifest angka slide ini (tiap angka bersumber).
        keyakinan: pil label keyakinan rata kanan di baris yang sama (tabel lampiran tanpa panel berpil, D-14, S15)."""
        sp = j['spek']
        if sp.get('sumber') is False:
            return
        if sp.get('sumber'):
            teks = sp['sumber']
        else:
            urut = []
            for m in self.k.manifest:
                if m.get('naskah') == j['asal'] and m['sumber'] not in urut:
                    urut.append(m['sumber'])
            for s in tambahan:
                if s and s not in urut:
                    urut.append(s)
            if not urut:
                return
            teks = ringkas_sumber(urut, self.K['bingkai']['sumber']['awalan_olah'], self.K['bingkai']['sumber']['label_olah'])
        self.cek_teks(teks, j['asal'])
        if self.hal is not None:
            self.hal['sumber_tampil'] = True
        S_ = self.K['bingkai']['sumber']
        C = self.K['catatan_kaki']
        r = [self.R(self.ui['sumber'], self.T['catatan_kaki'], 'kertas', True), self.R(self.st(teks), self.T['catatan_kaki'], 'kertas~i')]   # di pita kaki gelap  # hitam; label tebal, isi miring (pemilik 26 Okt)  # "Sumber:" tebal; metadata asal, bukan angka data
        F_, B_ = self.S['footer'], self.K['bingkai']
        kanan = self.X1 - B_['nomor_lebar_pt'] - 10 - self.u.lebar([self.R(F_['teks'], self.T['footer'])]) - 24  # sumber di baris kaki, kiri
        if keyakinan:
            ch = self.K['chip']['tinggi_pt']
            kanan -= self.pil_keyakinan(kv, kanan, F_['y_pt'] + (B_['footer_tinggi_pt'] - ch) / 2, ch, keyakinan) + self.K['chip']['jarak_pt']
        self.muat(r, kanan - max(S_['teks_x_pt'], self.X0 + 13 + C['bilah_pt'][0]), 1, j['asal'], 'baris sumber (tulis "sumber" pendek di spek)')
        bh = S_['bilah_tinggi_pt'] * 0.8
        ky, kh = self.kaki_yh()   # rata tengah di pita kaki; bilah biru masuk 8 pt dari tepi pita (pemilik 27 Okt: "jangan nempel")
        tx = max(S_['teks_x_pt'], self.X0 + 8 + C['bilah_pt'][0] + 5)
        kv.bentuk('kotak', self.X0 + 8, ky + (kh - bh) / 2, C['bilah_pt'][0], bh, C['warna_bilah'])
        kv.teks(tx, ky, kanan - tx, kh, r, jangkar='m', bungkus=False)

    def logo_bulat(self, kv, L, alas=True):
        """Logo BNPB. alas=True (latar foto atau gelap): lingkaran putih penuh supaya tulisan navy terbaca.
        alas=False (latar putih atau terang): PNG polos, karena lingkaran putih di latar putih hanya jadi bayangan
        samar dan menggandakan cincin logo (pemilik 31 Okt 2026)."""
        d = L['d_pt']
        if alas:
            kv.bentuk('elips', L['x_pt'], L['y_pt'], d, d, self.K['logo_bulat']['warna_isi'])
        lh = d * (self.K['logo_bulat']['rasio_logo'] if alas else 0.9)
        pix = pymupdf.Pixmap(str(self.logo))
        lw = lh * pix.width / pix.height
        kv.gambar(self.logo, L['x_pt'] + (d - lw) / 2, L['y_pt'] + (d - lh) / 2, lw, lh)

    def foto(self, berkas, w_pt, h_pt, alpha, nama):
        """Foto Commons dipotong ke rasio bidang, lalu diberi gradasi alfa kiri ke kanan (pudar ke latar slide)."""
        src = (self.akar / berkas).resolve()
        if not src.exists():
            raise DeckGalat(f'foto {berkas} tidak ada')
        self.masukan.add(src)
        dok = pymupdf.open(str(src))
        r = dok[0].rect
        rasio = w_pt / h_pt
        if r.width / r.height > rasio:
            cw = r.height * rasio
            klip = pymupdf.Rect(r.x0 + (r.width - cw) / 2, r.y0, r.x0 + (r.width + cw) / 2, r.y1)
        else:
            ch = r.width / rasio
            klip = pymupdf.Rect(r.x0, r.y0 + (r.height - ch) / 2, r.x1, r.y0 + (r.height + ch) / 2)
        px_w = w_pt * self.K['foto']['skala_px_per_pt']
        pix = dok[0].get_pixmap(matrix=pymupdf.Matrix(px_w / klip.width, px_w / klip.width), clip=klip, alpha=False)
        pix = pymupdf.Pixmap(pix, 1)
        a0, a1, ujung = alpha
        baris = bytes(int(255 * (a0 + (a1 - a0) * min(1.0, i / max(pix.width * ujung, 1)))) for i in range(pix.width))
        pix.set_alpha(baris * pix.height)
        out = self.keluaran / 'foto' / f'{self.nama}-{nama}-{src.stem}.png'  # per deck: bangun paralel di folder sama tidak saling timpa
        out.parent.mkdir(parents=True, exist_ok=True)
        pix.save(out)
        return out

    def foto_segitiga(self, kv, berkas, nama):
        """Foto dipotong segitiga besar di kanan (bentuk logo BNPB), dengan segitiga oranye bergeser di belakangnya seperti
        lapisan logo; pola foto-dalam-bentuk-merek (Kearney K, mozaik PwC), pemilik 31 Okt 2026. Bentuk dipotong tepi slide."""
        from PIL import Image, ImageDraw
        W, H = self.S['lebar_pt'], self.S['tinggi_pt']
        x0, puncak, kaki = 430.0, 690.0, 950.0   # sisi kiri dasar, puncak, sisi kanan dasar (bisa melewati tepi slide)
        def klip(pts):   # Sutherland-Hodgman: poligon dipotong ke bidang slide
            for uji, potong in ((lambda p: p[0] <= W, lambda a, b: (W, a[1] + (b[1] - a[1]) * (W - a[0]) / (b[0] - a[0]))),
                                (lambda p: p[1] <= H, lambda a, b: (a[0] + (b[0] - a[0]) * (H - a[1]) / (b[1] - a[1]), H)),
                                (lambda p: p[0] >= 0, lambda a, b: (0, a[1] + (b[1] - a[1]) * (0 - a[0]) / (b[0] - a[0]))),
                                (lambda p: p[1] >= 0, lambda a, b: (a[0] + (b[0] - a[0]) * (0 - a[1]) / (b[1] - a[1]), 0))):
                out = []
                for k in range(len(pts)):
                    a, b = pts[k - 1], pts[k]
                    if uji(b):
                        if not uji(a):
                            out.append(potong(a, b))
                        out.append(b)
                    elif uji(a):
                        out.append(potong(a, b))
                pts = out
            return pts
        tri = lambda dx, dy: [(puncak + dx, 28 + dy), (kaki + 260 + dx, H + 40 + dy), (x0 + dx, H + dy)]
        pts = klip(tri(-22, -18))   # segitiga oranye di belakang, digeser kiri-atas
        fb = kv.sh.build_freeform(E(pts[0][0]), E(pts[0][1]), scale=1.0)
        fb.add_line_segments([(E(a), E(b_)) for a, b_ in pts[1:]], close=True)
        seg = fb.convert_to_shape()
        gaya = seg._element.find(qn('p:style'))
        if gaya is not None:
            seg._element.remove(gaya)
        seg.fill.solid()
        seg.fill.fore_color.rgb = self.rgb('oranye')
        seg.line.fill.background()
        seg.name = 'Segitiga merek'
        # foto: potong ke kotak (x0..W, 28..H), lalu topeng segitiga
        src = (self.akar / berkas).resolve()
        if not src.exists():
            raise DeckGalat(f'foto {berkas} tidak ada')
        self.masukan.add(src)
        bx, by = x0, 28.0
        bw, bh = W - bx, H - by
        sk = self.K['foto']['skala_px_per_pt']
        pw, ph = int(bw * sk), int(bh * sk)
        im = Image.open(src).convert('RGB')
        r = pw / ph
        iw, ih = im.size
        if iw / ih > r:
            cw = int(ih * r); im = im.crop(((iw - cw) // 2, 0, (iw - cw) // 2 + cw, ih))
        else:
            ch = int(iw / r); im = im.crop((0, (ih - ch) // 2, iw, (ih - ch) // 2 + ch))
        im = im.resize((pw, ph)).convert('RGBA')
        topeng = Image.new('L', (pw, ph), 0)
        ImageDraw.Draw(topeng).polygon([((puncak - bx) * sk, 0), ((kaki + 260 - bx) * sk, (H + 40 - by) * sk), (0, (H - by) * sk)], fill=255)
        im.putalpha(topeng)
        out = self.keluaran / 'foto' / f'{self.nama}-{nama}-segitiga-{src.stem}.png'
        out.parent.mkdir(parents=True, exist_ok=True)
        im.save(out)
        kv.gambar(out, bx, by, bw, bh, 'foto')

    def kredit(self, berkas, sp, asal=None):
        if sp.get('kredit'):
            if re.search(r'\d', sp['kredit']):   # nama akun pemotret berangka (A2613, Alharamain354): teks atribusi bersumber, bukan angka data
                self.turunan(f'kredit:{Path(str(berkas)).name}', sp['kredit'], None, asal or f'{self.nama}#1', 'resmi', 'Wikimedia Commons, atribusi foto')
            return sp['kredit']
        nama = Path(berkas).name
        for f in self.t.get('docx', {}).get('sampul_foto', {}).values():  # foto sampul DOCX dipakai ulang (satu set gambar, A5)
            if Path(f['berkas']).name == nama:
                return f'{self.ui["foto"]}{f["pengarang"]}, {f["lisensi"]}, Wikimedia Commons'
        pk = self.akar / 'kredit.json'  # [{file, penulis, lisensi}] untuk foto Commons
        kred = json.loads(pk.read_text(encoding='utf-8')) if pk.exists() else []
        for k in kred:
            if k['file'] == nama:
                if any(x in k['lisensi'] for x in ('NC', 'ND')):
                    raise DeckGalat(f'foto {nama}: lisensi {k["lisensi"]} tidak bebas (K5)')
                return f'{self.ui["foto"]}{k["penulis"]}, {k["lisensi"]}, Wikimedia Commons'
        raise DeckGalat(f'foto {nama}: tanpa atribusi; isi "kredit" di spek atau daftarkan di kredit.json akar proyek')

    def tanggal_panjang(self):
        if self.t.get('bahasa') == 'en':
            return f'{HARI_EN[self.tgl.weekday()]}, {self.tgl.day} {BULAN_EN[self.tgl.month - 1]} {self.tgl.year}'
        return f'{HARI[self.tgl.weekday()]}, {self.tgl.day} {BULAN[self.tgl.month - 1]} {self.tgl.year}'

    # ------------------------------------------------------------------ jenis slide
    def motif(self):
        """Motif bingkai: "arus" (kipas garis, sintesis sampul konsultan terang, pemilik 31 Okt 2026) atau None."""
        return self.spek.get('motif', self.S.get('motif'))   # bawaan mati: pemilik 31 Okt "jadi jelek banget"; aktif hanya bila spek meminta

    def garis_arus(self, kv, x, y, w, h, n=46, tebal=0.6, cermin=False):
        """Kipas garis tanda tangan bingkai: dua keluarga garis lurus yang saling silang membentuk lengkung (permukaan
        bergaris). Keluarga A dari tepi atas yang melebar menyempit ke leher di bawah; keluarga B dari tepi bawah kiri
        menyapu ke tepi kanan. Garis native, bisa disunting; warna ramp air sebagai garis hias (bukan kelas skala)."""
        X = (lambda u: x + w - u) if cermin else (lambda u: x + u)
        ramp = ['skala.air.2', 'skala.air.3', 'skala.air.4', 'skala.air.5']
        leher = w * 0.30
        for i in range(n):   # A: atas lebar ke leher bawah
            t = i / (n - 1)
            xa, xb = w * (0.02 + 0.98 * t), leher + w * 0.035 * t
            kv.garis(X(xa), y, X(xb), y + h, ramp[min(3, int(t * 4))] + '@garis', tebal)
        m = int(n * 0.7)
        for i in range(m):   # B: bawah kiri ke tepi kanan
            t = i / (m - 1)
            xa, ya = -w * 0.32 + (leher + w * 0.32) * t, h
            yb = h * (0.04 + 0.42 * t)
            kv.garis(X(xa if xa > 0 else 0), y + (ya if xa > 0 else h - (0 - xa) * (h - yb) / (w - xa)), X(w), y + yb,
                     ramp[min(3, int((1 - t) * 4))] + '@garis', tebal)

    def gaya_bingkai(self):
        """Arah bingkai sampul, penutup, daftar isi, pembatas (pemilik 31 Okt 2026 minta tiga arah untuk dipilih):
        None = bingkai yang sudah disetujui; "tipografi", "penuh", "kartu" = arah baru, aktif hanya bila spek meminta."""
        return self.spek.get('gaya_bingkai')

    def foto_sampul_deck(self):
        return next((s_.get('foto') for s_ in self.spek['slide'] if s_.get('jenis') == 'sampul' and s_.get('foto')), None)

    def foto_alfa(self, berkas, w_pt, h_pt, nama, arah='x', mulai=0.0, penuh=1.0, dasar=0.0):
        """Foto dipotong ke rasio bidang, alfa naik dari 0 (posisi mulai) ke 1 (posisi penuh) sepanjang sumbu x atau y,
        dalam pecahan lebar atau tinggi. Untuk foto selebar slide yang memudar ke putih di sisi teks."""
        from PIL import Image
        src = (self.akar / berkas).resolve()
        if not src.exists():
            raise DeckGalat(f'foto {berkas} tidak ada')
        self.masukan.add(src)
        sk = self.K['foto']['skala_px_per_pt']
        pw, ph = int(w_pt * sk), int(h_pt * sk)
        im = Image.open(src).convert('RGB')
        r, (iw, ih) = pw / ph, im.size
        if iw / ih > r:
            cw = int(ih * r); im = im.crop(((iw - cw) // 2, 0, (iw - cw) // 2 + cw, ih))
        else:
            ch = int(iw / r); im = im.crop((0, (ih - ch) // 2, iw, (ih - ch) // 2 + ch))
        im = im.resize((pw, ph)).convert('RGBA')
        n = pw if arah == 'x' else ph
        def halus(t):   # smoothstep: pudar mulai dan berakhir landai, tanpa garis batas yang terlihat (pemilik 31 Okt)
            t = min(1.0, max(0.0, t))
            return t * t * (3 - 2 * t)
        nilai = [int(255 * (dasar + (1 - dasar) * halus((i / n - mulai) / max(penuh - mulai, 0.01)))) for i in range(n)]   # dasar: foto tembus tipis di sisi teks
        a = Image.new('L', (pw, ph))
        a.putdata([nilai[x] if arah == 'x' else nilai[y] for y in range(ph) for x in range(pw)])
        im.putalpha(a)
        out = self.keluaran / 'foto' / f'{self.nama}-{nama}-alfa-{src.stem}-{int(w_pt)}x{int(h_pt)}.png'
        out.parent.mkdir(parents=True, exist_ok=True)
        im.save(out)
        return out

    def segitiga_garis(self, kv, x, y, w, h, tok, tebal):
        """Segitiga logo sebagai garis tipis tanpa isi (arah tipografi)."""
        kv.bentuk('segitiga', x, y, w, h, None, tok, tebal)

    def foto_bingkai(self, kv, sp, nama, gelap):
        gb = self.gaya_bingkai()
        if gb:
            W, H = self.S['lebar_pt'], self.S['tinggi_pt']
            if gb == 'tipografi':   # tanpa foto: satu segitiga garis besar terpotong tepi kanan, satu kecil di dalamnya
                self.segitiga_garis(kv, 600, 70, 330, 290, 'oranye', 1.5)
                self.segitiga_garis(kv, 690, 250, 200, 176, 'navy', 0.75)
                return
            if not sp.get('foto'):
                return
            if gb == 'penuh':   # foto cerah selebar slide, memudar ke putih di sisi teks
                kv.gambar(self.foto_alfa(sp['foto'], W, H, nama, 'x', 0.44, 0.70), 0, 0, W, H, 'foto')
            elif gb == 'kartu':   # foto dalam kartu rapi di kanan, segitiga oranye kecil di sudut kiri bawah kartu
                fx, fy, fw, fh = 536, 64, 380.8, 412
                kv.gambar(self.potong_foto(sp['foto'], fw, fh), fx, fy, fw, fh, 'foto')
                kv.bentuk('segitiga', fx - 18, fy + fh - 34, 40, 34, 'oranye')
            KR = self.K['sampul']['kredit']
            kv.teks(KR['x_pt'], KR['y_pt'], KR['lebar_pt'], KR['tinggi_pt'], [self.R(self.st(self.kredit(sp['foto'], sp)), self.T['kredit_foto'])], rata='r', bungkus=False)
            return
        """Foto dan motif sampul/penutup. bingkai_foto (spek slide, atau spek deck): "segitiga" (bawaan, foto dalam
        segitiga merek) atau "pudar" (foto kanan memudar ke putih). Kipas garis digambar lebih dulu, di belakang foto."""
        SM = self.K['sampul']
        ada = bool(sp.get('foto'))
        cara = sp.get('bingkai_foto', self.spek.get('bingkai_foto', 'pudar'))
        if self.motif() == 'arus' and not gelap:
            if ada and cara == 'segitiga':
                self.garis_arus(kv, 470, 0, 260, self.S['tinggi_pt'], n=40, tebal=0.55)   # di belakang tepi segitiga, tidak masuk area teks
            else:
                self.arus_bingkai(kv, ada)
        if not ada:
            return
        if cara == 'segitiga' and not gelap:
            self.foto_segitiga(kv, sp['foto'], nama)
        else:
            fx = SM['foto_x_pt']
            p = self.foto(sp['foto'], self.S['lebar_pt'] - fx, self.S['tinggi_pt'], SM['foto_alfa'], nama if nama == 'sampul' else 'sampul')
            kv.gambar(p, fx, 0, self.S['lebar_pt'] - fx, self.S['tinggi_pt'], 'foto')
        KR = SM['kredit']
        kv.teks(KR['x_pt'], KR['y_pt'], KR['lebar_pt'], KR['tinggi_pt'], [self.R(self.st(self.kredit(sp['foto'], sp)), self.T['kredit_foto'])], rata='r', bungkus=False)

    def arus_bingkai(self, kv, ada_foto):
        """Kipas di sampul dan penutup. Tanpa foto: mengisi sisi kanan. Dengan foto: pita sempit di peralihan putih ke
        foto, supaya foto cerah tetap terbaca (referensi konsultan menaruh garis di area foto yang kosong)."""
        fx, W, H = self.K['sampul']['foto_x_pt'], self.S['lebar_pt'], self.S['tinggi_pt']
        if ada_foto:
            self.garis_arus(kv, fx - 80, 0, 210, H, n=34, tebal=0.6)
        else:
            self.garis_arus(kv, fx - 40, 0, W - fx + 40, H)

    def peta_titik(self, w_pt, h_pt, tok='tint.netral.pita', jarak_pt=3.0, r_pt=0.85):
        """Peta Indonesia dot matrix dari batas provinsi proyek (geo/provinsi.json), PNG transparan; aset latar sampul
        (pemilik 31 Okt: "visual asset yang bagus"). Warna token tema yang sangat pucat, jadi teks di atasnya tetap terbaca."""
        from PIL import Image, ImageDraw
        src = self.akar / 'geo' / 'provinsi.json'
        if not src.exists():
            return None
        self.masukan.add(src)
        hx = self.catat_warna(tok + '@garis')[1].lstrip('#')
        out = self.keluaran / 'foto' / f'peta-titik-{int(w_pt)}x{int(h_pt)}-{hx}.png'
        if out.exists():
            return out
        gj = json.loads(src.read_text(encoding='utf-8'))
        lon0, lon1, lat0, lat1 = 94.8, 141.2, -11.2, 6.2
        sk = 4   # px per pt untuk topeng daratan
        mw, mh = int(w_pt * sk), int(h_pt * sk)
        topeng = Image.new('L', (mw, mh), 0)
        dr = ImageDraw.Draw(topeng)
        tx = lambda lon: (lon - lon0) / (lon1 - lon0) * mw
        ty = lambda lat: (lat1 - lat) / (lat1 - lat0) * mh
        for f in gj['features']:
            g = f['geometry']
            polys = g['coordinates'] if g['type'] == 'MultiPolygon' else [g['coordinates']]
            for poly in polys:
                cincin = poly[0]
                if len(cincin) > 2:
                    dr.polygon([(tx(c[0]), ty(c[1])) for c in cincin], fill=255)
        skp = max(self.K['foto']['skala_px_per_pt'], 6)   # titik kecil tetap bulat penuh, tidak jadi cincin saat diperkecil
        pw, ph = int(w_pt * skp), int(h_pt * skp)
        im = Image.new('RGBA', (pw, ph), (0, 0, 0, 0))
        di = ImageDraw.Draw(im)
        rgb = tuple(int(hx[i:i + 2], 16) for i in (0, 2, 4))
        y = jarak_pt / 2
        while y < h_pt:
            x = jarak_pt / 2
            while x < w_pt:
                if topeng.getpixel((min(int(x * sk), mw - 1), min(int(y * sk), mh - 1))):
                    di.ellipse([(x - r_pt) * skp, (y - r_pt) * skp, (x + r_pt) * skp, (y + r_pt) * skp], fill=rgb + (255,))
                x += jarak_pt
            y += jarak_pt
        out.parent.mkdir(parents=True, exist_ok=True)
        im.save(out)
        return out

    def pita_arus(self, kv, titik, n=3, lebar=5.0, celah=4.0, tok='oranye', runcing=0.12, nama='Arus Ketangguhan'):
        """Elemen grafis BNPB "Arus Ketangguhan" (pemilik 31 Okt 2026, pola elemen Aliran Sungai HUT RI ke-79): n pita sejajar
        mengikuti satu garis tengah meliuk (kontur gunung, aliran sungai, gelombang). Tiga pita = prabencana, tanggap
        darurat, pascabencana. Bentuk native (freeform) supaya bisa disunting; ujung meruncing supaya mengalir."""
        import math
        p = [titik[0]] + list(titik) + [titik[-1]]
        c = []
        for i in range(1, len(p) - 2):   # Catmull-Rom halus, 24 ruas per pasang titik
            (x0, y0), (x1, y1), (x2, y2), (x3, y3) = p[i - 1], p[i], p[i + 1], p[i + 2]
            for k in range(24):
                t = k / 24
                f = lambda a, b, c_, d: 0.5 * (2 * b + (c_ - a) * t + (2 * a - 5 * b + 4 * c_ - d) * t * t + (3 * b - a - 3 * c_ + d) * t ** 3)
                c.append((f(x0, x1, x2, x3), f(y0, y1, y2, y3)))
        c.append(titik[-1])
        N = []
        for i in range(len(c)):   # normal satuan tiap titik
            a = c[max(i - 1, 0)]; b = c[min(i + 1, len(c) - 1)]
            dx, dy = b[0] - a[0], b[1] - a[1]
            L = math.hypot(dx, dy) or 1
            N.append((-dy / L, dx / L))
        m = len(c)
        for k in range(n):
            pusat = (k - (n - 1) / 2) * (lebar + celah)
            kiri, kanan = [], []
            for i in range(m):
                u = i / (m - 1)
                tipis = min(1.0, u / runcing, (1 - u) / runcing) if runcing else 1.0   # ujung meruncing
                h = lebar / 2 * max(tipis, 0.05)
                kiri.append((c[i][0] + N[i][0] * (pusat - h), c[i][1] + N[i][1] * (pusat - h)))
                kanan.append((c[i][0] + N[i][0] * (pusat + h), c[i][1] + N[i][1] * (pusat + h)))
            poli = kiri + kanan[::-1]
            fb = kv.sh.build_freeform(E(poli[0][0]), E(poli[0][1]), scale=1.0)
            fb.add_line_segments([(E(x_), E(y_)) for x_, y_ in poli[1:]], close=True)
            sh = fb.convert_to_shape()
            g_ = sh._element.find(qn('p:style'))
            if g_ is not None:
                sh._element.remove(g_)
            sh.fill.solid()
            sh.fill.fore_color.rgb = self.rgb(tok)
            sh.line.fill.background()
            sh.name = f'{nama} {k + 1}'

    def elemen_deck(self):
        """Satu jenis elemen grafis per deck (pemilik 31 Okt): dari spek "elemen", atau dipilih dari tema deck."""
        if 'elemen' in self.spek:
            return self.spek['elemen']
        sampul = next((s_ for s_ in self.spek['slide'] if s_.get('jenis') == 'sampul'), {})
        teks = ' '.join([str(self.spek.get('judul_dokumen', '')), str(sampul.get('judul_sampul', '')), str(self.spek.get('pesan_kunci', ''))]).lower()
        if not teks.strip():
            teks = str(self.kaj.get('judul', '')).lower()   # judul kajian bawaan hanya bila deck tidak menulis judulnya sendiri
        for kunci, el in (('kerja sama', 'kotak_tumpuk'), ('koordinasi', 'kotak_tumpuk'), ('karhutla', 'piksel'), ('kebakaran', 'piksel'), ('titik panas', 'piksel'), ('gempa', 'gelombang'),
                          ('tsunami', 'setengah'), ('banjir', 'setengah'), ('air', 'setengah'), ('cuaca', 'pelangi'),
                          ('iklim', 'pelangi'), ('kekeringan', 'pelangi'), ('peringatan dini', 'sinyal'), ('satelit', 'orbit'),
                          ('peta jalan', 'simpul')):
            if re.search(r'\b' + re.escape(kunci) + r'\b', teks):   # kata utuh: "air" tidak cocok di "pair" 
                return el
        return 'kotak'

    def cek_kartu_ulang(self, slide):
        """D-44: angka kartu tidak boleh diulang di teks atau tabel isi slide yang sama (pemilik 31 Okt: strip angka yang
        mengulang angka "sangat tidak efektif"; riset konsultan 2026). Judul, kaki, dan sumber tidak dihitung; angka satu digit
        dilewati karena terlalu sering kebetulan sama."""
        nilai = [(v, a) for v, a in (self.hal or {}).get('kartu', []) if len(re.sub(r'\D', '', v)) >= 2]
        if not nilai:
            return
        y0, y1 = E(self.S['garis']['y_pt'][0] + 1), E(self.S['garis']['y_pt'][-1] - 1)
        teks, sel = [], []
        for sh in slide.shapes:
            if sh.name in ('Nilai kartu', 'Label kartu') or sh.top is None or not (y0 <= sh.top < y1):
                continue
            if getattr(sh, 'has_table', False) and sh.has_table:
                sel += [c.text.strip() for r in sh.table.rows for c in r.cells]
            elif sh.has_text_frame:   # tabel mesin digambar sebagai kotak teks: sel berisi angka saja diperlakukan sebagai sel
                t = sh.text_frame.text.strip()
                (sel if re.fullmatch(r'[\d.,%+\-–\s]+', t) else teks).append(t)
        for v, asal in nilai:
            v = v.strip()
            # sel tabel: hanya angka tiga digit ke atas yang sama persis (dua digit sering kebetulan sama, mis. Papua 13 vs 13 provinsi)
            pola = r'(?<![\d.,])' + re.escape(v) + r'(?![\d.,])'
            kena = next((t for t in teks if re.search(pola, t)), None) or (f'sel tabel "{v}"' if len(re.sub(r'\D', '', v)) >= 3 and v in sel else None)
            if kena:
                raise DeckGalat(f'{asal}: kartu "{v}" mengulang angka yang sudah ada di slide ini (D-44): "{kena[:90]}"; '
                                'buang kartunya, buang angka di teks, atau matikan baris total tabel')

    RE_ANGKA = re.compile(r'(?<![\d.,])(\d{1,3}(?:\.\d{3})+|\d+)(?:,(\d+))?(?![\d])')

    def cek_angka_ulang(self, slide, asal, sp=None):
        """D-48 (putaran 5b, uji tiru 1 Nov): angka yang sama (bagian bulat >= 3 digit setelah normalisasi format Indonesia) tidak tampil di dua panel
        berbeda dalam satu slide (ulangan di dalam satu panel, mis. irisan dan legendanya, sah): panel tabel yang mengulang nilai grafik di sebelahnya tidak menambah informasi. Dikecualikan:
        judul, kaki, sumber (di luar zona isi), kartu yang merangkum (bentuk "Nilai kartu", dijaga D-44), dan angka tahun 19xx/20xx."""
        if str((sp or {}).get('ulang_angka_boleh') or '').strip():   # pengecualian beralasan di spek slide, seperti basi_boleh
            return
        y0, y1 = E(self.S['garis']['y_pt'][0] + 1), E(self.S['garis']['y_pt'][-1] - 1)
        lihat = {}
        for n_, sh in enumerate(slide.shapes):
            if sh.name in ('Nilai kartu', 'Label kartu') or sh.top is None or not (y0 <= sh.top < y1):
                continue
            if getattr(sh, 'has_table', False) and sh.has_table:
                teks = ' | '.join(c.text for r in sh.table.rows for c in r.cells)
            elif sh.has_text_frame:
                teks = sh.text_frame.text
            else:
                continue
            cx_, cy_ = (sh.left + sh.width / 2) / EMU, (sh.top + sh.height / 2) / EMU
            zona = next((i_ for i_, pn in enumerate((self.hal or {}).get('panel', [])) if pn[0] <= cx_ <= pn[0] + pn[2] and pn[1] - 40 <= cy_ <= pn[1] + pn[3]), -1)
            for m in self.RE_ANGKA.finditer(teks):
                bulat, des = m.group(1).replace('.', ''), m.group(2) or ''
                if len(bulat) < 3 or (not des and re.fullmatch(r'(19|20)\d\d', bulat)):
                    continue
                lihat.setdefault(bulat + (',' + des if des else ''), set()).add(zona)
        dobel = sorted(k for k, v in lihat.items() if len(v) > 1)
        if dobel:
            raise DeckGalat(f'{asal}: angka {", ".join(dobel[:5])} tampil di lebih dari satu panel di slide ini (D-48); panel tabel tidak boleh '
                            'mengulang nilai grafik di sebelahnya: buang salah satunya atau ganti dengan data lain, atau tulis "ulang_angka_boleh": "alasan" di spek slide')

    def terbuka(self):
        """Panel, kartu, dan pita tanpa kotak/latar (bawaan sejak pemilik 31 Okt 2026: "kenapa harus dalam kompartemen");
        spek "gaya_panel": "kotak" untuk gaya lama."""
        return self.spek.get('gaya_panel', 'terbuka') == 'terbuka'

    def supergrafis(self):
        """Supergrafis deck: "busur" (Busur Perisai, bawaan sejak pemilik 31 Okt 2026, Pedoman Identitas Visual BNPB 8.2)
        atau "" untuk kembali ke elemen grafis lama."""
        return self.spek.get('supergrafis', 'busur')

    def busur_perisai(self, kv, cx, cy, r, sudut='kib', versi='polos'):
        """Busur Perisai berpusat di sudut (cx, cy), pusat transparan, bentuk vektor yang tidak keluar halaman. Pemilik 31 Okt
        2026 ("masih jelek warnanya", pilih B + A): versi "foto" (di atas foto atau latar gelap) = pita putih 12% jari-jari,
        oranye 7%, putih tembus 7%; versi "polos" (latar terang tanpa foto) = garis navy 7%, celah 7%, oranye 7%."""
        arah = {'kib': (1, -1), 'kb': (-1, -1), 'kia': (1, 1), 'ka': (-1, 1)}[sudut]
        pita = ([((1, .88), 'kertas', 8000), ((.88, .81), 'oranye', None), ((.81, .74), 'kertas', 45000)] if versi == 'foto' else
                [((1, .93), 'navy', None), ((.86, .79), 'oranye', None)])
        for (f1, f2), tok, tembus in pita:
            r1, r2, n = r * f1, r * f2, 36
            luar = [(cx + arah[0] * r1 * math.cos(math.radians(90 * k / n)), cy + arah[1] * r1 * math.sin(math.radians(90 * k / n))) for k in range(n + 1)]
            dalam = [(cx + arah[0] * r2 * math.cos(math.radians(90 * k / n)), cy + arah[1] * r2 * math.sin(math.radians(90 * k / n))) for k in range(n, -1, -1)]
            pts = luar + dalam
            fb = kv.sh.build_freeform(E(pts[0][0]), E(pts[0][1]), scale=1.0)
            fb.add_line_segments([(E(a), E(b_)) for a, b_ in pts[1:]], close=True)
            seg = fb.convert_to_shape()
            gaya = seg._element.find(qn('p:style'))
            if gaya is not None:
                seg._element.remove(gaya)
            seg.fill.solid()
            seg.fill.fore_color.rgb = self.rgb(tok)
            seg.line.fill.background()
            if tembus:   # alpha = bagian tembus: 8% pada pita putih utama, 45% pada pita putih dalam
                seg._element.spPr.find(qn('a:solidFill'))[0].append(parse_xml(f'<a:alpha {nsdecls("a")} val="{100000 - tembus}"/>'))
