    def latar_peta(self, W, H):
        """Latar sampul satu gambar opak: gradien putih ke abu-biru pucat ke bawah, lalu peta titik Indonesia di sepertiga
        bawah, condong ke kanan supaya pulau besar jatuh di zona pudar foto. Opak: PDF LibreOffice tidak merusak tepi titik."""
        from PIL import Image
        mp = self.peta_titik(700, 252)
        if not mp:
            return None
        a = self.catat_warna('kertas')[1].lstrip('#')
        b_ = self.catat_warna('tint.netral.muda@garis')[1].lstrip('#')
        ca, cb = [tuple(int(h_[i:i + 2], 16) for i in (0, 2, 4)) for h_ in (a, b_)]
        sk = 3
        pw, ph = int(W * sk), int(H * sk)
        im = Image.new('RGB', (pw, ph))
        for yy in range(ph):
            t = max(0.0, (yy / ph - 0.5) / 0.5)
            c = tuple(int(ca[k] + (cb[k] - ca[k]) * t) for k in range(3))
            im.paste(c, (0, yy, pw, yy + 1))
        m = Image.open(mp).convert('RGBA')
        m = m.resize((int(700 * sk), int(252 * sk)), Image.LANCZOS)
        im.paste(m, (int(40 * sk), int((H - 262) * sk)), m)
        out = self.keluaran / 'foto' / f'latar-peta-{int(W)}x{int(H)}-{a}-{b_}.png'
        out.parent.mkdir(parents=True, exist_ok=True)
        im.save(out)
        return out

