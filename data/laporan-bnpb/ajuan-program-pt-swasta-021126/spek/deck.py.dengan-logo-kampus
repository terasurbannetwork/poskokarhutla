        if pj_ and pj_.get('nama'):
            uk_ = 14.5 if penutup else 14
            # nama pendek: kartu kontak tetap selebar teks lembaganya (paling sedikit 380 pt)
            lg_ = min(w + 60, max(380, self.u.lebar([self.R(pj_['nama'], dict(self.T['kepada_sampul'], ukuran_pt=uk_), tebal=True)])))
        kv.garis(x, y, x + lg_, y, 'skala.netral.3@garis', 0.75)   # garis rambut abu kebiruan sepanjang kolom: pemisah judul dan penyaji (pemilik 31 Okt, ganti bilah oranye)
        y += 14
        if sp.get('penyaji') and not penutup:
            # label kecil oranye, nama bergelar tebal, jabatan di bawahnya (pemilik 31 Okt: "xxx, baru jabatan di bawahnya")
            for teks, gaya, wt, tebal, jarak in ((self.ui['disampaikan'], 11, 'oranye', True, 5), (sp['penyaji']['nama'], 14, 'teks', True, 2),
                                                 (sp['penyaji'].get('jabatan', ''), 11.5, 'teks-2', False, 0)):
                if not teks:
                    continue
                gg = dict(self.T['kepada_sampul'], warna=wt, ukuran_pt=gaya)
                rr = [self.R(self.st(teks), gg, tebal=tebal)]
                wp = w + 50   # nama bergelar lengkap muat satu baris; tepi foto masih pudar di sini
                while gaya > 12 and self.u.baris([rr], wp) > 1:   # kecilkan sampai satu baris, tidak di bawah 12 pt
                    gaya -= 0.5
                    gg['ukuran_pt'] = gaya
                    rr = [self.R(self.st(teks), gg, tebal=tebal)]
                nb = self.muat(rr, wp, 2, j['asal'], 'penyaji')
                kv.teks(x, y, wp, pt_dari(gg) * 1.25 * nb, rr).name = 'Penyaji'   # nama diri dan jabatan resmi: bukan prosa (slop)
                y += pt_dari(gg) * 1.25 * nb + jarak
            y += 12
        if penutup:   # penutup: penyaji dari sampul lalu kartu kontak lembaga (pola penutup laporan harian, pemilik 31 Okt)
            pj = sp.get('penyaji') or next((s_.get('penyaji') for s_ in self.spek['slide'] if s_.get('jenis') == 'sampul' and s_.get('penyaji')), None)
            if pj and pj.get('nama'):
                for teks, uk, wt, tebal in ((pj['nama'], 14.5, 'teks', True), (pj.get('jabatan', ''), 12, 'teks-2', False)):
                    if teks:
                        gg = dict(self.T['kepada_sampul'], warna=wt, ukuran_pt=uk)
                        rr = [self.R(self.st(teks), gg, tebal=tebal)]
                        self.muat(rr, w + 60, 1, j['asal'], 'penyaji penutup')
                        kv.teks(x, y, w + 60, uk * 1.3, rr, bungkus=False).name = 'Penyaji'
                        y += uk * 1.3 + 3
            if sp.get('kontak', True):
                self.kartu_kontak(kv, x, y + 14, lg_, j['asal'])   # selebar garis rambut, di dalam area putih
            return self.kaki_bingkai(kv, x, H)
        kota = sp.get('kota') or next((s_.get('kota') for s_ in self.spek['slide'] if s_.get('jenis') == 'sampul' and s_.get('kota')), None)
        bulan = BULAN_EN if self.t.get('bahasa') == 'en' else BULAN
        teks_tgl = f"{kota}, {self.tgl.day} {bulan[self.tgl.month - 1]} {self.tgl.year}" if kota else self.tanggal_panjang()
        TG = self.K['sampul']['tanggal']
        self.pil(kv, x, y, [self.R(self.st(teks_tgl), dict(self.T['tanggal_sampul'], warna='kertas', ukuran_pt=11.5))], 26, 'navy', w=200)
        if sp.get('kepada') and not penutup:   # pil sasaran di kanan bawah, sejajar blok kaki kiri (c) dan slogan: navy semi-transparan bertepi putih (pemilik 31 Okt)
            y, mk = H - 26 - 16, 20   # mepet sudut kanan bawah (pemilik 31 Okt: "agak lebih ke kanan bawah")
            gk = dict(self.T['kepada_sampul'], ukuran_pt=11)
            rk = [self.R(self.st(sp['kepada']), gk, 'kertas~i', True)]
            lk_ = min(self.u.lebar(rk) + 32, W - mk - 500)
            self.muat(rk, lk_ - 24, 1, j['asal'], 'pil ditujukan')
            pk = kv.bentuk('bulat', W - mk - lk_, y, lk_, 26, 'navy', 'kertas', 0.75, radius=13, bayang=True)
            pk._element.spPr.find(qn('a:solidFill'))[0].append(parse_xml(f'<a:alpha {nsdecls("a")} val="70000"/>'))   # transparan 30%
            kv.teks(W - mk - lk_, y, lk_, 26, rk, rata='c', jangkar='m', bungkus=False)
        self.kaki_bingkai(kv, x, H)

    def s_sampul(self, kv, j):
        sp, SM = j['spek'], self.K['sampul']
        self.cek_ulang_judul_sampul(sp, j['asal'])
        for v_ in list((sp.get('penyaji') or {}).values()) + [sp.get('kepada') or '']:   # nama penyaji dan pil sasaran ikut diperiksa istilah pemilik
            if isinstance(v_, str) and v_:
                self.cek_teks(v_, j['asal'])
        if not sp.get('kepada') and not sp.get('tanpa_kepada'):   # pemilik 1 Nov 2026: "mana yang kanan bawah Ditujukan khusus?"
            raise DeckGalat(f"{j['asal']}: sampul tanpa 'kepada' (pil kanan bawah, mis. \"Ditujukan khusus untuk Kepala BNPB\"); "
                            "pengecualian hanya dengan 'tanpa_kepada': '<alasan dari pemilik>'")
        if not self.logo_berakhlak() and not sp.get('logo_kanan'):
            raise DeckGalat(f"{j['asal']}: logo BerAKHLAK tidak ada di foto/ akar proyek (selera 2.10: kanan atas sampul dan penutup)")
        if self.gaya_bingkai() in ('penuh', 'tumpuk', 'mozaik'):
            if not sp.get('kota'):
                raise DeckGalat(f"{j['asal']}: sampul tanpa 'kota' (selera-pemilik 2.02a)")
            if not (sp.get('penyaji') or {}).get('nama') and not sp.get('tanpa_penyaji'):
                raise DeckGalat(f"{j['asal']}: sampul tanpa 'penyaji' (Dipresentasikan oleh)")
            return self.bingkai_konsultan(kv, j)
        if not sp.get('kota'):   # 2.02/2.02a: pil "Jakarta, 29 Oktober 2026"
            raise DeckGalat(f"{j['asal']}: sampul tanpa 'kota' (selera-pemilik 2.02a: pil berformat \"Jakarta, 29 Oktober 2026\")")
        if not (sp.get('penyaji') or {}).get('nama') and not sp.get('tanpa_penyaji'):   # 2.02, 2.04, keputusan 8
            raise DeckGalat(f"{j['asal']}: sampul tanpa 'penyaji' (Dipresentasikan oleh, nama lengkap bergelar, jabatan); "
                            "pengecualian hanya dengan 'tanpa_penyaji': '<alasan dari pemilik>'")
        gelap = self.gelap(j)
        Wn = SM['gelap' if gelap else 'putih']
        self.foto_bingkai(kv, sp, 'sampul', gelap)
        self.logo_bulat(kv, dict(SM['logo'], d_pt=SM['logo']['d_pt'] * self.skala_logo_bnpb()), alas=gelap)
        x, w = SM['teks_x_pt'], SM['teks_lebar_pt']
        g = dict(self.T['judul_sampul'], warna=Wn['warna_judul'])
        wj = max(w, SM['foto_x_pt'] - x - 24) if sp.get('foto') else w   # judul memakai ruang sampai tepi foto: tanpa ruang putih besar di kanan (pemilik 27 Okt)
        if sp.get('judul_penuh'):   # baris diisi penuh dari kiri (bukan seimbang): ruang kanan terpakai (pemilik 27 Okt)
            baris = [[]]
            for kt in self.kaj['judul'].split():
                coba = ' '.join(baris[-1] + [kt])
                if baris[-1] and self.u.lebar([self.R(coba, g)]) > wj:
                    baris.append([kt])
                else:
                    baris[-1].append(kt)
            baris = [' '.join(b_) for b_ in baris]
            if len(baris) > g['maks_baris']:
                raise DeckGalat(f"{j['asal']}: judul sampul {len(baris)} baris > {g['maks_baris']}")
        else:
            baris = self.seimbang(self.kaj['judul'], g, wj, g['maks_baris'], j['asal'])
        self.catatan.append((j['asal'], 'judul_baris', len(baris)))
        # kotak 12% lebih lebar dari lebar patah baris: PowerPoint mengukur Roboto sedikit lebih lebar dari LibreOffice, baris tidak boleh terbungkus jadi 4 (pemilik 27 Okt)
        kv.teks(x, SM['judul_y_pt'], wj * 1.08, SM['judul_tinggi_pt'], [[self.R(b, g)] for b in baris], jangkar='b', spasi=SM['spasi_baris_judul'])
        self.hal['judul'] = [x, SM['judul_y_pt'], w, SM['judul_tinggi_pt'], g['maks_baris']]
        y = SM['judul_y_pt'] + SM['judul_tinggi_pt'] + SM['jarak_pt']['subjudul']
        tumpuk = [('subjudul_sampul', sp.get('subjudul', self.kaj['subjudul']), 'warna_subjudul', 'lembaga'),
                  ('lembaga_sampul', self.t['kajian']['penerbit'], 'warna_lembaga', 'kepada')]
        if sp.get('kepada'):
            tumpuk.append(('kepada_sampul', sp['kepada'], 'warna_kepada', 'garis'))
        for gaya, teks, wk, berikut in tumpuk:
            gg = dict(self.T[gaya], warna=Wn[wk])
            if gaya == 'subjudul_sampul' and sp.get('skala_subjudul'):   # subjudul panjang dikecilkan (pemilik 27 Okt)
                gg['ukuran_pt'] = pt_dari(gg) * sp['skala_subjudul']
            r = [self.R(self.st(teks), gg)] if gaya == 'subjudul_sampul' and sp.get('subjudul') else self.runs(teks, gg, j['asal'])  # subjudul spek: baris tanggal paparan (struktur)
            nb = self.muat(r, w, 2, j['asal'], gaya)
            hh = pt_dari(gg) * 1.25 * nb
            kv.teks(x, y, w, hh, r)
            if gaya == 'subjudul_sampul':   # periksa.py D-41: baris terakhir subjudul tidak boleh satu kata
                self.hal['subjudul'] = [x, y, w, hh]
            y += hh + SM['jarak_pt'][berikut]
        kv.garis(x, y, x + SM['garis_lebar_pt'], y, Wn['warna_garis'], 0.75)
        if sp.get('penyaji'):  # paparan pejabat: DISAMPAIKAN OLEH, nama dan gelar, jabatan (pola laporan harian, pemilik 26 Okt)
            y += SM['jarak_pt']['garis']
            # warna pola laporan harian: label oranye kapital, nama warna judul tebal, jabatan warna subjudul
            for gaya, teks, wt, tebal in (('kepada_sampul', self.ui['disampaikan'], Wn['warna_lembaga'] if gelap else 'oranye', True),
                                          ('kepada_sampul', sp['penyaji']['nama'], Wn['warna_judul'], True),
                                          ('kepada_sampul', sp['penyaji'].get('jabatan', ''), Wn['warna_subjudul'], False)):
                if not teks:  # jabatan boleh kosong: lembaga sudah tertulis di atas (pemilik 27 Okt: "kenapa ada dua kali")
                    continue
                gg = dict(self.T[gaya], warna=wt)
                r = [self.R(self.st(teks), gg, tebal=tebal)]
                nb = self.muat(r, w, 2, j['asal'], 'penyaji')  # nama dan gelar lengkap tidak dipendekkan
                hh = pt_dari(gg) * 1.25 * nb
                kv.teks(x, y, w, hh, r).name = 'Penyaji'
                y += hh + 2
        lk_sampul = sp.get('logo_kanan') or self.logo_berakhlak()   # BerAKHLAK wajib di kanan atas sampul (selera 2.10; pemilik 1 Nov: "Di kanan atas ... ada yang kurang")
        if lk_sampul:  # logo pendamping (BerAKHLAK) di kotak putih kanan atas foto, proporsi asli
            from PIL import Image
            src = (self.akar / lk_sampul).resolve()
            self.masukan.add(src)
            lw_, lh_ = Image.open(src).size
            bw_, pad_ = float(sp.get('logo_kanan_lebar', 176)), 8.0   # logo mitra tidak boleh lebih besar dari logo BNPB (pemilik 27 Okt)
            bh_ = bw_ * lh_ / lw_
            bx_ = self.S['lebar_pt'] - 43.2 - bw_ - 2 * pad_
            if not sp.get('logo_kanan_bulat'):   # logo bundar: tanpa kotak putih (pemilik 27 Okt)
                kv.bentuk('bulat', bx_, 40, bw_ + 2 * pad_, bh_ + 2 * pad_, 'kertas', radius=8)
            kv.gambar(src, bx_ + pad_, 40 + pad_, bw_, bh_, 'logo')
            self.pasang_kris(kv, bx_, 40, bh_ + 2 * pad_, pad_, 8, False, j)   # KRIS di kiri BerAKHLAK (pemilik 2 Nov 2026)
        TG = SM['tanggal']
        g = dict(self.T['tanggal_sampul'], warna=Wn['warna_tanggal_teks'])
        ty = y + TG['ikut_penyaji_pt'] if sp.get('penyaji') and 'ikut_penyaji_pt' in TG else TG['y_pt']  # tanggal menempel blok penyaji, tanpa ruang kosong (pemilik 26 Okt)
        bulan = BULAN_EN if self.t.get('bahasa') == 'en' else BULAN
        teks_tgl = (f"{sp['kota']}, {self.tgl.day} {bulan[self.tgl.month - 1]} {self.tgl.year}" if sp.get('kota')  # format surat dinas: kota, tanggal (pemilik 28 Okt)
                    else self.tanggal_panjang())
        self.pil(kv, x, ty, [self.R(self.st(teks_tgl), g)], TG['tinggi_pt'], Wn['warna_tanggal_isi'], w=TG['lebar_pt'])

