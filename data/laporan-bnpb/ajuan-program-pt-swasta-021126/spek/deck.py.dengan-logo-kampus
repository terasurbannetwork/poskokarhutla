    def cek_teks_penutup(self, sp, asal):
        """Judul penutup cukup ucapan terima kasih, tanpa slogan atau seruan (pemilik 1 Nov 2026: "Hentikan pembakaran terlalu cringe")."""
        t = sp.get('teks')
        if t and t.strip().lower() not in ('terima kasih', 'thank you', self.ui['terima_kasih'].strip().lower()):
            raise DeckGalat(f'{asal}: judul penutup "{t}" bukan ucapan terima kasih; slogan dan kesimpulan masuk slide isi, bukan penutup')

    def cek_ulang_judul_sampul(self, sp, asal):
        """Subjudul sampul tidak boleh mengulang frasa judul (pemilik 1 Nov 2026: "Pantauan Udara Karhutla Merauke. Kenapa di bawahnya diulang lagi?")."""
        kata = lambda t: [w for w in re.findall(r'[a-z0-9]+', re.sub(r'\{\{[^}]*\}\}', ' ', t.lower())) if len(w) > 2]
        judul = kata(sp.get('judul') or self.kaj['judul'])
        sub = kata(sp.get('subjudul', self.kaj.get('subjudul', '')))
        frasa = {tuple(judul[i:i + 2]) for i in range(len(judul) - 1)}
        ulang = [' '.join(sub[i:i + 2]) for i in range(len(sub) - 1) if tuple(sub[i:i + 2]) in frasa]
        if ulang:
            raise DeckGalat(f'{asal}: subjudul sampul mengulang frasa judul "{ulang[0]}"; subjudul memberi info baru (wilayah, tanggal, acara)')

    def s_galeri(self, kv, j):
        """Halaman dokumentasi: [grup kartu] + beberapa panel foto berdampingan."""
        sp, asal = j['spek'], j['asal']
        jarak = self.K['bingkai']['jarak_blok_pt']
        y = self.S['area_isi_y_pt'][0]
        if sp.get('grup'):
            y = self.grup_kartu(kv, sp['grup'], y, asal) + jarak
        bawah = self.bawah(sp.get('sumber') is not False)
        dp = sp['panel']
        kol = sp.get('kolom_panel', len(dp))  # panel disusun berbaris: kolom_panel per baris
        brs = [dp[i:i + kol] for i in range(0, len(dp), kol)]
        ph = (bawah - y - jarak * (len(brs) - 1)) / len(brs)
        tambah = []
        for n, baris in enumerate(brs):
            bobot = [p.get('bobot', 1) for p in baris]
            lebar = self.W - jarak * (kol - 1)
            x, yy = self.X0, y + n * (ph + jarak)
            for p, b in zip(baris, bobot):
                pw = lebar * b / max(sum(bobot), kol) if len(baris) < kol else lebar * b / sum(bobot)
                tambah += self.panel_isi(kv, x, yy, pw, ph, p, asal)
                x += pw + jarak
        self.catatan_sumber(kv, j, tambah)

    # ------------------------------------------------------------------ visual pengganti tabel (pemilik 30 Okt 2026: "jenisnya gini semua")
    VISUAL_PANEL = ('corong', 'progres', 'tumpuk', 'waterfall', 'banding', 'opsi') + tuple(VISUAL_EKSTRA)
    Galat = DeckGalat   # renderer di scripts/visual memakai d.Galat dan d.pt_dari, tidak mengimpor deck lagi
    pt_dari = staticmethod(pt_dari)

    @staticmethod
    def pembatas(sp):
        """Kelas pembatas (putaran 5f): foto-penuh, bebas-polos, atau bebas ber-`pembatas: true`. Bukan slide isi: tanpa pesan,
        jenis_slide, judul_bentuk; tanpa kewajiban baris Sumber; angka biasa (nomor bab) boleh, dicatat sebagai urutan spek.
        Slide isi tidak pernah dilonggarkan: kelasnya hanya ditentukan jenis dan penanda ini."""
        return sp.get('jenis') in ('foto-penuh', 'bebas-polos') or (sp.get('jenis') == 'bebas' and bool(sp.get('pembatas')))

    @staticmethod
    def luar_isi(sp):
        return sp.get('jenis') in BINGKAI or Deck.pembatas(sp)

    @staticmethod
    def ritme_nama(nama, v=None):
        """Bentuk ritme sebuah isi visual: `RITME` modul (string, atau fungsi mode -> string) bila ada, kalau tidak namanya (putaran 5f)."""
        r = getattr(VISUAL_EKSTRA.get(nama), 'RITME', None)
        return (r(v) if callable(r) else r) or nama

    def _pasang(self, v, asal, nama):
        """Data visual -> (tabel, [(label, sel)]). seri "kolom": baris pertama, tiap kolom ber-fmt satu tahap; selain itu tiap baris [label, nilai]."""
        tb = self.data(v['data'], asal)
        if v['data'].get('seri') == 'kolom':
            pasang = [(c.get('kepala', c['nama']), sel) for c, sel in zip(tb['kolom'], tb['baris'][0]) if c.get('fmt')]
        else:
            pasang = [(r[0]['teks'], r[1]) for r in tb['baris']]
        if len(pasang) < 2 or any(s['nilai'] is None for _, s in pasang):
            raise DeckGalat(f'{asal}: {nama} butuh paling sedikit dua nilai angka ber-fmt')
        return tb, pasang

    def corong(self, kv, x, y, w, h, v, asal):
        """Corong tahapan (usulan, direviu, dibangun, selesai): batang tengah selebar nilainya, persen terhadap tahap pertama di kanan."""
        self.visual('grafik')
        tb, pasang = self._pasang(v, asal, 'corong')
        n, vmax = len(pasang), max(s['nilai'] for _, s in pasang) or 1
        tok = v.get('warna') or ['skala.netral.2', 'skala.netral.3', 'skala.netral.4', 'navy']
        tok = (tok * n)[:n] if len(tok) < n else tok[-n:]
        sk_ = v.get('skala_huruf', 1.4)
        gl = dict(self.T['label_tabel_utama'], ukuran_pt=pt_dari(self.T['label_tabel_utama']) * sk_)
        gn = dict(self.T['nilai_tabel'], ukuran_pt=pt_dari(self.T['nilai_tabel']) * sk_ * 1.15)
        jarak = 6
        rh = min(v.get('baris_maks_pt', 64), (h - 14 - jarak * (n - 1)) / n)   # corong mengisi panel (D-40), bukan mengambang
        y0 = y + 14 + (h - 14 - (rh * n + jarak * (n - 1))) / 2
        lw = min(max(self.u.lebar([self.R(l_, gl)]) for l_, _ in pasang) + 12, w * 0.32)
        pw = max(self.u.lebar([self.R('100,0%', gn)]) + 12, 58)
        ax, aw = x + lw, w - lw - pw
        awal = pasang[0][1]['nilai'] or 1
        for i, (lab, sel) in enumerate(pasang):
            yy = y0 + i * (rh + jarak)
            kv.teks(x, yy, lw - 6, rh, [self.R(lab, gl)], jangkar='m')
            bw_ = max(aw * sel['nilai'] / vmax, self.u.lebar([self.R(sel['teks'], gn)]) + 14)   # batang kecil tetap memuat angkanya
            gelap = tok[i] in ('navy',) or tok[i].endswith(('.4', '.5'))
            kv.bentuk('bulat', ax + (aw - bw_) / 2, yy, bw_, rh, tok[i], radius=3)
            kv.teks(ax + (aw - bw_) / 2, yy, bw_, rh, [self.R(sel['teks'], gn, 'kertas' if gelap else 'teks')], rata='c', jangkar='m', bungkus=False)
            if i:
                p = sel['nilai'] / awal * 100
                teks = fmt_id(p, 1) + '%'
                self.turunan(f'corong:{lab}', teks, p, asal, tb['keyakinan'], tb['sumber'])
                kv.teks(x + w - pw + 6, yy, pw - 6, rh, [self.R(teks, gn, 'navy' if i == n - 1 else 'teks-2')], rata='r', jangkar='m', bungkus=False)
        if v.get('keterangan_persen'):   # satu baris kecil di atas kolom persen: "dari usulan"
            kv.teks(x + w - pw, y0 - 13, pw, 11, [self.R(v['keterangan_persen'], self.T['tanggal_batang'])], rata='r', jangkar='b', bungkus=False)
        return tb

    def progres(self, kv, x, y, w, h, v, asal):
        """Batang progres per baris: label, "14 dari 17 kab/kota (82,4%)", lintasan muda dan isi pekat. Kolom data: label, nilai, dari."""
        self.visual('grafik')
        tb = self.data(v['data'], asal)
        rows = tb['baris']
        persen = len(tb['kolom']) == 2   # satu kolom persen: lintasan = 100% (pemilik 30 Okt: SPAM, jalan, jembatan fungsional)
        if persen and 'persen' not in str(tb['kolom'][1].get('fmt', '')):
            raise DeckGalat(f'{asal}: progres dua kolom butuh kolom persen (fmt "1|persen")')
        if any((r[1]['nilai'] is None and not persen) or (not persen and (len(r) < 3 or r[2]['nilai'] is None)) for r in rows):
            raise DeckGalat(f'{asal}: progres butuh kolom label, nilai, dan dari (keduanya ber-fmt), atau label dan persen')
        kel = self.K['grafik_batang']['keluarga'][v.get('keluarga', 'netral')]
        gl, gi = self.T['label_tabel_utama'], self.T['isi_tabel']
        gl = dict(gl, ukuran_pt=pt_dari(gl) * v.get('skala_huruf', 1.5))
        gi = dict(gi, ukuran_pt=pt_dari(gi) * v.get('skala_huruf', 1.5))
        n = len(rows)
        rh = min(v.get('baris_maks_pt', 110), h / n)   # baris mengisi panel (D-40)
        y0 = y + (h - rh * n) / 2
        th, lh = pt_dari(gl) * 1.5, max(8, min(16, rh * 0.2))
        sebaris = rh < th + 4 + 8 + 10   # dua tingkat (teks di atas lintasan) tidak muat
        if sebaris:   # huruf baris rapat kembali ke ukuran tabel, lebar label dari label terpanjang
            gl = dict(self.T['label_tabel_utama'], ukuran_pt=pt_dari(self.T['label_tabel_utama']) * v.get('skala_huruf_sebaris', 1.15))
            gi = dict(self.T['isi_tabel'], ukuran_pt=pt_dari(self.T['isi_tabel']) * v.get('skala_huruf_sebaris', 1.15))
            lw_baris = min(max(self.u.lebar([self.R(r[0]['teks'], gl)]) for r in rows) + 14, w * 0.55)
        sat = v.get('satuan', '')
        for i, r in enumerate(rows):
            yy = y0 + i * rh + (rh - th - 4 - lh) / 2
            if persen and r[1]['nilai'] is None:   # sel kosong = belum tercatat; ditampilkan sebagai celah, bukan dibuang
                nil, dari = 0, 100
                kanan = [self.R(v.get('kosong', 'Belum tercatat'), gi, 'teks-3')]
            elif persen:
                nil, dari = r[1]['nilai'], 100
                kanan = [self.R(r[1]['teks'], gl, kel['warna_pekat'])]
            else:
                nil, dari = r[1]['nilai'], r[2]['nilai'] or 1
                p = nil / dari * 100
                ps = fmt_id(p, 1) + '%'
                self.turunan(f'progres:{r[0]["teks"]}', ps, p, asal, tb['keyakinan'], tb['sumber'])
                kanan = [self.R(r[1]['teks'], gl), self.R(f' dari {r[2]["teks"]}{" " + sat if sat else ""}  ', gi), self.R(ps, gl, kel['warna_pekat'])]
            lintas = 'tanpa-data' if persen and r[1]['nilai'] is None else 'tint.netral.pita'
            if sebaris:   # baris rapat: label, lintasan, dan nilai dalam satu baris agar lintasan tidak menimpa label
                ry = y0 + i * rh
                lw_ = lw_baris
                kv.teks(x, ry, lw_ - 6, rh, [self.R(r[0]['teks'], gl)], jangkar='m', bungkus=False)
                kw = max(self.u.lebar([self.R(v.get('kosong', 'Belum tercatat'), gi)]), self.u.lebar(kanan)) + 6
                tx, tw_ = x + lw_, w - lw_ - kw - 6
                ly, lh = ry + (rh - min(lh, rh * 0.45)) / 2, min(lh, rh * 0.45)
                kv.teks(x + w - kw, ry, kw, rh, kanan, rata='r', jangkar='m', bungkus=False)
            else:
                kv.teks(x, yy, w * 0.5, th, [self.R(r[0]['teks'], gl)], jangkar='m', bungkus=False)
                kv.teks(x + w * 0.4, yy, w * 0.6, th, kanan, rata='r', jangkar='m', bungkus=False)
                tx, tw_, ly = x, w, yy + th + 4
            kv.bentuk('bulat', tx, ly, tw_, lh, lintas, radius=lh / 2)
            if nil > 0:
                kv.bentuk('bulat', tx, ly, max(tw_ * min(nil / dari, 1), lh), lh, kel['warna_pekat'], radius=lh / 2)
            if i < n - 1:
                kv.garis(x, y0 + (i + 1) * rh, x + w, y0 + (i + 1) * rh, 'garis', 0.5)
        return tb

    def tumpuk(self, kv, x, y, w, h, v, asal):
        """Batang horizontal bertumpuk per baris (realisasi lalu tahap berikutnya), jumlah di ujung, legenda di bawah. Kolom: label, ruas 1..k."""
        self.visual('grafik')
        tb = self.data(v['data'], asal)
        kol, rows = tb['kolom'], tb['baris']
        k = len(kol) - 1
        if k < 2 or any(s['nilai'] is None for r in rows for s in r[1:]):
            raise DeckGalat(f'{asal}: tumpuk butuh kolom label lalu paling sedikit dua ruas angka ber-fmt')
        tok = v.get('warna') or ['navy', 'skala.netral.4', 'skala.netral.3', 'skala.netral.2', 'pembanding']
        if len(tok) < k:
            raise DeckGalat(f'{asal}: tumpuk {k} ruas tetapi hanya {len(tok)} warna')
        gl, gn = self.T['label_tabel_utama'], self.T['nilai_tabel']
        gl = dict(gl, ukuran_pt=pt_dari(gl) * v.get('skala_huruf', 1.4))
        gn = dict(gn, ukuran_pt=pt_dari(gn) * v.get('skala_huruf', 1.4))
        LG = self.K['legenda']
        LGh = LG['tinggi_pt'] + 8
        d_ = str(kol[1].get('fmt', '')).split('|')[0]
        jml = [sum(s['nilai'] for s in r[1:]) for r in rows]
        vmax = max(jml) or 1
        jt = [fmt_id(j_, int(d_) if d_.isdigit() else None) for j_ in jml]
        for r, j_, t_ in zip(rows, jml, jt):
            self.turunan(f'tumpuk:{r[0]["teks"]}', t_, j_, asal, tb['keyakinan'], tb['sumber'])
        lw = min(max(self.u.lebar([self.R(r[0]['teks'], gl)]) for r in rows) + 12, w * 0.3)
        tw = max(self.u.lebar([self.R(t_, gl)]) for t_ in jt) + 10
        ax, aw = x + lw, w - lw - tw
        n = len(rows)
        rh = min(v.get('baris_maks_pt', 110), (h - LGh) / n)   # baris mengisi panel (D-40)
        y0 = y + (h - LGh - rh * n) / 2
        bh = min(rh * 0.62, 52)
        for i, r in enumerate(rows):
            yy = y0 + i * rh + (rh - bh) / 2
            kv.teks(x, y0 + i * rh, lw - 6, rh, [self.R(r[0]['teks'], gl)], jangkar='m', bungkus=False)
            xx, sempit = ax, []
            for j, s in enumerate(r[1:]):
                sw = aw * s['nilai'] / vmax
                rr = [self.R(s['teks'], gn, 'kertas' if j < 2 else 'teks')]
                if sw > 0:
                    kv.bentuk('kotak', xx, yy, sw, bh, tok[j])
                if sw > 0 and self.u.lebar(rr) + 6 <= sw:
                    kv.teks(xx, yy, sw, bh, rr, rata='c', jangkar='m', bungkus=False)
                else:   # ruas sempit atau nol tetap ditulis (D-6): keterangan kecil di bawah batang
                    sempit.append(f'{kol[j + 1].get("kepala", kol[j + 1]["nama"])} {s["teks"]}')
                xx += sw
            if sempit:
                kv.teks(ax, yy + bh + 2, aw, 10, [self.R('; '.join(sempit), self.T['tanggal_batang'])], jangkar='t', bungkus=False)
            kv.teks(xx + 5, y0 + i * rh, tw + aw - (xx - ax), rh, [self.R(jt[i], gl)], jangkar='m', bungkus=False)
        kv.garis(ax, y0, ax, y0 + rh * n, 'garis', 0.5)
        self.legenda(kv, x + w / 2, y + h - LG['tinggi_pt'], [(tok[j], kol[j + 1].get('kepala', kol[j + 1]['nama'])) for j in range(k)], asal=asal)
        return tb

    def waterfall(self, kv, x, y, w, h, v, asal):
        """Jembatan dari angka awal ke angka akhir lewat penyumbang. Baris data [label, nilai]: baris pertama = awal,
        sisanya perubahan bertanda; batang akhir dihitung mesin (jumlah) dan diberi label "akhir". Naik dan turun memakai
        warna arah rumah (naik oranye, turun biru); awal dan akhir navy.
        Putaran 5b (celah 5): `subtotal: [label]` = baris data bernilai subtotal sampai titik itu (mesin mencocokkan dengan jumlah
        berjalan, lalu menggambarnya sebagai batang total navy tanpa menambah jumlah); `arah: "horizontal"`; `selisih: true` =
        callout selisih awal ke akhir (turunan mesin); `callout: [{batang, teks}]` = gelembung teks di batang itu.
        Putaran 5f (vertikal): callout boleh lebih lebar dari batang dan membungkus sampai 3 baris; `penghubung`: "putus" (bawaan) | "garis"."""
        self.visual('grafik')
        tb, pasang = self._pasang(v, asal, 'waterfall')
        GB = self.K['grafik_batang']
        d_ = str(next(c for c in tb['kolom'] if c.get('fmt')).get('fmt', '')).split('|')[0]
        dig = int(d_) if d_.isdigit() else None
        subtotal = set(v.get('subtotal', []))
        for lab_ in subtotal:
            if lab_ not in [p_[0] for p_ in pasang[1:]]:
                raise DeckGalat(f'{asal}: subtotal {lab_!r} harus label baris data selain baris pertama')
        akhir = sum(s['nilai'] for lab_, s in pasang if lab_ not in subtotal)
        ta = fmt_id(akhir, dig)
        self.turunan('waterfall:akhir', ta, akhir, asal, tb['keyakinan'], tb['sumber'])
        if 'cek_akhir' in v and abs(akhir - v['cek_akhir']) > 10 ** -(dig or 0) / 2:
            raise DeckGalat(f'{asal}: waterfall menutup di {ta}, bukan {v["cek_akhir"]} (cek_akhir); periksa data')
        # jenis: 0 awal, 1 perubahan, 2 subtotal, 3 akhir
        batang = []
        for i, (lab, s_) in enumerate(pasang):
            batang.append((lab, s_['nilai'], s_['teks'], 0 if i == 0 else 2 if lab in subtotal else 1))
        batang.append((v.get('akhir', 'Akhir'), akhir, ta, 3))
        jalan, puncak, dasar_ = 0, [], []
        for lab, nil, _, jn in batang:   # rentang tiap batang pada sumbu nilai
            if jn == 0:
                lo, hi, jalan = min(0, nil), max(0, nil), nil
            elif jn == 2:
                if abs(nil - jalan) > 10 ** -(dig or 0) / 2 + 1e-9:
                    raise DeckGalat(f'{asal}: subtotal {lab!r} bernilai {fmt_id(nil, dig)} tetapi jumlah berjalan {fmt_id(jalan, dig)}; periksa data')
                lo, hi = min(0, nil), max(0, nil)
            elif jn == 3:
                lo, hi = min(0, nil), max(0, nil)
            else:
                lo, hi = sorted((jalan, jalan + nil))
                jalan += nil
            dasar_.append(lo)
            puncak.append(hi)
        vmin, vmax = min(dasar_ + [0]), max(puncak) or 1
        ujung = lambda jn: jn in (0, 2, 3)
        sk_ = v.get('skala_huruf', 1.25)
        gl = dict(self.T['tanggal_batang'], ukuran_pt=pt_dari(self.T['tanggal_batang']) * sk_)
        gn = dict(self.T['nilai_batang'], ukuran_pt=pt_dari(self.T['nilai_batang']) * sk_)
        n = len(batang)
        labsel = lambda jn, nil, teks: teks if ujung(jn) or nil < 0 else '+' + teks
        # callout selisih awal ke akhir (turunan mesin, tercatat)
        sel_r = None
        if v.get('selisih'):
            awal_ = pasang[0][1]['nilai']
            dif = akhir - awal_
            pers = dif / awal_ * 100 if awal_ else None
            tt = ('naik ' if dif >= 0 else 'turun ') + fmt_id(abs(dif), dig) + (f' ({fmt_id(abs(pers), 0)}%)' if pers is not None else '')
            self.turunan('waterfall:selisih', tt, dif, asal, tb['keyakinan'], tb['sumber'])
            sel_r = [self.R(tt, gn, 'kertas', True)]
        call = {c['batang']: c['teks'] for c in v.get('callout', [])}
        for k_ in call:
            if k_ not in [b_[0] for b_ in batang]:
                raise DeckGalat(f'{asal}: callout untuk batang {k_!r} yang tidak ada')
        if v.get('arah') == 'horizontal':
            lw = min(max(self.u.lebar([self.R(b_[0], gl)]) for b_ in batang) + 6, w * 0.34)
            vw = max(self.u.lebar([self.R(labsel(b_[3], b_[1], b_[2]), gn)]) for b_ in batang) + 6
            cw = max([self.u.lebar(self.runs(t, gl, asal)) + 12 for t in call.values()] or [0])
            sh = (GB['nilai_tinggi_pt'] + 4) if sel_r else 0
            px, pw = x + lw, w - lw - vw - cw
            rh = (h - sh) / n
            th = min(rh * 0.62, 28)
            sx = lambda val: px + (val - vmin) / (vmax - vmin) * pw
            for k, ((lab, nil, teks, jn), lo, hi) in enumerate(zip(batang, dasar_, puncak)):
                cy = y + sh + rh * k + rh / 2
                tok = 'navy' if ujung(jn) else self.arah(nil)
                kv.bentuk('kotak', sx(lo), cy - th / 2, max(sx(hi) - sx(lo), 0.75), th, tok)
                r = [self.R(lab, gl, tebal=ujung(jn))]
                self.muat([r], lw - 6, 2, asal, 'label waterfall')
                kv.teks(x, cy - rh / 2, lw - 6, rh, [r], rata='r', jangkar='m')
                kv.teks(sx(hi) + 3, cy - rh / 2, vw, rh, [self.R(labsel(jn, nil, teks), gn, 'teks' if ujung(jn) else tok)], jangkar='m', bungkus=False)
                if lab in call:
                    rc = self.runs(call[lab], gl, asal, tebal=True, warna_='navy')
                    kv.teks(sx(hi) + 3 + vw, cy - rh / 2, cw, rh, rc, jangkar='m', bungkus=False)
                if k < n - 1 and jn != 3:   # penghubung tegak tipis ke batang berikut
                    xj = sx(hi if (ujung(jn) or nil >= 0) else lo)
                    kv.garis(xj, cy + th / 2, xj, cy + rh - th / 2, 'garis', 0.5)
            kv.garis(sx(0), y + sh, sx(0), y + h, GB['warna_garis_dasar'], 0.75)
            if sel_r:
                pw_ = self.u.lebar(sel_r) + 14
                self.pil(kv, x + w - pw_, y, sel_r, GB['nilai_tinggi_pt'], 'navy', None, w=pw_)
            return tb
        lh = pt_dari(gl) * 1.3 * 2 + 4
        slot = w / n
        bw = slot * 0.62
        # callout (putaran 5f, CELAH-2 butir 3c): boleh lebih lebar dari batang (sampai 3,2 slot), membungkus sampai 3 baris, duduk di atas
        # batang dan label nilai tetangga yang ia tutupi (tidak pernah menimpa)
        calls = {}
        for lab_c, t_c in call.items():
            rc_ = self.runs(t_c, gl, asal, tebal=True, warna_='kertas')
            cw_ = min(max(self.u.lebar(rc_) + 10, bw), slot * 3.2)
            nb_ = self.u.baris([rc_], cw_ - 10)
            if nb_ > 3:
                raise DeckGalat(f'{asal}: callout waterfall {nb_} baris > 3 pada lebar {cw_:.0f} pt ("{t_c[:40]}"); pendekkan')
            calls[lab_c] = (rc_, cw_, nb_, max(GB['nilai_tinggi_pt'], nb_ * pt_dari(gl) * 1.25 + 5))
        tinggi_call = max([c_[3] for c_ in calls.values()] or [0]) + (6 if calls else 0)
        atas, bawah = y + GB['nilai_tinggi_pt'] * 1.4 + 4 + (GB['nilai_tinggi_pt'] + 6 if sel_r else 0) + tinggi_call, y + h - lh
        sk = lambda val: bawah - (val - vmin) / (vmax - vmin) * (bawah - atas)
        for k, ((lab, nil, teks, jn), lo, hi) in enumerate(zip(batang, dasar_, puncak)):
            bx = x + k * slot + (slot - bw) / 2
            tok = 'navy' if ujung(jn) else self.arah(nil)
            kv.bentuk('kotak', bx, sk(hi), bw, max(sk(lo) - sk(hi), 0.75), tok)
            label = labsel(jn, nil, teks)
            kv.teks(x + k * slot, sk(hi) - GB['nilai_tinggi_pt'] * 1.4 - 1, slot, GB['nilai_tinggi_pt'] * 1.4,
                    [self.R(label, gn, 'teks' if ujung(jn) else tok)], rata='c', jangkar='b', bungkus=False)
            rr = [self.R(lab, gl, tebal=ujung(jn))]
            self.muat([rr], slot - 4, 2, asal, 'label waterfall')
            kv.teks(x + k * slot + 2, bawah + 4, slot - 4, lh - 4, [rr], rata='c', jangkar='t')
            if lab in calls:   # gelembung callout di atas label nilai batang ini dan tetangga yang ia tutupi
                rc, cw_, nb_, ch_ = calls[lab]
                cx = min(max(x + k * slot + slot / 2 - cw_ / 2, x), x + w - cw_)
                tutup = [i_ for i_ in range(n) if x + i_ * slot < cx + cw_ and x + (i_ + 1) * slot > cx]
                bawah_c = min(sk(puncak[i_]) - GB['nilai_tinggi_pt'] * 1.4 - 1 for i_ in tutup) - 4
                cy_ = bawah_c - ch_
                if cy_ < y - 0.5:
                    raise DeckGalat(f'{asal}: callout waterfall "{lab}" tidak muat di atas batang ({y - cy_:.0f} pt melewati panel); pendekkan teks')
                if nb_ == 1:
                    self.pil(kv, cx, cy_, rc, ch_, 'navy', None, w=cw_)
                else:
                    kv.bentuk('bulat', cx, cy_, cw_, ch_, 'navy', radius=3)
                    kv.teks(cx + 5, cy_, cw_ - 10, ch_, rc, rata='c', jangkar='m')
                xm = x + k * slot + slot / 2
                yl = sk(hi) - GB['nilai_tinggi_pt'] * 1.4 - 1
                if yl - bawah_c > 3 and cx <= xm <= cx + cw_:
                    kv.garis(xm, bawah_c, xm, yl, 'navy', 0.75)   # tangkai dari gelembung ke label batangnya
            if k < n - 1 and jn != 3:   # penghubung antarbatang, putus-putus bawaan (v["penghubung"] = "garis" untuk garis penuh)
                yj = sk(hi if (ujung(jn) or nil >= 0) else lo)
                if v.get('penghubung', 'putus') == 'garis':
                    kv.garis(bx + bw, yj, bx + slot, yj, 'garis', 0.5)
                else:
                    kv.garis(bx + bw, yj, bx + slot, yj, 'teks-3', 0.6, putus=True)
        kv.garis(x, sk(0), x + w, sk(0), GB['warna_garis_dasar'], 0.75)
        if sel_r:
            pw_ = self.u.lebar(sel_r) + 14
            self.pil(kv, x + w - pw_, y, sel_r, GB['nilai_tinggi_pt'], 'navy', None, w=pw_)
        return tb

    def banding(self, kv, x, y, w, h, v, asal):
        """Perbandingan dua kolom: label baris (huruf atau kategori) di kiri, kolom kiri (kondisi sekarang, tantangan,
        anggapan), chevron, kolom kanan (usulan, implikasi, kenyataan). baris = [{label, kiri, kanan}]."""
        self.visual('tabel')
        rows = v['baris']
        if not 2 <= len(rows) <= 6:
            raise DeckGalat(f'{asal}: banding {len(rows)} baris; paling sedikit 2, paling banyak 6')
        sk_ = v.get('skala_huruf', 1.5)
        gl = dict(self.T['label_tabel_utama'], ukuran_pt=pt_dari(self.T['label_tabel_utama']) * sk_)
        gi = dict(self.T['isi_panel'], ukuran_pt=pt_dari(self.T['isi_panel']) * sk_ / 1.12)
        gk = dict(self.T['kepala_kolom'], ukuran_pt=pt_dari(self.T['kepala_kolom']) * 1.15)
        hk = pt_dari(gk) * 2.2
        lw = min(max(self.u.lebar([self.R(r['label'], gl)]) for r in rows) + 18, w * 0.2)
        cw = 22
        kw = (w - lw - cw - 12) / 2
        xk, xn = x + lw + 6, x + lw + 6 + kw + cw
        for xx, kol in ((xk, v['kiri']), (xn, v['kanan'])):
            kv.teks(xx, y, kw, hk, [self.R(kol['judul'].upper(), dict(gk, warna='navy'))], jangkar='m', bungkus=False)
            kv.garis(xx, y + hk, xx + kw, y + hk, 'navy', 1)
        rh = (h - hk - 4) / len(rows)
        tb_ = pt_dari(gi) * 1.3
        maks = max(1, int((rh - 8) // tb_))
        for i, r in enumerate(rows):
            ry = y + hk + 4 + i * rh
            kv.bentuk('kotak', x, ry + 2, lw, rh - 4, 'tint.netral.pita')
            rl = self.runs(r['label'], gl, asal)
            self.muat(rl, lw - 10, 3, asal, 'label banding')
            kv.teks(x + 5, ry + 2, lw - 10, rh - 4, rl, rata='c', jangkar='m')
            for xx, kunci in ((xk, 'kiri'), (xn, 'kanan')):
                rr = self.runs(r[kunci], gi, asal)
                self.muat(rr, kw - 4, maks, asal, f'isi banding {kunci}')
                kv.teks(xx, ry + 2, kw - 4, rh - 4, rr, jangkar='m')
            kv.bentuk('chevron', xk + kw + 5, ry + rh / 2 - 9, cw - 10, 18, 'pembanding')
            if i < len(rows) - 1:
                kv.garis(xk, ry + rh, x + w, ry + rh, 'garis', 0.5)
        return {'sumber': v.get('sumber', '')}

    def opsi(self, kv, x, y, w, h, v, asal):
        """Opsi berbobot (A/B/C x kriteria): CSV `data` berkolom [opsi, kriteria 1..k] dengan skor 1 sampai 5 ber-fmt "0"
        (penilaian pakar, keyakinan wajib dari lima label); `bobot` = bobot bulat tiap kriteria berurutan; `terpilih` = nama
        opsi yang disorot. Mesin menghitung skor akhir (rerata tertimbang, dicatat lewat turunan) dan MENOLAK opsi terpilih
        yang bukan skor tertinggi: pilihan tidak boleh melawan hitungannya sendiri (D-46, putaran 5)."""
        self.visual('tabel')
        tb = self.data(v['data'], asal)
        kol, rows = tb['kolom'], tb['baris']
        k = len(kol) - 1
        bobot = v.get('bobot')
        if not 2 <= len(rows) <= 5 or not 2 <= k <= 6:
            raise DeckGalat(f'{asal}: opsi butuh 2 sampai 5 opsi (baris) dan 2 sampai 6 kriteria (kolom); ada {len(rows)} opsi, {k} kriteria')
        if (not isinstance(bobot, list) or len(bobot) != k or any(not isinstance(b, int) or isinstance(b, bool) or b < 1 for b in bobot)):
            raise DeckGalat(f'{asal}: opsi butuh "bobot" daftar {k} bilangan bulat >= 1, satu per kriteria berurutan')
        if any(s['nilai'] is None or not 1 <= s['nilai'] <= 5 for r in rows for s in r[1:]):
            raise DeckGalat(f'{asal}: skor opsi harus angka ber-fmt "0" antara 1 dan 5 di semua kriteria')
        nama = [r[0]['teks'] for r in rows]
        if v.get('terpilih') not in nama:
            raise DeckGalat(f'{asal}: opsi "terpilih" harus salah satu nama opsi: {", ".join(nama)}')
        jb = sum(bobot)
        total = [sum(s['nilai'] * b for s, b in zip(r[1:], bobot)) / jb for r in rows]
        pilih = nama.index(v['terpilih'])
        if total[pilih] + 1e-9 < max(total):
            t_ = max(range(len(rows)), key=lambda q: total[q])
            raise DeckGalat(f'{asal}: opsi terpilih "{nama[pilih]}" ({fmt_id(total[pilih], 1)}) bukan skor tertinggi: "{nama[t_]}" '
                            f'({fmt_id(total[t_], 1)}); ubah terpilih atau skor/bobot (D-46)')
        tt = [fmt_id(t_, 1) for t_ in total]
        for r, t_, s_ in zip(rows, total, tt):
            self.turunan(f'opsi:skor:{r[0]["teks"]}', s_, t_, asal, tb['keyakinan'], tb['sumber'])
        for c, b in zip(kol[1:], bobot):
            self.turunan(f'opsi:bobot:{c["nama"]}', str(b), b, asal, tb['keyakinan'], tb['sumber'])
        sk_ = v.get('skala_huruf', 1.6)
        gl = dict(self.T['label_tabel_utama'], ukuran_pt=pt_dari(self.T['label_tabel_utama']) * sk_)
        gn = dict(self.T['nilai_tabel'], ukuran_pt=pt_dari(self.T['nilai_tabel']) * sk_ * 1.15)
        gk = dict(self.T['kepala_kolom'], ukuran_pt=pt_dari(self.T['kepala_kolom']) * 1.25)
        gt = dict(self.T['tanggal_batang'], ukuran_pt=pt_dari(self.T['tanggal_batang']) * 1.5)
        hk = pt_dari(gk) * 3.4
        cat = 'Skor makin tinggi makin baik; skor akhir adalah rerata tertimbang menurut bobot kriteria.'
        hc = pt_dari(gt) * 2.2
        lw, tw = w * 0.26, w * 0.15
        cw = (w - lw - tw) / k
        for j, c in enumerate(kol[1:]):
            cx = x + lw + j * cw
            rk = self.runs(c.get('kepala', c['nama']), dict(gk, warna='navy'), asal)
            self.muat(rk, cw - 8, 2, asal, f'kriteria {c["nama"]}')
            kv.teks(cx + 4, y, cw - 8, hk * 0.62, rk, rata='c', jangkar='b')
            kv.teks(cx + 4, y + hk * 0.62, cw - 8, hk * 0.38, [self.R('bobot ' + str(bobot[j]), gt, 'teks-2')], rata='c', jangkar='t', bungkus=False)
        kv.teks(x + lw + k * cw, y, tw, hk, [self.R('SKOR AKHIR', dict(gk, warna='navy'))], rata='c', jangkar='b', bungkus=False)
        kv.garis(x, y + hk, x + w, y + hk, 'navy', 1)
        n = len(rows)
        rh = min(v.get('baris_maks_pt', 150), (h - hk - hc - 6) / n)
        y0 = y + hk + 3
        for i, r in enumerate(rows):
            ry, sel = y0 + i * rh, i == pilih
            if sel:
                kv.bentuk('kotak', x, ry + 1, w, rh - 2, 'tint.netral.pita')
                kv.bentuk('kotak', x, ry + 1, 4, rh - 2, 'oranye')
            ln = [[self.R(r[0]['teks'], dict(gl, warna='navy' if sel else 'teks'), tebal=True)]]
            if sel:
                ln.append([self.R('DIREKOMENDASIKAN', dict(gt, warna='oranye'), tebal=True)])
            self.muat(ln[0], lw - 14, 2, asal, f'nama opsi {r[0]["teks"]}')
            kv.teks(x + 10, ry, lw - 14, rh, ln, jangkar='m')
            for j, s in enumerate(r[1:]):
                cx = x + lw + j * cw
                kv.teks(cx, ry + rh * 0.12, cw, rh * 0.5, [self.R(s['teks'], gn, 'navy' if sel else 'teks')], rata='c', jangkar='b', bungkus=False)
                bw = cw * 0.5
                kv.bentuk('kotak', cx + (cw - bw) / 2, ry + rh * 0.68, bw, 3, 'tint.netral.pita' if not sel else 'pembanding')
                kv.bentuk('kotak', cx + (cw - bw) / 2, ry + rh * 0.68, bw * s['nilai'] / 5, 3, 'oranye' if sel else 'skala.netral.3')
            kv.teks(x + lw + k * cw, ry, tw, rh, [self.R(tt[i], dict(gn, ukuran_pt=pt_dari(gn) * 1.3), 'oranye' if sel else 'navy', True)],
                    rata='c', jangkar='m', bungkus=False)
            if i < n - 1:
                kv.garis(x, ry + rh, x + w, ry + rh, 'garis', 0.5)
        kv.teks(x, y0 + n * rh + 3, w, hc, [self.R(cat, gt, 'teks-2')], jangkar='t')
        return tb

    def eksibit(self, kv, bx, by, bw, bh, p, asal):
        """Kerangka eksibit opsional (putaran 5b, celah 2): kicker "GAMBAR N" bernomor otomatis per deck (`gambar: true`),
        subjudul tebal satuan dan periode (`subjudul_grafik`), catatan kaki bernomor kecil di dasar badan panel (`catatan`: daftar).
        Kembalikan kotak sisa (bx, by, bw, bh)."""
        if not (p.get('gambar') or p.get('subjudul_grafik') or p.get('catatan')):
            return bx, by, bw, bh
        gk = dict(self.T['tanggal_batang'])
        if p.get('gambar'):
            no = self._no_gambar.setdefault((asal, str(p.get('judul') or p.get('judul_panel'))), len(self._no_gambar) + 1)
            self.turunan(f'gambar:{no}', str(no), float(no), asal, 'resmi', 'urutan spek')   # nomor eksibit bukan data, tetapi D-22 mencatatnya
            kv.teks(bx, by, bw, 10, [self.R(f'GAMBAR {no}', gk, 'navy', True, 7)], jangkar='m', bungkus=False)
            by, bh = by + 10, bh - 10
        if p.get('subjudul_grafik'):
            r = self.runs(p['subjudul_grafik'], self.T['isi_panel'], asal, tebal=True)
            self.muat(r, bw, 1, asal, 'subjudul grafik')
            kv.teks(bx, by, bw, 12, r, jangkar='m', bungkus=False)
            kv.garis(bx, by + 13, bx + bw, by + 13, 'garis', 0.5)
            by, bh = by + 16, bh - 16
        if p.get('catatan'):
            for i in range(1, len(p['catatan']) + 1):
                self.turunan(f'catatan:{asal}:{p.get("judul") or p.get("judul_panel")}:{i}', str(i), float(i), asal, 'resmi', 'urutan spek')
            paras = [[self.R(f'{i}  ', gk, 'teks-3', True, 6)] + self.runs(c, gk, asal, ukuran=6) for i, c in enumerate(p['catatan'], 1)]
            ch = sum(self.u.baris([q], bw) for q in paras) * 7.6 + 2
            kv.teks(bx, by + bh - ch, bw, ch, paras, jangkar='b')
            bh -= ch + 4
        return bx, by, bw, bh

    def skala_daftar(self, w, h, p, asal):
        """Putaran 5b/5f: panel hanya berisi daftar (1 sampai 6 butir, batas S38) dan tanpa skala_huruf: huruf naik otomatis
        sampai 3x lewat pencarian biner memakai pengukur baris yang sama dengan penggambar (bukan hitung kasar), sampai daftar
        mengisi badan panel (97%) dan tidak pernah melewatinya, sehingga butir terakhir tidak menyentuh pita Sumber.
        `tanpa_kepala`: badan panel = seluruh kotak."""
        if p.get('skala_huruf') or p.get('_auto') or 'daftar' not in p or not 1 <= len(p['daftar']) <= 6:
            return None
        if set(p) - {'judul', 'ikon', 'nada', 'hitungan', 'keyakinan', 'daftar', 'tanpa_kepala'}:
            return None
        P = self.K['panel']
        bw = w - 2 * P['pad_pt']
        if p.get('tanpa_kepala'):
            bw, bh = w, h
        else:
            bh = h - P['pita_pt'] - P['pad_pt'] * 0.8 - max(self.K['jarak_isi_ke_tepi_panel_pt'], P['pad_pt'])
        g0 = self.T['isi_panel']

        def muat(k):
            g = dict(g0, ukuran_pt=pt_dari(g0) * k)
            return self.tinggi_daftar(self.paras_daftar(p['daftar'], g, asal), g, bw, True) <= bh * 0.97
        if not muat(1.0):
            return None
        lo, hi = 1.0, 3.0
        if muat(hi):
            return hi
        for _ in range(14):
            mid = (lo + hi) / 2
            lo, hi = (mid, hi) if muat(mid) else (lo, mid)
        return lo if lo > 1.0 else None

    def panel_isi(self, kv, x, y, w, h, p, asal):
        auto = self.skala_daftar(w, h, p, asal)
        if auto:
            p = dict(p, skala_huruf=round(auto, 2), _auto=True)
        sk = p.get('skala_huruf')
        if sk:  # bahan sedikit di panel lega: huruf diperbesar, bukan ruang kosong (pemilik 26 Okt, batas 5%)
            asli = {k: self.T[k] for k in ('temuan_isi', 'isi_daftar', 'isi_panel', 'label_tabel_utama', 'isi_tabel', 'nilai_tabel')}
            try:
                for k, g0 in asli.items():
                    self.T[k] = dict(g0, ukuran_pt=pt_dari(g0) * sk)
                return self.panel_isi(kv, x, y, w, h, dict(p, skala_huruf=None), asal)
            finally:
                self.T.update(asli)
        kepala = not p.get('tanpa_kepala')   # putaran 5f: isi tanpa kepala panel (susun vertikal, jenis bebas): badan = seluruh kotak
        if kepala:
            kyk = p.get('data', {}).get('keyakinan') or p.get('keyakinan')
            bx, by, bw, bh = self.panel(kv, x, y, w, h, p['judul'], p.get('ikon', 'ringkasan'), p.get('nada', 'netral'), p.get('hitungan'), kyk, asal)
        else:
            bx, by, bw, bh = x, y, w, h
        bx, by, bw, bh = self.eksibit(kv, bx, by, bw, bh, p, asal)
        sumber = []
        if 'data' in p:
            tb = self.data(p['data'], asal)
            for k_ in ('baris_maks_pt', 'sel_dua_baris', 'sel_maks_baris'):
                if k_ in p:
                    tb[k_] = p[k_]
            tinggi = bh
            if 'daftar' in p:  # tabel di atas, butir catatan di bawahnya dalam panel yang sama (satu topik satu kontainer)
                g = self.T['isi_daftar']
                tinggi = bh - self.tinggi_daftar(self.paras_daftar(p['daftar'], g, asal), g, bw) - self.K['panel']['pad_pt'] * 2
            akhir = self.peringkat(kv, bx, by, bw, tinggi, tb, asal, p.get('peringkat', True), p.get('total', False), p.get('ikon_baris'))
            bh -= akhir - by + self.K['panel']['pad_pt']
            by = akhir + self.K['panel']['pad_pt']
            sumber.append(tb['sumber'])
        if 'grafik' in p:  # grafik batang di panel samping (pemilik 27 Okt: tren bulanan di samping tabel provinsi)
            if kepala and self.hal is not None and self.hal.get('panel'):
                self.hal['panel'][-1].append('grafik')   # D-40 memakai batas panel grafik (ruang di atas batang pendek bagian dari encoding)
            gh = bh
            if 'daftar' in p:  # butir catatan di bawah grafik dalam panel yang sama
                g = self.T['isi_panel']
                gh = bh - self.tinggi_daftar(self.paras_daftar(p['daftar'], g, asal), g, bw) - self.K['panel']['pad_pt'] * 2
            if self.hal is not None:   # putaran 5f (CELAH-2 butir 3): bidang plot batang (juga horizontal) terisi untuk D-39; ruang putih di kanan batang pendek adalah encoding
                self.hal.setdefault('terisi', []).append([round(bx, 1), round(by, 1), round(bw, 1), round(gh, 1)])
            sumber.append(self.grafik_batang(kv, bx, by, bw, gh, p['grafik'], asal)['sumber'])
            by, bh = by + gh + self.K['panel']['pad_pt'], bh - gh - self.K['panel']['pad_pt']
        for nama in self.VISUAL_PANEL:   # corong, progres, tumpuk: isi panel pengganti tabel (pemilik 30 Okt)
            if nama in p:
                if kepala and self.hal is not None and self.hal.get('panel'):
                    self.hal['panel'][-1].append('grafik')
                vh = bh
                if 'daftar' in p:
                    g = self.T['isi_panel']
                    vh = bh - self.tinggi_daftar(self.paras_daftar(p['daftar'], g, asal), g, bw) - self.K['panel']['pad_pt'] * 2
                if self.hal is not None and nama not in ('banding', 'opsi') and self.jenis_visual(nama, p[nama]) != 'tabel':
                    # D-39/D-40 (putaran 5b): bidang plot grafik (garis, titik, waterfall, modul visual) terisi; ruang putihnya encoding
                    self.hal.setdefault('terisi', []).append([round(bx, 1), round(by, 1), round(bw, 1), round(vh, 1)])
                if nama in VISUAL_EKSTRA:
                    m = VISUAL_EKSTRA[nama]
                    self.visual(self.jenis_visual(nama, p[nama]))
                    sumber.append(m.gambar(self, kv, bx, by, bw, vh, p[nama], asal)['sumber'])
                else:
                    sumber.append(getattr(self, nama)(kv, bx, by, bw, vh, p[nama], asal)['sumber'])
                by, bh = by + vh + self.K['panel']['pad_pt'], bh - vh - self.K['panel']['pad_pt']
        if 'foto' in p:  # slot foto dokumentasi: kisi foto dengan keterangan satu baris (pemilik 25 Okt: slot foto boleh)
            self.kisi_foto(kv, bx, by, bw, bh, p['foto'], p.get('kolom_foto', 2), asal)
        if 'temuan' in p:
            self.daftar_temuan(kv, bx, by, bw, bh, p['temuan'], asal, kolom=1)
        if 'daftar' in p:  # panel yang hanya berisi butir memakai huruf panel yang lebih besar
            self.daftar(kv, bx, by, bw, bh, p['daftar'], asal, None if 'data' in p else self.T['isi_panel'], lega=bool(p.get('_auto')))
        return sumber

    @staticmethod
    def jenis_visual(nama, v):
        """Jenis modul visual; modul boleh menentukan per mode lewat jenis_mode(v) -> 'grafik'|'tabel' (putaran 5c)."""
        m = VISUAL_EKSTRA.get(nama)
        if m is None:
            return 'grafik'
        return m.jenis_mode(v) if hasattr(m, 'jenis_mode') else getattr(m, 'JENIS', 'grafik')

    def s_kesimpulan(self, kv, j):
        sp, asal, KS = j['spek'], j['asal'], self.K['kesimpulan']
        kartu = sp['kartu']
        if len(kartu) != KS['kolom'] * KS['baris']:
            raise DeckGalat(f'{asal}: kesimpulan butuh {KS["kolom"] * KS["baris"]} kartu (Buku Pegangan: grid 4 x 2), ada {len(kartu)}')
        jr = KS['jarak_pt']
        cw = (self.W - (KS['kolom'] - 1) * jr) / KS['kolom']
        pad, d = KS['pad_pt'], KS['lingkaran_pt']
        th = KS['tinggi_pt']
        if not sp.get('arahan'):   # tanpa pita arahan: kartu memanjang sampai kaki, bukan sepertiga slide kosong (pemilik 1 Nov 2026: "terlalu banyak white space")
            th = max(th, (self.bawah(bool(sp.get('sumber'))) - KS['y_pt'] - (KS['baris'] - 1) * jr) / KS['baris'])
        for i, k in enumerate(kartu):
            x = self.X0 + (i % KS['kolom']) * (cw + jr)
            y = KS['y_pt'] + (i // KS['kolom']) * (th + jr)
            wt = k.get('warna', 'navy')
            self.cek_kelas(k['label'] + ' ' + k['judul'], wt, asal)
            kv.bentuk('bulat', x, y, cw, th, 'kertas', self.K['kartu']['warna_garis'], radius=KS['radius_pt'], bayang=True)   # bayangan tipis (pemilik 26 Okt)
            kv.bulat_ikon(x + pad, y + pad, d, self.tint(wt), k['ikon'], wt, KS['ikon_rasio'])
            # label jadi pil di kanan atas, sejajar ikon; nomor 01-08 dibuang (pemilik 27 Okt: "angka ini ga guna")
            ph = self.K['chip']['tinggi_pt']
            self.pil(kv, x + cw - pad, y + pad + (d - ph) / 2, [self.R(k['label'], self.T['chip'], 'kertas')], ph, wt, kanan=True)   # pil gelap tulisan putih (pemilik 27 Okt)
            tw, naik = cw - 2 * pad, KS['judul_dy_pt'] - KS['label_dy_pt']   # baris label kosong: judul dan isi naik
            r = self.runs(k['judul'], self.T['judul_kartu_kesimpulan'], asal)
            nj = self.muat(r, tw, 2, asal, f'judul kartu {i + 1}')
            kv.teks(x + pad, y + KS['judul_dy_pt'] - naik, tw, KS['judul_tinggi_pt'], r)
            isi_dy = (KS['isi_dy_pt'] if nj > 1 else KS['judul_dy_pt'] + KS['judul_tinggi_pt'] / 2 + 4) - naik   # judul satu baris: isi naik, tanpa celah
            gi = self.T['isi_kartu_kesimpulan']
            if sp.get('skala_isi'):  # isi kartu lega: huruf diperbesar, bukan ruang kosong (pemilik 27 Okt)
                gi = dict(gi, ukuran_pt=pt_dari(gi) * sp['skala_isi'])
            maks = KS['isi_maks_baris'] + (0 if nj > 1 else 1)
            if k.get('sub'):   # subjudul kriteria: satu baris tebal berwarna kelas, isi turun satu baris (pemilik 27 Okt)
                rs = self.runs(k['sub'], dict(gi, tebal=True), asal, warna_=wt)
                self.muat(rs, tw, 1, asal, f'subjudul kartu {i + 1}')
                hs = pt_dari(gi) * 1.3
                kv.teks(x + pad, y + isi_dy, tw, hs, rs, bungkus=False)
                isi_dy, maks = isi_dy + hs + 2, maks - 1
            if th > KS['tinggi_pt'] and not k.get('sub'):   # kartu memanjang: huruf isi sebesar yang muat, ruang terisi
                for sk in (2.1, 2.0, 1.9, 1.8, 1.7, 1.6, 1.5, 1.4, 1.3, 1.2, 1.1, 1.0):
                    g2 = dict(self.T['isi_kartu_kesimpulan'], ukuran_pt=pt_dari(self.T['isi_kartu_kesimpulan']) * max(sk, sp.get('skala_isi') or 1))
                    m2 = int((th - isi_dy - pad * 0.6) / (pt_dari(g2) * 1.35))
                    try:
                        self.muat(self.runs(k['isi'], g2, asal), tw, m2, asal, f'isi kartu {i + 1}')
                    except DeckGalat:
                        continue
                    gi, maks = g2, m2
                    break
            r = self.runs(k['isi'], gi, asal)
            nb = self.muat(r, tw, maks, asal, f'isi kartu {i + 1}')
            kv.teks(x + pad, y + isi_dy, tw, th - isi_dy - pad * 0.6, r, rata='j')  # isi kartu selalu rata kanan-kiri; perkiraan baris bisa meleset (pemilik 1 Nov 2026: "kenapa ada yang ga justify")
        if sp.get('arahan'):
            A, a = KS['arahan'], sp['arahan']
            y = KS['y_pt'] + KS['baris'] * (KS['tinggi_pt'] + jr)
            if a.get('isi_bawah'):   # pesan panjang: pita arahan mengisi sisa ruang sampai kaki, tanpa ruang kosong (pemilik 27 Okt)
                A = dict(A, tinggi_pt=self.bawah(bool(sp.get('sumber'))) - y)
            terang = a.get('nada') == 'catatan'   # pita catatan terang: kesimpulan di bawah kartu tanpa blok oranye (pemilik 1 Nov 2026)
            kv.bentuk('bulat', self.X0, y, self.W, A['tinggi_pt'], self.tint('navy') if terang else A['warna_isi'], radius=A['radius_pt'])
            dd = A['lingkaran_pt']
            kv.bulat_ikon(self.X0 + pad, y + (A['tinggi_pt'] - dd) / 2, dd, 'navy' if terang else A['warna_lingkaran'], a.get('ikon', 'peringatan'), 'kertas' if terang else A['warna_ikon'], KS['ikon_rasio'])
            lx = self.X0 + pad + dd + pad
            lab = [self.R(a.get('label', 'ARAHAN').upper(), dict(self.T['label_arahan'], warna='navy') if terang else self.T['label_arahan'])]
            lw = self.u.lebar(lab) + pad
            kv.teks(lx, y, lw, A['tinggi_pt'], lab, jangkar='m', bungkus=False)
            r = self.runs(a['teks'], dict(self.T['arahan'], warna='teks', tebal=False) if terang else self.T['arahan'], asal)
            tw = self.X1 - pad - lx - lw
            self.muat(r, tw, 3 if a.get('isi_bawah') else 2, asal, 'arahan')
            kv.teks(lx + lw, y, tw, A['tinggi_pt'], r, jangkar='m', rata='j')
        self.catatan_sumber(kv, j)

    def chip_lembaga(self, kv, x, y, maks_x, lembaga, asal, baris_maks=2):
        """Chip lembaga berikon (bukan logo): pemimpin pil navy, pendukung pil bergaris; dibungkus ke baris berikut."""
        C = self.K['chip']
        h, x0, n = C['tinggi_pt'], x, 1
        for i, nama in enumerate(lembaga):
            self.cek_teks(nama, asal)
            r = [self.R(nama, self.T['chip'], 'kertas' if i == 0 else 'teks')]
            lebar = h * C['pad_rasio'] * 2 + self.u.lebar(r) + h * C['ikon_rasio'] + h * C['pad_rasio'] * 0.6
            if x + lebar > maks_x and x > x0:
                x, y, n = x0, y + h + C['jarak_pt'], n + 1
                if n > baris_maks:
                    raise DeckGalat(f'{asal}: chip lembaga lebih dari {baris_maks} baris; kurangi lembaga')
            if x + lebar > maks_x + 0.5:  # chip pertama di baris yang tetap keluar dari panel (26 Okt, Pascabencana R-A21)
                raise DeckGalat(f'{asal}: chip "{nama}" {lebar:.0f} pt keluar {x + lebar - maks_x:.0f} pt dari tepi panel; pakai nama unit yang lebih pendek')
            self.pil(kv, x, y, r, h, C['warna_pemimpin'] if i == 0 else 'kertas', None if i == 0 else C['warna_garis'],
                     'lembaga', 'kertas' if i == 0 else C['warna_ikon'])
            x += lebar + C['jarak_pt']
        return y + h

    def chip_teks(self, kv, x, y, teks, nada, ikon=None):
        C = self.K['chip']
        return self.pil_nada(kv, x, y, teks, self.T['chip'], C['tinggi_pt'], nada, ikon)

    def s_rekomendasi(self, kv, j):
        sp, asal, RK = j['spek'], j['asal'], self.K['baris_rekomendasi']
        rows = sp['rekomendasi']
        self.visual('tabel')
        y0 = self.S['area_isi_y_pt'][0]
        if sp.get('pita') and sp['pita'].get('atas'):   # pita tujuan di atas tabel (pemilik 27 Okt)
            h = self.K['pita_bawah']['tinggi_baku_pt'] * sp['pita'].get('skala', 1)
            self.pita(kv, self.X0, y0, self.W, sp['pita'], asal)
            y0 += h + self.K['bingkai']['jarak_blok_pt']
        xs = [self.X0 + f * self.W for f in sp.get('kolom_rasio', RK['kolom_rasio'])]   # spek boleh merapatkan kolom (pemilik 27 Okt)
        # kepala seperti tabel lain: latar navy, tulisan putih, rata tengah per kolom (pemilik 27 Okt)
        kv.bentuk('bulat', self.X0, y0, self.W, RK['kepala_tinggi_pt'], self.K['tabel_peringkat']['warna_total'], radius=3).name = 'Pita kepala tabel'
        gk = dict(self.T['kepala_kolom'], warna='kertas')
        for teks, xa, xb in zip((self.ui['langkah'], self.ui['rincian'], self.ui['penanggung']), xs, xs[1:] + [self.X1]):
            kv.teks(xa, y0, xb - xa, RK['kepala_tinggi_pt'], [self.R(teks, gk)], rata='c', jangkar='m', bungkus=False)
        yk = y0 + RK['kepala_tinggi_pt'] + 2
        ada_sumber = bool(sp.get('sumber'))  # baris rekomendasi tanpa kaki (d5), kecuali spek menulis sumbernya
        bawah = self.bawah(ada_sumber)
        if sp.get('pita') and not sp['pita'].get('atas'):  # slide lanjutan dengan sedikit baris: sisa ruang diisi pita bawah, bukan baris yang diregangkan
            h = self.K['pita_bawah']['tinggi_baku_pt'] * sp['pita'].get('skala', 1)
            self.pita(kv, self.X0, bawah - h, self.W, sp['pita'], asal)
            bawah -= h + self.K['bingkai']['jarak_blok_pt']
        rh = max(RK['tinggi_pt'], min(RK['tinggi_maks_pt'], (bawah - yk) / len(rows)))
        if yk + len(rows) * rh > bawah:
            raise DeckGalat(f'{asal}: {len(rows)} rekomendasi tidak muat satu slide; pecah ke slide berikut')
        d = RK['lingkaran_pt']
        st = self.t['kosakata']['status_usulan']
        TL, TR = self.T['langkah'], self.T['rincian_rekomendasi']
        if rh > RK['tinggi_pt'] * 1.15:   # baris lega: huruf diperbesar sampai muat, bukan teks kecil di baris kosong (pemilik 1 Nov 2026)
            lw0 = xs[1] - (self.X0 + 6 + d + RK['jarak_pt']) - RK['jarak_pt']
            rw0 = xs[2] - xs[1] - RK['jarak_pt'] * 2
            def _cari(gaya, teks_, lebar, baris, batas):   # skala terbesar yang muat untuk SEMUA baris kolom itu
                for sk in (2.0, 1.9, 1.8, 1.7, 1.6, 1.5, 1.4, 1.3, 1.2, 1.1):
                    g_ = dict(gaya, ukuran_pt=pt_dari(gaya) * min(sk, batas))
                    if pt_dari(g_) * 1.35 * baris > rh * 0.85:
                        continue
                    try:
                        for t_ in teks_:
                            self.muat(self.runs(t_, g_, asal), lebar, baris, asal, 'uji skala')
                    except DeckGalat:
                        continue
                    return g_
                return gaya
            TL = _cari(TL, [r['langkah'] for r in rows], lw0, 1, 1.5)
            TR = _cari(TR, [r['rincian'] for r in rows], rw0, 3, 2.0)
        for i, r in enumerate(rows):
            ry = yk + i * rh
            if i:
                kv.garis(self.X0, ry, self.X1, ry, RK['warna_pemisah'], 0.5)
            if r['jenis'] not in self.t['kosakata']['jenis_aksi']:
                raise DeckGalat(f'{asal}: jenis aksi "{r["jenis"]}" tidak dikenal')
            kv.bulat_ikon(self.X0 + 6, ry + (rh - d) / 2, d, RK['warna_lingkaran'], r.get('ikon', r['jenis']), 'kertas', RK['ikon_rasio'])   # ikon per baris boleh beda dari jenis aksi   # menjauh dari garis tepi kiri
            lx = self.X0 + 6 + d + RK['jarak_pt']
            lw = xs[1] - lx - RK['jarak_pt']
            oy = ry + (rh - RK['tinggi_pt']) / 2  # blok langkah di tengah baris
            kode_r = [self.R(self.st(r['kode']) + '  ', TL, RK['warna_kode'])] if self.S.get('kode_temuan', False) else []  # kode R-A01 tidak tampil (pemilik 26 Okt)
            jr = kode_r + self.runs(r['langkah'], TL, asal)
            self.muat(jr, lw, 1, asal, f'langkah {r["kode"]}')
            if r.get('waktu') or r.get('status'):
                kv.teks(lx, oy + RK['langkah_dy_pt'], lw, 14, jr, jangkar='m', bungkus=False)
            else:   # tanpa pil waktu/status: langkah di tengah baris
                kv.teks(lx, ry, lw, rh, jr, jangkar='m', bungkus=False)
            cx = lx
            hz = self.t['kosakata']['horizon']
            if r.get('waktu'):  # waktu kosong: pil waktu tidak tampil (pemilik 26 Okt, deck Malaysia)
                if r['waktu'] not in hz:
                    raise DeckGalat(f'{asal}: waktu "{r["waktu"]}" bukan 100-hari, 2026-2027, 2028-2030')
                cx += self.chip_teks(kv, cx, oy + RK['chip_dy_pt'], hz[r['waktu']], RK['nada_waktu'], 'kalender') + self.K['chip']['jarak_pt']
            if r.get('status'):
                if r['status'] not in st:
                    raise DeckGalat(f'{asal}: status "{r["status"]}" bukan sudah-ada, dikembangkan, baru')
                self.chip_teks(kv, cx, oy + RK['chip_dy_pt'], st[r['status']]['label'], st[r['status']])
            rw = xs[2] - xs[1] - RK['jarak_pt'] * 2
            rr = self.runs(r['rincian'], TR, asal)
            self.muat(rr, rw, 3 if TR is not self.T['rincian_rekomendasi'] else 2, asal, f'rincian {r["kode"]}')
            kv.teks(xs[1], ry, rw, rh, rr, rata='j', jangkar='m')
            hc = self.K['chip']['tinggi_pt']
            nb = 1 if self.u.lebar([self.R('  '.join(r['lembaga']), self.T['chip'])]) + len(r['lembaga']) * hc * 1.6 < self.X1 - xs[2] else 2
            self.chip_lembaga(kv, xs[2], ry + (rh - nb * hc - (nb - 1) * self.K['chip']['jarak_pt']) / 2, self.X1, r['lembaga'], asal)
        kv.garis(self.X0, yk + len(rows) * rh, self.X1, yk + len(rows) * rh, RK['warna_garis_kepala'], 0.75)   # garis paling bawah hitam, seperti tabel lain
        if ada_sumber:
            self.catatan_sumber(kv, j)

    def s_strategi_tiga_fase(self, kv, j):
        sp, asal, TF = j['spek'], j['asal'], self.K['tiga_fase']
        self.visual('grafik')  # rantai tahap (G21)
        jarak = self.K['bingkai']['jarak_blok_pt']
        y = self.S['area_isi_y_pt'][0]
        bawah = self.bawah(False)
        if sp.get('pita'):
            h = self.K['pita_bawah']['tinggi_baku_pt'] * sp['pita'].get('skala', 1)
            self.pita(kv, self.X0, bawah - h, self.W, sp['pita'], asal)
            bawah -= h + jarak
        fase = self.t['kosakata']['fase']
        cw = (self.W - 2 * jarak) / 3
        # lebar pil kode dari teks terlebar di slide (R-M03 lebih lebar dari A1), sama untuk semua supaya kolom aksi rata
        kw = max([TF['kode_lebar_pt']] + [self.u.lebar([self.R(self.st(a['kode']), self.T['kode_aksi'])]) + 8
                                         for f in j['fase'].values() for a in f])
        for i, kode in enumerate(('prabencana', 'tanggap-darurat', 'pascabencana')):
            aksi = j['fase'][kode]  # waktu dan pemimpin diturunkan dari matriks rekomendasi di siapkan()
            x = self.X0 + i * (cw + jarak)
            bx, by, bw, bh = self.panel(kv, x, y, cw, bawah - y, fase[kode]['label'], kode, 'netral', asal=asal)
            ah = min(TF['aksi_maks_pt'], bh / len(aksi))
            isi_h = TF['chip_dy_pt'] + self.K['chip']['tinggi_pt']
            for n, a in enumerate(aksi):
                ay = by + n * ah
                if n:
                    kv.garis(bx, ay, bx + bw, ay, TF['warna_pemisah'], 0.5)
                ay += (ah - isi_h) / 2
                s = kv.bentuk('bulat', bx, ay + 1, kw, TF['kode_tinggi_pt'], TF['warna_kode'], radius=3)
                kv.isi_teks(s.text_frame, [[self.R(self.st(a['kode']), self.T['kode_aksi'])]], 'c', 'm', False)
                tx = bx + kw + 6
                r = self.runs(a['aksi'], self.T['aksi_fase'], asal)
                self.muat(r, bx + bw - tx, 2, asal, f'aksi {a["kode"]}')
                kv.teks(tx, ay, bx + bw - tx, TF['aksi_teks_tinggi_pt'], r)
                cy = ay + TF['chip_dy_pt']
                cx = tx + self.chip_teks(kv, tx, cy, self.t['kosakata']['horizon'][a['waktu']], TF['nada_waktu'], 'kalender') + self.K['chip']['jarak_pt']
                self.chip_lembaga(kv, cx, cy, bx + bw, a['lembaga'], asal, baris_maks=1)
        self.catatan_sumber(kv, j)   # sumber dari spek atau angka bertoken (sebelumnya tidak pernah tampil, juri 1 Nov)

    def s_skenario(self, kv, j):
        sp, asal, SK = j['spek'], j['asal'], self.K['skenario']
        s = sp['skenario']
        kat = next((k for k, v in self.t['warna']['kategori'].items() if not k.startswith('_') and s['jenis'] in v['jenis']), None)
        if not kat:
            raise DeckGalat(f'{asal}: jenis "{s["jenis"]}" tidak ada di kategori bencana')
        kw = self.t['warna']['kategori'][kat]
        y0, bawah = self.S['area_isi_y_pt'][0], self.bawah()
        x, w = self.X0, self.W
        pita, P = SK['kepala_tinggi_pt'], self.K['panel']
        tint = f'tint.{kw["tint"]}.pita'
        # satu topik satu kontainer
        kv.bentuk('bulat', x, y0, w, bawah - y0, 'kertas', radius=P['radius_pt'])
        kv.bentuk('bulat', x, y0, w, pita, tint, radius=P['radius_pt'])
        kv.bentuk('kotak', x, y0 + pita / 2, w, pita / 2, tint)
        kv.bentuk('bulat', x, y0, w, bawah - y0, None, P['warna_garis'], P['tebal_garis_pt'], radius=P['radius_pt'])
        d = P['lingkaran_pt']
        kv.bulat_ikon(x + P['pad_pt'], y0 + (pita - d) / 2, d, f'kategori.{kat}', s['jenis'], 'kertas', P['ikon_pt'] / d)
        kanan = x + w - P['pad_pt'] - self.pil_keyakinan(kv, x + w - P['pad_pt'], y0 + (pita - self.K['chip']['tinggi_pt']) / 2, self.K['chip']['tinggi_pt'], s['keyakinan']) - P['pad_pt']
        label_jenis = s.get('label_jenis') or self.t['kosakata']['jenis_bencana'][s['jenis']]  # lingkup ancaman bila lebih sempit dari kosakata
        self.cek_teks(label_jenis, asal)
        jr = [self.R(label_jenis + ': ', self.T['judul_panel'])] + self.runs(s['judul'], self.T['judul_panel'], asal)
        jx = x + P['pad_pt'] + d + P['jarak_judul_pt']
        self.muat(jr, kanan - jx, 1, asal, 'judul skenario')
        kv.teks(jx, y0, kanan - jx, pita, jr, jangkar='m', bungkus=False)
        pad = P['pad_pt']
        top = y0 + pita + pad
        kiri_w = w * SK['rasio_kerusakan']
        cw = (w - 2 * pad - 2 * pad) / 3
        gd = self.T['isi_panel']
        h_daftar = max(self.tinggi_daftar(self.paras_daftar(s[k], gd, asal), gd, cw) for k in ('respons', 'pemulihan'))
        bawah_atas = bawah - self.K['jarak_isi_ke_tepi_panel_pt'] - h_daftar - SK['label_tinggi_pt'] - 10 - pad * 0.6
        gk = self.T['kepala_kolom']
        # kerusakan
        kv.teks(x + pad, top, kiri_w, SK['label_tinggi_pt'], [self.R('KERUSAKAN DAN KORBAN', gk)], jangkar='m', bungkus=False)
        rows = s['kerusakan']
        self.visual('tabel')
        rt = top + SK['label_tinggi_pt'] + 2
        rh = min(SK['baris_maks_pt'], (bawah_atas - rt) / len(rows))
        xv = x + pad + kiri_w * SK['kolom_nilai_rasio']
        for i, r in enumerate(rows):
            ry = rt + i * rh
            kv.garis(x + pad, ry, x + kiri_w, ry, self.K['tabel_peringkat']['warna_pemisah'], 0.5)
            kv.teks(x + pad, ry, xv - x - pad - 6, rh, self.runs(r['besaran'], self.T['isi_tabel'], asal), jangkar='m', bungkus=False)
            nr = self.runs(r['nilai'], self.T['nilai_tabel'], asal, tebal=True)
            kv.teks(xv, ry, kiri_w * 0.3, rh, nr, jangkar='m', bungkus=False)
            kyk = r.get('keyakinan') or self.k.manifest[-1]['keyakinan']
            self.pil_keyakinan(kv, x + kiri_w, ry + (rh - self.K['chip']['tinggi_pt']) / 2, self.K['chip']['tinggi_pt'], kyk)
        # kemungkinan dan angka kebijakan
        kx = x + kiri_w + pad * 2
        kw_ = x + w - pad - kx
        kv.garis(kx - pad, top, kx - pad, bawah_atas, self.K['tabel_peringkat']['warna_pemisah'], 0.75)
        kv.teks(kx, top, kw_, SK['label_tinggi_pt'], [self.R('KEMUNGKINAN DALAM LIMA TAHUN', gk)], jangkar='m', bungkus=False)
        ch = self.K['chip']['tinggi_pt']
        yw = self.pil_keyakinan(kv, kx + kw_, top + (SK['label_tinggi_pt'] - ch) / 2, ch, s['kemungkinan_keyakinan']) + 4 \
            if s.get('kemungkinan_keyakinan') else 0
        pel = self.t['kosakata']['kemungkinan_5_tahun']
        bw = (kw_ - 4 * 3) / 5
        if s.get('kemungkinan') is None:  # belum dihitung dari data: tidak menyorot kelas apa pun
            r = self.runs(s.get('kemungkinan_catatan', 'Kelas kemungkinan dalam penyusunan'), self.T['isi_tabel'], asal)
            rw = self.u.lebar(r) + 4
            kv.teks(kx + kw_ - yw - rw, top, rw, SK['label_tinggi_pt'], r, rata='r', jangkar='m', bungkus=False)
        for n in range(1, 6):
            aktif = str(n) == str(s['kemungkinan'])
            bxk = kx + (n - 1) * (bw + 3)
            kv.bentuk('bulat', bxk, rt, bw, SK['kemungkinan_tinggi_pt'], f'kategori.{kat}' if aktif else 'tint.netral.muda', radius=3)
            kv.teks(bxk, rt, bw, SK['kemungkinan_tinggi_pt'], [[self.R(self.st(str(n)), self.T['kemungkinan_kelas'], 'kertas' if aktif else 'teks-3')],
                                                               [self.R(self.st(pel[str(n)]), self.T['kemungkinan_label'], 'kertas' if aktif else 'teks-3')]], rata='c', jangkar='m')
        kb = s['kebijakan']
        ky = rt + SK['kemungkinan_tinggi_pt'] + SK['jarak_kebijakan_pt']
        kv.teks(kx, ky, kw_, SK['label_tinggi_pt'], [self.R('ANGKA KEBIJAKAN', gk)], jangkar='m', bungkus=False)
        self.pil_keyakinan(kv, kx + kw_, ky + (SK['label_tinggi_pt'] - self.K['chip']['tinggi_pt']) / 2, self.K['chip']['tinggi_pt'],
                           kb.get('keyakinan', 'asumsi-kebijakan'))
        ky += SK['label_tinggi_pt'] + 2
        vals = []
        for b in (kb['sekarang'], kb['target']):
            segs = self.urai(b['nilai'], asal)
            m = next(mm for mm in reversed(self.k.manifest) if mm['naskah'] == asal)
            lo, hi = (m['rendah'], m['tinggi']) if m['rendah'] is not None else (m['nilai'], m['nilai'])
            vals.append((b, ''.join(x_[0] for x_ in segs), lo, hi, m))
        vmax = max(v[3] for v in vals)
        self.visual('grafik')
        lab_w = kw_ * SK['label_kebijakan_rasio']
        bar_w = kw_ - lab_w - SK['nilai_kebijakan_lebar_pt']
        for i, (b, teks, lo, hi, _) in enumerate(vals):
            by = ky + i * SK['batang_kebijakan_jarak_pt']
            kv.teks(kx, by, lab_w - 4, SK['batang_kebijakan_pt'], self.runs(b['label'], self.T['isi_tabel'], asal), jangkar='m')
            bx0 = kx + lab_w
            # sekarang lawan target: pembanding lawan teks-2, tanpa warna arah (B1.5), supaya tidak bentrok dengan kategori
            kv.bentuk('bulat', bx0 + bar_w * lo / vmax, by + 3, bar_w * (hi - lo) / vmax, SK['batang_kebijakan_pt'] - 6,
                      SK['warna_batang'][min(i, 1)], radius=2)
            kv.teks(bx0 + bar_w + 4, by, SK['nilai_kebijakan_lebar_pt'] - 4, SK['batang_kebijakan_pt'], [self.R(teks, self.T['nilai_tabel'])], jangkar='m', bungkus=False)
        if vals[0][3]:
            p = (vals[1][3] - vals[0][3]) / vals[0][3] * 100
            teks = (self.ui['turun'] if p < 0 else self.ui['naik']) + fmt_id(abs(p), 0) + '%'
            self.turunan('kebijakan', teks, p, asal, 'asumsi-kebijakan', vals[0][4]['sumber'], vals[1][4]['sumber'],
                         dari=(vals[0][4]['kunci'], vals[1][4]['kunci']))
            wt = self.arah(p)
            ty = ky + 2 * SK['batang_kebijakan_jarak_pt']
            rr = [self.R(teks, self.T['ubah_grafik'], wt)] + self.runs(' ' + kb['keterangan'], self.T['isi_tabel'], asal)
            kv.segitiga(kx + lab_w, ty + 4, 6, p > 0, wt)
            kv.teks(kx + lab_w + 9, ty, kw_ - lab_w - 9, 14, rr, jangkar='m', bungkus=False)
            ty += 14
        else:
            ty = ky + 2 * SK['batang_kebijakan_jarak_pt']
        if kb.get('legenda'):  # keterangan batang (mis. dua lintasan peringatan dini), satu baris di bawah angka perubahan
            r = self.runs(kb['legenda'], self.T['catatan_kaki'], asal)
            self.muat(r, kw_ - lab_w, 1, asal, 'legenda batang kebijakan')
            kv.teks(kx + lab_w, ty, kw_ - lab_w, 12, r, jangkar='m', bungkus=False)
            ty += 12
        if s.get('catatan'):  # catatan baca angka skenario, di bawah angka kebijakan dalam kontainer yang sama
            g = self.T['isi_daftar']
            ty += 6
            self.daftar(kv, kx, ty, kw_, bawah_atas - ty, s['catatan'], asal, g)
        # respons, pemulihan, lembaga
        by = bawah_atas + pad * 0.6
        kv.garis(x + pad, by, x + w - pad, by, self.K['tabel_peringkat']['warna_pemisah'], 0.75)
        for i, (lab, isi) in enumerate((('RESPONS YANG DIBUTUHKAN', s['respons']), ('KEBUTUHAN PEMULIHAN', s['pemulihan']))):
            cx = x + pad + i * (cw + pad)
            kv.teks(cx, by + 4, cw, SK['label_tinggi_pt'], [self.R(lab, gk)], jangkar='m', bungkus=False)
            self.daftar(kv, cx, by + 4 + SK['label_tinggi_pt'] + 2, cw, bawah - by - SK['label_tinggi_pt'] - 6 - self.K['jarak_isi_ke_tepi_panel_pt'], isi, asal, gd)
        cx = x + pad + 2 * (cw + pad)
        kv.teks(cx, by + 4, cw, SK['label_tinggi_pt'], [self.R('LEMBAGA', gk)], jangkar='m', bungkus=False)
        self.chip_lembaga(kv, cx, by + 6 + SK['label_tinggi_pt'], cx + cw, s['lembaga'], asal, baris_maks=3)
        self.catatan_sumber(kv, j)

    def s_lampiran_tabel(self, kv, j):
        """Tabel native lampiran: kepala bergaris 1 pt, baris bergaris 0,5 pt, tanpa garis tegak, angka rata kanan."""
        TL = self.K['tabel_lampiran']
        tb, rows = j['tabel'], j['baris']
        self.visual('tabel')
        y, x, w = self.S['area_isi_y_pt'][0], self.X0, self.W
        kol = tb['kolom']
        gk, gi = self.T['kepala_tabel_lampiran'], self.T['isi_tabel_lampiran']
        lebar = []
        for i, c in enumerate(kol):
            isi = max([self.u.lebar([self.R(r[i]['teks'], gi)]) for r in tb['baris']] + [self.u.lebar([self.R(c.get('kepala', c['nama']), gk)])])
            lebar.append(isi + 2 * TL['pad_sel_pt'] + TL['kolom_jarak_pt'])
        sisa = w - sum(lebar)
        if sisa < 0:
            raise DeckGalat(f'{j["asal"]}: tabel lampiran {sum(lebar):.0f} pt lebih lebar dari {w} pt; kurangi kolom')
        teks_i = [i for i, c in enumerate(kol) if not c.get('fmt')] or [0]
        tot = sum(lebar[i] for i in teks_i)
        for i in teks_i:  # sisa lebar dibagi ke kolom teks sebanding isinya
            lebar[i] += sisa * lebar[i] / tot
        rh = TL['baris_pt'][0]
        gf = kv.sh.add_table(len(rows) + 1, len(kol), E(x), E(y), E(w), E(TL['kepala_tinggi_pt'] + rh * len(rows)))
        t = gf.table
        tp = t._tbl.tblPr
        tp.set('firstRow', '0')
        tp.set('bandRow', '0')
        sid = tp.find(qn('a:tableStyleId'))
        if sid is None:
            sid = tp.makeelement(qn('a:tableStyleId'), {})
            tp.append(sid)
        sid.text = '{2D5ABB26-0587-4C30-8999-92F81FD0307C}'  # No Style, No Grid
        for i, lw in enumerate(lebar):
            t.columns[i].width = E(lw)
        t.rows[0].height = E(TL['kepala_tinggi_pt'])
        for r in range(1, len(rows) + 1):
            t.rows[r].height = E(rh)

        def sel(cell, runs, rata, garis_tok, tebal):
            cell.margin_left = cell.margin_right = Pt(TL['pad_sel_pt'])
            cell.margin_top = cell.margin_bottom = 0
            kv.isi_teks(cell.text_frame, [runs], rata, 'm', False)
            tc = cell._tc.get_or_add_tcPr()
            tc.set('anchor', 'ctr')
            for ch in list(tc):
                tc.remove(ch)
            for tag in ('a:lnL', 'a:lnR', 'a:lnT'):
                ln = tc.makeelement(qn(tag), {'w': '0'})
                ln.append(ln.makeelement(qn('a:noFill'), {}))
                tc.append(ln)
            ln = tc.makeelement(qn('a:lnB'), {'w': str(E(tebal))})
            sf = ln.makeelement(qn('a:solidFill'), {})
            sf.append(sf.makeelement(qn('a:srgbClr'), {'val': str(self.rgb(garis_tok))}))
            ln.append(sf)
            tc.append(ln)
            tc.append(tc.makeelement(qn('a:noFill'), {}))

        for i, c in enumerate(kol):
            sel(t.cell(0, i), [self.R(c.get('kepala', c['nama']).upper(), gk)], 'c', TL['warna_garis_kepala'], TL['tebal_kepala_pt'])  # kepala rata tengah (pemilik 26 Okt)
        for r, row in enumerate(rows, start=1):
            for i, c in enumerate(kol):
                g = dict(gi, bobot='bold') if i == 0 else gi
                sel(t.cell(r, i), [self.R(row[i]['teks'], g)], 'r' if c.get('fmt') else 'l', TL['warna_garis_baris'], TL['tebal_baris_pt'])
        self.catatan_sumber(kv, j, [tb['sumber']], keyakinan=tb['keyakinan'])

