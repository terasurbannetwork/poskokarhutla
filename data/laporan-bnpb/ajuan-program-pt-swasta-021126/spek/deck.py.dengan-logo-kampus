            self.pil(kv, x, ty, [self.R(self.st(teks_tgl), g)], TG['tinggi_pt'], Wn['warna_tanggal_isi'], w=TG['lebar_pt'])

    def s_impor(self, kv, j):
        """Slide isi dari generator laporan (harian, penanganan, paparan wilayah) masuk utuh; deck.py memasang garis kaki,
        pita kaki navy, (c) lembaga, nomor halaman, dan baris sumber (pemilik 31 Okt 2026: "kalo bentuknya ppt semuanya
        harus pasti ke deck.py"). Spek: {"jenis": "impor", "pptx": "<berkas>", "halaman": <nomor slide di berkas itu>,
        "sumber": "<opsional; tanpa ini catatan '*...' atau 'Sumber: ...' di atas garis kaki lama dipindah ke pita>"}."""
        sp = j['spek']
        src = Path(sp['pptx']).expanduser()
        if not src.is_absolute():
            src = self.akar / src
        if not src.exists():
            raise DeckGalat(f"{j['asal']}: impor {src} tidak ada")
        self.masukan.add(src.resolve())
        cache = self.__dict__.setdefault('_impor', {})
        if src not in cache:
            cache[src] = Presentation(str(src))
        P = cache[src]
        if (P.slide_width, P.slide_height) != (self.prs.slide_width, self.prs.slide_height):
            raise DeckGalat(f"{j['asal']}: ukuran slide {src.name} beda dengan templat deck")
        n = sp.get('halaman')
        if not isinstance(n, int) or not 1 <= n <= len(P.slides):
            raise DeckGalat(f"{j['asal']}: impor halaman {n!r} di luar 1..{len(P.slides)} ({src.name})")
        catatan = salin_slide(P.slides[n - 1], kv.sh, self.prs.part.package, Pt(self.S['garis']['y_pt'][-1]))
        # warna generator di luar palet tema diganti warna palet terdekat (jarak RGB berbobot), dicatat di manifest
        if not hasattr(self, '_palet_hex'):
            w_ = dict(self.t['warna']); w_.pop('terlarang', None)
            self._palet_hex = sorted({h[1:].upper() for h in re.findall(r'#[0-9A-Fa-f]{6}', json.dumps(w_))})
        def dekat(hx):
            r, g, b = (int(hx[i:i + 2], 16) for i in (0, 2, 4))
            return min(self._palet_hex, key=lambda p_: 2 * (r - int(p_[0:2], 16)) ** 2 + 4 * (g - int(p_[2:4], 16)) ** 2 + 3 * (b - int(p_[4:6], 16)) ** 2)
        ganti = {}
        for el in kv.sh._spTree.iter(qn('a:srgbClr')):
            hx = el.get('val', '').upper()
            if hx and hx not in self._palet_hex:
                ganti.setdefault(hx, dekat(hx))
                el.set('val', ganti[hx])
        if ganti:
            self.catatan.append((j['asal'], 'impor_warna', ganti))
        if self.hal is not None:   # warna isi generator: peran "impor" (D-24); hex di luar tema tetap ditolak D-9
            for hx in set(re.findall(r'srgbClr val="([0-9A-Fa-f]{6})"', kv.sh._spTree.xml)):
                self.hal['warna'].add((hx.upper(), 'impor'))
        gy = self.S['garis']['y_pt'][-1]
        gs = self.S['garis']
        kv.garis(self.X0, gy, self.X1, gy, gs['warna'], gs['tebal_pt'])
        self.footer(kv, j['nomor'])
        if self.hal is not None:
            # angka slide generator: dicatat di manifest dengan sumber datanya (D-22), bukan dianggap ketikan
            sd = sp.get('sumber_data') or sp.get('sumber') or catatan or f"Generator laporan {self.spek.get('format', 'BNPB')}, data Pantau Bencana BNPB"
            for k_, t in enumerate(kv.sh._spTree.iter(qn('a:t'))):
                for m in re.finditer(r'\d[\d.,]*', t.text or ''):
                    self.turunan(f'impor{k_}.{m.start()}', m[0], None, j['asal'], sp.get('keyakinan', 'resmi'), sd)
            # gambar slide generator (S37): peta untuk gambar lebar, ikon untuk yang kecil
            for pic in kv.sh._spTree.iter(qn('p:pic')):
                ext = pic.find('.//' + qn('a:ext'))
                self.hal.setdefault('gambar', []).append('peta' if ext is not None and int(ext.get('cx')) > Pt(150) else 'ikon')
        teks = sp.get('sumber') or catatan
        if teks:
            self.catatan_sumber(kv, dict(j, spek=dict(sp, sumber=teks)))
        if j.get('bagian'):
            self.penanda(kv, j['bagian'], j['asal'])

    def s_pembatas_lampiran(self, kv, j):
        sp, PB = j['spek'], self.K['pembatas']
        self.logo_bulat(kv, PB['logo'], alas=self.gelap(j))
        kv.teks(self.X0, PB['judul_y_pt'], 600, PB['judul_tinggi_pt'], [self.R(sp.get('teks', 'Lampiran'), self.T['judul_pembatas'])], jangkar='b', bungkus=False)
        if sp.get('subjudul'):
            r = self.runs(sp['subjudul'], self.T['subjudul_pembatas'], j['asal'])
            kv.teks(self.X0, PB['subjudul_y_pt'], 720, PB['subjudul_tinggi_pt'], r, jangkar='m', bungkus=False)
        kv.garis(self.X0, PB['garis_y_pt'], self.X1, PB['garis_y_pt'], PB['warna_garis'], 0.75)
        kel = {}
        for lj in j['lampiran']:
            kel.setdefault(lj['kode'][0], []).append(lj)
        if len(kel) > len(PB['kolom_x_pt']):
            raise DeckGalat(f'{j["asal"]}: {len(kel)} kelompok lampiran > {len(PB["kolom_x_pt"])} kolom pembatas')
        gb = self.T['butir_pembatas']
        for (huruf, isi), kx in zip(kel.items(), PB['kolom_x_pt']):
            judul = sp.get('kelompok', {}).get(huruf)
            if not judul:
                raise DeckGalat(f'{j["asal"]}: kelompok lampiran {huruf} tanpa judul di "kelompok"')
            kv.teks(kx, PB['kelompok_y_pt'], PB['kolom_lebar_pt'], PB['kelompok_tinggi_pt'],
                    self.runs(f'{huruf}, {judul}', self.T['kelompok_pembatas'], j['asal']), jangkar='m', bungkus=False)
            for i, lj in enumerate(isi):
                hal = self.st(str(lj['halaman'][0]) if len(lj['halaman']) == 1 else f'{lj["halaman"][0]}–{lj["halaman"][-1]}')
                r = ([self.R(lj['kode'], gb, gb['warna_kode'], True), self.R('   ', gb)] + self.runs(lj['judul_daftar'], gb, j['asal'])
                     + [self.R('   ' + hal, gb, gb['warna_halaman'])])
                self.muat(r, PB['kolom_lebar_pt'], 1, j['asal'], 'butir pembatas')
                kv.teks(kx, PB['kelompok_y_pt'] + PB['kelompok_tinggi_pt'] + i * PB['baris_pt'], PB['kolom_lebar_pt'], PB['baris_pt'], r, jangkar='m', bungkus=False)
        gs = self.S['garis']   # pembatas terang berkaki: garis kerangka y95 dan y507,6 seperti slide isi (gerbang T-6)
        for gy in gs['y_pt']:
            kv.garis(self.X0, gy, self.X1, gy, gs['warna'], gs['tebal_pt'])
        self.footer(kv, j['nomor'])

    def s_daftar_isi(self, kv, j, aktif=None):
        """Daftar isi berlatar terang: panel kiri tint netral berjudul besar, kanan baris bernomor 01, 02, ... dengan halaman.
        aktif (pembatas seksi): baris bagian itu disorot tint api, bilah oranye, nomor oranye; baris lain abu (pola agenda
        berulang MBB; pemilik 26 Okt 2026: daftar isi, pembatas per bagian, penanda posisi)."""
        sp, asal = j['spek'], j['asal']
        if not self.bagian:
            raise DeckGalat(f'{asal}: {j["jenis"]} tanpa "bagian" di spek')
        H, pw = self.S['tinggi_pt'], 300
        kv.bentuk('kotak', 0, 0, pw, H, 'tint.netral.muda')
        gb = self.gaya_bingkai()
        ps = self.spek.get('panel_sisi')   # "gelap" atau "terang": panel kiri berfoto (pemilik 31 Okt, dua opsi)
        f0 = self.foto_sampul_deck()
        f0 = f0[0] if isinstance(f0, list) else f0
        gelap_ = ps == 'gelap' and bool(f0)
        if ps and f0:
            if ps == 'gelap':   # foto memenuhi panel, gradien navy pekat di atas (tempat teks) menipis ke bawah
                kv.gambar(self.potong_foto(f0, pw, H), 0, 0, pw, H, 'foto')
                ov = kv.bentuk('kotak', 0, 0, pw, H, 'navy')
                hx = self.catat_warna('navy')[1].lstrip('#').upper()
                isi = ov._element.spPr.find(qn('a:solidFill'))
                isi.getparent().replace(isi, parse_xml(
                    f'<a:gradFill {nsdecls("a")} rotWithShape="1"><a:gsLst>'
                    f'<a:gs pos="0"><a:srgbClr val="{hx}"><a:alpha val="94000"/></a:srgbClr></a:gs>'
                    f'<a:gs pos="58000"><a:srgbClr val="{hx}"><a:alpha val="84000"/></a:srgbClr></a:gs>'
                    f'<a:gs pos="100000"><a:srgbClr val="{hx}"><a:alpha val="22000"/></a:srgbClr></a:gs>'
                    f'</a:gsLst><a:lin ang="5400000" scaled="0"/></a:gradFill>'))
                ov.name = 'Gradien panel'
            else:   # terang: foto di dasar panel memudar ke atas ke panel abu muda
                kv.gambar(self.foto_alfa(f0, pw, 250, 'panel-terang', 'y', 0.0, 0.6), 0, H - 250, pw, 250, 'foto')
            if not self.supergrafis():
                self.kotak_tersebar(kv, pw)   # tiga gugus kotak di tiga tempat
            gb = None   # hiasan panel lain tidak dipakai: dasar panel sudah berfoto
        if self.supergrafis() == 'busur':   # Busur Perisai di sudut kiri bawah panel (Pedoman Identitas Visual 8.4)
            self.busur_perisai(kv, 0, H, H * .30, 'kib', 'foto' if (ps and f0) else 'polos')   # foto atau gelap: B; polos: A
            gb = None
        if gb == 'tumpuk' and self.elemen_deck() not in ('kotak', 'arus', None, ''):
            self.hias_bingkai(kv, 'panel')
        if gb == 'mozaik' or (gb == 'tumpuk' and self.elemen_deck() == 'kotak'):   # gugus kotak elemen grafis (pola Contents PwC)
            self.mozaik(kv, [], [], [(self.X0, H - 42, 42, 'oranye'), (self.X0 + 42, H - 70, 28, 'skala.netral.2'),
                                     (self.X0 + 70, H - 88, 18, 'navy')])   # sudut ke sudut
            self.kotak_tersebar(kv, pw)
        if gb == 'tumpuk' and self.elemen_deck() == 'arus':   # Arus Ketangguhan di sambungan panel kiri dan daftar
            self.pita_arus(kv, [(318, -30), (286, 90), (322, 210), (284, 330), (318, 450), (296, 575)], n=3, lebar=6.0, celah=4.5, runcing=0.06)
        if gb == 'tipografi':
            self.segitiga_garis(kv, 150, 400, 170, 150, 'oranye', 1.25)
        if gb in ('penuh', 'tumpuk') and self.foto_sampul_deck() and gb != 'mozaik' and not (gb == 'tumpuk' and self.elemen_deck()):   # foto sampul di dasar panel, memudar ke atas (mozaik memakai kotak, bukan foto)
            f0 = self.foto_sampul_deck()
            f0 = f0[0] if isinstance(f0, list) else f0
            kv.gambar(self.foto_alfa(f0, pw, 190, 'panel', 'y', 0.0, 0.55), 0, H - 190, pw, 190, 'foto')
        elif gb == 'kartu':
            kv.bentuk('segitiga', self.X0, H - 60, 30, 26, 'oranye')
        if self.motif() == 'arus':   # kipas yang sama dengan sampul, kecil di dasar panel kiri: satu keluarga bingkai
            self.garis_arus(kv, 0, H * 0.70, pw, H * 0.30, n=30, tebal=0.5, cermin=True)
        lg = self.S['logo']
        if gelap_:   # logo berlatar lingkaran putih supaya terbaca di atas gradien navy
            self.logo_bulat(kv, dict(self.K['penutup']['logo'], y_pt=24, d_pt=64))
        else:
            kv.gambar(self.logo, self.X0, lg['y_pt'], lg['lebar_pt'], lg['tinggi_pt'])
        wj_, ws_ = ('kertas', 'teks-di-navy') if gelap_ else ('navy', 'teks-2')
        lw = pw - 2 * self.X0
        if aktif:  # pembatas: nomor bagian besar dan judulnya, supaya tidak tertukar dengan daftar isi
            kv.teks(self.X0, 156, lw, 86, [self.R(self.st(f'{aktif:02d}'), self.T['judul_temuan'], 'kertas' if gelap_ else 'oranye', True, 80)], jangkar='m', bungkus=False)   # panel gelap: angka putih (pemilik 31 Okt)
            kv.bentuk('kotak', self.X0, 250, 56, 3, 'oranye')
            r = self.runs(self.bagian[aktif - 1]['judul'], dict(self.T['judul_temuan'], warna=wj_), asal, ukuran=20, tebal=True)
            self.muat(r, lw, 4, asal, 'judul bagian di pembatas')
            kv.teks(self.X0, 264, lw, 110, r, jangkar='t')
        else:
            jd = sp.get('teks', self.ui.get('daftar_isi', 'Daftar Isi'))
            kv.teks(self.X0, 190, lw, 60, [self.R(jd, dict(self.T['judul_temuan'], warna=wj_), ukuran=36, tebal=True)], jangkar='b', bungkus=False)
            kv.bentuk('kotak', self.X0, 262, 56, 3, 'oranye')
            r = [self.R(self.st(self.spek.get('judul_dokumen') or self.kaj['judul']), dict(self.T['isi_panel'], warna=ws_), ukuran=11)]
            self.muat(r, lw, 4, asal, 'judul kajian di daftar isi')
            kv.teks(self.X0, 276, lw, 70, r, jangkar='t')
        n = len(self.bagian)
        x, x1 = pw + 40, self.X1
        rh = min(74, 400 / n)
        y0 = (H - rh * n) / 2
        for i, b in enumerate(self.bagian, 1):
            y, on = y0 + (i - 1) * rh, aktif == i
            redup = aktif is not None and not on
            if on:
                kv.bentuk('kotak', x - 16, y + 4, x1 - x + 16, rh - 8, 'tint.api.muda')
                kv.bentuk('kotak', x - 16, y + 4, 4, rh - 8, 'oranye')
            wn = 'garis' if redup else ('oranye' if on or aktif is None else 'navy')
            kv.teks(x, y, 70, rh, [self.R(self.st(f'{i:02d}'), self.T['judul_temuan'], wn, True, 30)], jangkar='m', bungkus=False)
            hl = b['halaman']
            hal = self.st(f'{hl[0]}' if len(hl) == 1 else f'{hl[0]}–{hl[-1]}')
            # halaman: pil seragam lebar sama, rata kanan lurus ke bawah (pemilik 26 Okt: tanpa "hlm")
            gh = dict(self.T['isi_panel'], warna='kertas' if on or aktif is None else 'teks-2')
            px = x1 - 16 - 60  # pil halaman berjarak 16 pt dari tepi kanan sorotan, tidak menempel (pemilik 26 Okt)
            kv.bentuk('bulat', px, y + rh / 2 - 11, 60, 22, 'navy' if on or aktif is None else 'tint.netral.pita', radius=11)
            kv.teks(px, y + rh / 2 - 11, 60, 22, [self.R(hal, gh, ukuran=12, tebal=True)], rata='c', jangkar='m', bungkus=False)
            rt = self.runs(b['judul'], dict(self.T['isi_panel'], warna='teks-3' if redup else 'teks'), asal, ukuran=19, tebal=not redup)
            self.muat(rt, x1 - x - 150, 2, asal, f'judul bagian {i} di daftar isi')
            kv.teks(x + 62, y, x1 - x - 150, rh, rt, jangkar='m')
            if i < n:
                kv.garis(x, y + rh, x1, y + rh, 'garis', 0.75)
        F, B = self.S['footer'], self.K['bingkai']  # halaman navigasi: nomor saja, tanpa teks kaki dan garis kerangka (pola sampul)
        kv.teks(self.X1 - B['nomor_lebar_pt'], F['y_pt'], B['nomor_lebar_pt'], B['footer_tinggi_pt'],
                [self.R(self.st(str(j['nomor'])), self.T['nomor_halaman'])], rata='r', bungkus=False)

    def s_pembatas_seksi(self, kv, j):
        self.s_daftar_isi(kv, j, aktif=j['spek']['bagian'])

    def s_temuan(self, kv, j):
        """kartu-angka, temuan-grafik, temuan-peta, tabel-peringkat: [grup kartu] + utama [+ panel samping] + [pita bawah]."""
        sp, asal = j['spek'], j['asal']
        if sp.get('skala_huruf'):  # halaman berbahan sedikit: huruf temuan dan tesis diperbesar (pemilik 26 Okt, batas 5%)
            asli = {k: self.T[k] for k in ('temuan_isi', 'tesis')}
            try:
                for k, g0 in asli.items():
                    self.T[k] = dict(g0, ukuran_pt=pt_dari(g0) * sp['skala_huruf'])
                return self.s_temuan(kv, dict(j, spek=dict(sp, skala_huruf=None)))
            finally:
                self.T.update(asli)
        jarak = self.K['bingkai']['jarak_blok_pt']
        y = self.S['area_isi_y_pt'][0]
        if sp.get('grup'):
            y = self.grup_kartu(kv, sp['grup'], y, asal) + jarak
        bawah = self.bawah(sp.get('sumber') is not False)
        if sp.get('pita'):
            h = self.K['pita_bawah']['tinggi_baku_pt'] * sp['pita'].get('skala', 1)
            self.pita(kv, self.X0, bawah - h, self.W, sp['pita'], asal)
            bawah -= h + jarak
        samping = sp.get('panel')
        uw = self.W * sp.get('rasio', self.K['bingkai']['rasio_utama']) if samping else self.W
        tambah = []
        jenis = j['jenis']
        ux, kiri = self.X0, []
        if samping and sp.get('panel_kiri'):  # panel pertama di kiri tabel utama (pemilik 26 Okt: histori paling kiri)
            dp = samping if isinstance(samping, list) else [samping]
            pw0 = (self.W - uw - jarak * len(dp)) / len(dp)
            kiri, samping = dp[:1], dp[1:] or None
            ux = self.X0 + pw0 + jarak
            for p_ in kiri:
                tambah += self.panel_isi(kv, self.X0, y, pw0, bawah - y, p_, asal)
        if jenis == 'temuan-peta':
            fb = sp.get('foto_bawah')   # deret citra selebar slide di bawah peta dan panel (pemilik 27 Okt: sebelum terbakar, terbakar, jadi sawit)
            if fb:
                self.kisi_foto(kv, self.X0, bawah - fb['tinggi_pt'], self.W, fb['tinggi_pt'], fb['foto'], fb.get('kolom', len(fb['foto'])), asal, fb.get('ket_baris', 1))
                bawah -= fb['tinggi_pt'] + jarak
            tambah.append(self.peta(kv, self.X0, y, uw - jarak, bawah - y, sp['peta'], asal)['sumber'])
        elif jenis == 'temuan-visual':   # panel utama berisi corong, progres, atau tumpuk (pemilik 30 Okt)
            if sp.get('susun') == 'vertikal':
                tambah += self.susun_vertikal(kv, ux, y, uw, bawah - y, sp, asal)
            else:
                tambah += self.panel_isi(kv, ux, y, uw, bawah - y, sp['utama'], asal)
        elif jenis == 'kartu-angka':
            if sp.get('temuan'):  # halaman Pesan Kunci (B5.26): kalimat tesis navy, lalu temuan bernomor
                if not sp.get('tesis'):
                    raise DeckGalat(f'{asal}: halaman Pesan Kunci tanpa "tesis" (PEDOMAN B5.26: kalimat tesis 12 pt navy)')
                TM = self.K['temuan']
                bx, by, bw, bh = self.panel(kv, self.X0, y, uw, bawah - y, sp.get('judul_panel', 'Pesan kunci'), 'ringkasan', asal=asal)
                rt = self.runs(sp['tesis'], self.T['tesis'], asal)
                th = self.muat(rt, bw, TM['tesis_maks_baris'], asal, 'tesis') * pt_dari(self.T['tesis']) * TM['tinggi_baris']
                kv.teks(bx, by, bw, th, rt, rata='j' if th > pt_dari(self.T['tesis']) * TM['tinggi_baris'] * 1.5 else 'l')  # 2-3 baris rata kanan-kiri
                kv.garis(bx, by + th + TM['tesis_jarak_pt'] / 2, bx + bw, by + th + TM['tesis_jarak_pt'] / 2, TM['warna_pemisah'], 0.5)
                self.daftar_temuan(kv, bx, by + th + TM['tesis_jarak_pt'], bw, bh - th - TM['tesis_jarak_pt'], sp['temuan'], asal,
                                   kolom=sp.get('kolom', 2))
        else:
            utama = sp['grafik'] if jenis == 'temuan-grafik' else sp['tabel']
            kyk = utama['data']['keyakinan']
            bx = self.panel(kv, ux, y, uw, bawah - y, utama['judul_panel'], utama.get('ikon', 'data'),
                            utama.get('nada', 'netral'), utama.get('hitungan'), kyk, asal)
            if jenis == 'temuan-grafik':
                self.hal['panel'][-1].append('grafik')  # D-40: ruang di atas batang pendek adalah encoding, batasnya lebih longgar
                bx = self.eksibit(kv, *bx, dict(utama, judul=utama['judul_panel']), asal)
                self.hal.setdefault('terisi', []).append([round(v_, 1) for v_ in bx])   # putaran 5f (CELAH-2 butir 3): bidang plot (juga batang horizontal) terisi untuk D-39
                tb = self.grafik_batang(kv, *bx, utama, asal)
            else:
                tb = self.data(utama['data'], asal)
                for k_ in ('baris_maks_pt', 'skala_huruf', 'sel_dua_baris'):
                    if k_ in utama:
                        tb[k_] = utama[k_]
                self.peringkat(kv, *bx, tb, asal, utama.get('peringkat', True), utama.get('total', False), utama.get('ikon_baris'))
            tambah.append(tb['sumber'])
        if samping:
            sx = ux + uw + (0 if jenis == 'temuan-peta' else jarak)
            daftar_p = samping if isinstance(samping, list) else [samping]  # beberapa panel berdampingan, satu topik satu kontainer
            pw = (self.X1 - sx - jarak * (len(daftar_p) - 1)) / len(daftar_p)
            for n, p_ in enumerate(daftar_p):
                tambah += self.panel_isi(kv, sx + n * (pw + jarak), y, pw, bawah - y, p_, asal)
        self.catatan_sumber(kv, j, tambah)

    def susun_vertikal(self, kv, x, y, w, h, sp, asal):
        """Putaran 5f: `susun: "vertikal"` pada temuan-visual. `utama` = daftar tepat dua panel (tiap panel seperti panel biasa,
        `tanpa_kepala: true` membuang kepala panelnya), ditumpuk atas-bawah dengan `tinggi` = [0.6, 0.4] (jumlah 1, tiap bagian >= 0,2)."""
        ut = sp['utama']
        if not (isinstance(ut, list) and len(ut) == 2 and all(isinstance(q, dict) for q in ut)):
            raise DeckGalat(f'{asal}: susun "vertikal" butuh "utama" berupa daftar tepat dua panel')
        r = sp.get('tinggi', [0.6, 0.4])
        if not (isinstance(r, list) and len(r) == 2 and abs(sum(r) - 1) < 0.011 and min(r) >= 0.2):
            raise DeckGalat(f'{asal}: "tinggi" {r} harus dua pecahan berjumlah 1, tiap bagian paling sedikit 0,2 (bawaan [0.6, 0.4])')
        jarak = self.K['bingkai']['jarak_blok_pt']
        ha = (h - jarak) * r[0] / sum(r)
        return (self.panel_isi(kv, x, y, w, ha, ut[0], asal)
                + self.panel_isi(kv, x, y + ha + jarak, w, h - ha - jarak, ut[1], asal))

    def s_bebas(self, kv, j):
        """Jenis `bebas` (putaran 5f): tanpa kerangka panel (tanpa kepala panel, tanpa garis bawah kepala), tetap berkepala slide
        BNPB (judul, logo, garis, kaki) kecuali `tanpa_kepala_slide: true` (jenis internal bebas-polos, hanya dengan `pembatas: true`;
        kotak = seluruh slide). `modul` = daftar kotak {x, y, w, h (pecahan area isi), <isi seperti panel: corong, waterfall, modul
        visual, grafik, data, daftar, foto, temuan>}. Kotak tidak boleh keluar area atau saling menumpuk."""
        sp, asal = j['spek'], j['asal']
        polos = j['jenis'] == 'bebas-polos'
        mods = sp.get('modul')
        if not (isinstance(mods, list) and mods):
            raise DeckGalat(f'{asal}: bebas butuh "modul": daftar kotak {{"x", "y", "w", "h" (pecahan area isi), "<visual>": {{...}}}}')
        if polos:
            x0, y0, W_, H_ = 0.0, 0.0, self.S['lebar_pt'], self.S['tinggi_pt']
        else:
            x0, y0 = self.X0, self.S['area_isi_y_pt'][0]
            W_, H_ = self.W, self.bawah(sp.get('sumber') is not False) - y0
        kotak, tambah = [], []
        for i, m in enumerate(mods, 1):
            try:
                fx, fy, fw, fh = (float(m[k]) for k in ('x', 'y', 'w', 'h'))
            except (KeyError, TypeError, ValueError):
                raise DeckGalat(f'{asal}: modul {i} tanpa x, y, w, h berupa pecahan area isi')
            if fw < 0.05 or fh < 0.05 or fx < -1e-6 or fy < -1e-6 or fx + fw > 1.0001 or fy + fh > 1.0001:
                raise DeckGalat(f'{asal}: modul {i} kotak ({fx}, {fy}, {fw}, {fh}) keluar dari area isi (0 sampai 1) atau lebih kecil dari 0,05')
            for q in kotak:
                if min(fx + fw, q[0] + q[2]) - max(fx, q[0]) > 0.002 and min(fy + fh, q[1] + q[3]) - max(fy, q[1]) > 0.002:
                    raise DeckGalat(f'{asal}: modul {i} menumpuk modul lain; atur x, y, w, h agar kotak terpisah')
            kotak.append((fx, fy, fw, fh))
            isi = {k: v for k, v in m.items() if k not in ('x', 'y', 'w', 'h')}
            if not any(k in isi for k in ('data', 'grafik', 'foto', 'temuan', 'daftar') + self.VISUAL_PANEL):
                raise DeckGalat(f'{asal}: modul {i} tanpa isi (data, grafik, daftar, foto, temuan, atau salah satu visual)')
            tambah += self.panel_isi(kv, x0 + fx * W_, y0 + fy * H_, fw * W_, fh * H_, dict(isi, tanpa_kepala=True), asal)
        if not polos and (not self.pembatas(sp) or sp.get('sumber')):
            self.catatan_sumber(kv, j, tambah)

    def foto_lapisan(self, berkas, W, H, sisi, lebar, alfa, warna_tok, nama):
        """Foto dipotong tengah ke W x H pt, diberi lapisan terang (warna_tok, opasitas alfa) di sisi teks sebesar `lebar` slide yang
        pudar halus ke foto. Lapisan dipanggang ke gambar supaya kontras terukur. Kembalikan (jalur, luminans relatif piksel
        tergelap persentil 2 di zona teks)."""
        from PIL import Image
        src = (self.akar / berkas).resolve()
        if not src.exists():
            raise DeckGalat(f'foto {berkas} tidak ada')
        self.masukan.add(src)
        sk = self.K['foto']['skala_px_per_pt']
        pw, ph = int(W * sk), int(H * sk)
        im = Image.open(src).convert('RGB')
        r, (iw, ih) = pw / ph, im.size
        if iw / ih > r:
            cw = int(ih * r)
            im = im.crop(((iw - cw) // 2, 0, (iw - cw) // 2 + cw, ih))
        else:
            ch = int(iw / r)
            im = im.crop((0, (ih - ch) // 2, iw, (ih - ch) // 2 + ch))
        im = im.resize((pw, ph))
        halus = lambda t: (lambda u: u * u * (3 - 2 * u))(min(1.0, max(0.0, t)))
        nilai = []
        for xk in range(pw):
            f = xk / pw
            d = (lebar - f) if sisi == 'kiri' else (f - (1 - lebar))   # >= 0 di dalam zona teks
            nilai.append(int(round(255 * (alfa if d >= 0 else alfa * (1 - halus(-d / 0.16))))))
        m = Image.new('L', (pw, 1))
        m.putdata(nilai)
        hx = warna(self.t, warna_tok).lstrip('#')
        hasil = Image.composite(Image.new('RGB', (pw, ph), tuple(int(hx[i:i + 2], 16) for i in (0, 2, 4))), im, m.resize((pw, ph)))
        zx = (0, int(lebar * pw)) if sisi == 'kiri' else (pw - int(lebar * pw), pw)
        kecil = hasil.crop((zx[0], 0, zx[1], ph)).resize((192, 108), Image.BOX)
        lum = sorted(self.luminans(px) for px in (kecil.get_flattened_data() if hasattr(kecil, 'get_flattened_data') else kecil.getdata()))
        out = self.keluaran / 'foto' / f'{self.nama}-{nama}-penuh-{src.stem}-{sisi}.jpg'
        out.parent.mkdir(parents=True, exist_ok=True)
        hasil.save(out, quality=92)
        return out, lum[int(len(lum) * 0.02)]

    @staticmethod
    def luminans(rgb):
        """Luminans relatif WCAG 2.x dari (r, g, b) 0-255."""
        c = [(v / 255 / 12.92) if v / 255 <= 0.03928 else ((v / 255 + 0.055) / 1.055) ** 2.4 for v in rgb[:3]]
        return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2]

    def s_foto_penuh(self, kv, j):
        """Jenis `foto-penuh` (putaran 5f; pembatas atau pembuka bab): foto tepi ke tepi, latar terang. Lapisan terang transparan
        (`lapisan_warna` token, bawaan kertas; `lapisan` 0,5-1,0) di sisi teks (`sisi_teks` kiri|kanan, `lebar_teks` 0,3-0,65).
        Teks gelap diukur: kontras WCAG >= 4,5 terhadap piksel tergelap zona teks (persentil 2), kalau kurang slide ditolak.
        Isi: `bab` (nomor bab, angka biasa), `judul` (wajib), `subjudul`, `angka_besar` {teks (wajib token angka), ket} + `sumber`,
        `kutipan` {teks, sumber (wajib)}, kredit foto wajib (spek `kredit` atau kredit.json)."""
        sp, asal = j['spek'], j['asal']
        W, H = self.S['lebar_pt'], self.S['tinggi_pt']
        for k in ('foto', 'judul'):
            if not sp.get(k):
                raise DeckGalat(f'{asal}: foto-penuh tanpa "{k}"')
        sisi, lebar, alfa = sp.get('sisi_teks', 'kiri'), sp.get('lebar_teks', 0.5), sp.get('lapisan', 0.9)
        if sisi not in ('kiri', 'kanan') or not 0.3 <= lebar <= 0.65 or not 0.5 <= alfa <= 1.0:
            raise DeckGalat(f'{asal}: foto-penuh sisi_teks "{sisi}" harus kiri atau kanan, lebar_teks {lebar} antara 0,3 dan 0,65, lapisan {alfa} antara 0,5 dan 1')
        kutip, ab = sp.get('kutipan'), sp.get('angka_besar')
        if kutip is not None and not (isinstance(kutip, dict) and kutip.get('teks') and kutip.get('sumber')):
            raise DeckGalat(f'{asal}: kutipan wajib {{"teks", "sumber"}} (kutipan tanpa sumber ditolak)')
        if ab is not None:
            if not (isinstance(ab, dict) and '{{angka:' in str(ab.get('teks', ''))):
                raise DeckGalat(f'{asal}: angka_besar wajib {{"teks": "{{{{angka:kunci}}}}", "ket"}}; angka data berasal dari registri, bukan ketikan')
            if not sp.get('sumber'):
                raise DeckGalat(f'{asal}: foto-penuh berangka besar wajib "sumber" (D-45)')
        kred = self.kredit(sp['foto'], sp, asal)
        jalur, bg = self.foto_lapisan(sp['foto'], W, H, sisi, lebar, alfa, sp.get('lapisan_warna', 'kertas'), 'fp')
        pakai = ['navy', 'teks-2'] + (['teks'] if kutip else [])
        rasio = {t: (bg + 0.05) / (self.luminans(tuple(int(warna(self.t, t).lstrip('#')[i:i + 2], 16) for i in (0, 2, 4))) + 0.05) for t in pakai}
        mn = min(rasio.values())
        if mn < 4.5:
            raise DeckGalat(f'{asal}: kontras teks di atas foto {mn:.2f}:1 < 4,5 (WCAG AA; piksel tergelap zona teks {bg:.3f}); '
                            f'naikkan "lapisan" (sekarang {alfa}), perlebar "lebar_teks", atau pilih foto yang lebih terang')
        self.hal['kontras'] = round(mn, 2)
        kv.gambar(jalur, 0, 0, W, H, 'foto')
        tx = 48 if sisi == 'kiri' else W - lebar * W + 28
        tw = lebar * W - 48 - 28
        lg = self.S['logo']
        kv.gambar(self.logo, tx, 26, lg['lebar_pt'], lg['tinggi_pt'])
        gb, y, ybawah = self.T['judul_pembatas'], 112.0, H - 40
        if sp.get('bab'):
            rb = self.runs(sp['bab'], dict(gb, ukuran_pt=54), asal)
            self.muat(rb, tw, 1, asal, 'bab foto-penuh')
            kv.teks(tx, y, tw, 62, rb, jangkar='b', bungkus=False)
            y += 68
            kv.bentuk('kotak', tx, y, 40, 3, 'oranye')
            y += 14
        rj = self.runs(sp['judul'], gb, asal)
        uk = pt_dari(gb)
        while self.u.baris([[(r[0], r[1], r[2], uk, r[4]) for r in rj]], tw) > 3 and uk > 26:
            uk -= 1
        rj = [(r[0], r[1], r[2], uk, r[4]) for r in rj]
        nj = self.muat(rj, tw, 3, asal, 'judul foto-penuh')
        hj = nj * uk * 1.25
        kv.teks(tx, y, tw, hj + 4, rj, jangkar='t')
        y += hj + 12
        if sp.get('subjudul'):
            rs = self.runs(sp['subjudul'], self.T['subjudul_pembatas'], asal)
            ns = self.muat(rs, tw, 2, asal, 'subjudul foto-penuh')
            kv.teks(tx, y, tw, ns * 20 + 2, rs, jangkar='t')
            y += ns * 20 + 12
        if ab:
            ra = self.runs(ab['teks'], dict(gb, ukuran_pt=64), asal)
            self.muat(ra, tw, 1, asal, 'angka besar foto-penuh')
            kv.teks(tx, y, tw, 80, ra, jangkar='m', bungkus=False)
            y += 80
            if ab.get('ket'):
                rk = self.runs(ab['ket'], dict(self.T['subjudul_pembatas'], ukuran_pt=11), asal)
                nk = self.muat(rk, tw, 2, asal, 'keterangan angka besar')
                kv.teks(tx, y, tw, nk * 15, rk, jangkar='t')
                y += nk * 15 + 4
            gc = dict(self.T['catatan_kaki'], warna='teks-2')
            kv.teks(tx, y, tw, 12, [self.R(self.ui['sumber'], gc, tebal=True)] + self.runs(sp['sumber'], gc, asal), jangkar='m')
            self.hal['sumber_tampil'] = True
            y += 16
        if kutip:
            gq = dict(self.T['subjudul_pembatas'], ukuran_pt=14, warna='teks')
            rq = self.runs(kutip['teks'], gq, asal)
            nq = self.u.baris([rq], tw - 14)
            hq = nq * 14 * 1.3 + 4 + 14
            yq = ybawah - hq
            if yq < y + 6:
                raise DeckGalat(f'{asal}: foto-penuh kutipan tidak muat di bawah judul ({y:.0f} pt terpakai, kutipan butuh {hq:.0f} pt); pendekkan kutipan atau judul')
            kv.bentuk('kotak', tx, yq, 3, hq - 2, 'oranye')
            kv.teks(tx + 12, yq, tw - 14, nq * 14 * 1.3 + 4, rq, jangkar='t')
            kv.teks(tx + 12, yq + hq - 14, tw - 14, 12, self.runs(kutip['sumber'], dict(self.T['catatan_kaki'], warna='teks-2'), asal), jangkar='m')
        elif y > ybawah:
            raise DeckGalat(f'{asal}: foto-penuh isi melewati tepi bawah ({y:.0f} pt); pendekkan judul atau subjudul')
        kv.teks(tx, H - 28, tw, 12, [self.R(self.st(kred), dict(self.T['kredit_foto'], warna='teks-2', ukuran_pt=7))], bungkus=False, jangkar='m')

    def potong_foto(self, berkas, w_pt, h_pt, klip=None):
        """Foto dokumentasi dipotong tengah ke rasio bidang, tanpa gradasi.
        klip [kiri, kanan, atas, bawah] (pecahan) = potongan asli di deck sumber, dipakai dulu sebelum potong tengah."""
        from PIL import Image
        src = (self.akar / berkas).resolve()
        if not src.exists():
            raise DeckGalat(f'foto {berkas} tidak ada')
        self.masukan.add(src)
        im = Image.open(src).convert('RGB')
        if klip:
            W, H = im.size
            im = im.crop((int(W * klip[0]), int(H * klip[2]), int(W * (1 - klip[1])), int(H * (1 - klip[3]))))
        W, H = im.size
        r = w_pt / h_pt
        if W / H > r:
            cw = int(H * r)
            im = im.crop(((W - cw) // 2, 0, (W - cw) // 2 + cw, H))
        else:
            ch = int(W / r)
            im = im.crop((0, (H - ch) // 2, W, (H - ch) // 2 + ch))
        px = int(w_pt * self.K['foto']['skala_px_per_pt'])
        im = im.resize((px, max(1, int(px / r))))
        out = self.keluaran / 'foto' / f'{self.nama}-kisi-{src.stem}-{int(w_pt)}x{int(h_pt)}{"-k" if klip else ""}.jpg'
        out.parent.mkdir(parents=True, exist_ok=True)
        im.save(out, quality=88)
        return out

    def kisi_foto(self, kv, x, y, w, h, fotos, kolom, asal, ket_baris=1):
        """Kisi foto berketerangan; tiap sel: foto lalu keterangan (1 baris, atau ket_baris untuk kisi sempit) di bawahnya."""
        self.visual('foto')  # foto dokumentasi lapangan dihitung visual halaman (S36)
        g = self.T['isi_daftar']
        jarak, th = 8, pt_dari(g) * 1.4 * ket_baris
        baris = math.ceil(len(fotos) / kolom)
        cw = (w - jarak * (kolom - 1)) / kolom
        ch = (h - jarak * (baris - 1)) / baris
        for i, f in enumerate(fotos):
            cx, cy = x + (i % kolom) * (cw + jarak), y + (i // kolom) * (ch + jarak)
            fh = ch - th - 2
            if f.get('utuh'):  # poster atau kolase: tampil utuh tanpa dipotong, di tengah sel
                from PIL import Image
                src = (self.akar / f['berkas']).resolve()
                self.masukan.add(src)
                iw, ih = Image.open(src).size
                sk_ = min(cw / iw, fh / ih)
                kv.gambar(src, cx + (cw - iw * sk_) / 2, cy + (fh - ih * sk_) / 2, iw * sk_, ih * sk_, 'foto')
            else:
                kv.gambar(self.potong_foto(f['berkas'], cw, fh, f.get('klip')), cx, cy, cw, fh, 'foto')
            ket = f['keterangan']
            isi_p = f.get('pil') or next((v for k_, v in PIL_TAHAP_FOTO.items() if ket.lower().startswith(k_)), None)
            if isi_p:  # tahap foto sebagai label berwarna (pemilik 26 Okt): awal merah, pengerjaan oranye, selesai hijau
                r = self.runs(ket, dict(g, warna='teks'), asal, tebal=True)
                self.muat(r, cw - 16, 1, asal, 'keterangan foto')
                self.pil(kv, cx, cy + fh + 2, r, th, isi_p, w=min(self.u.lebar(r) + 2 * pt_dari(g), cw))
            else:
                r = self.runs(ket, g, asal)
                self.muat(r, cw, ket_baris, asal, 'keterangan foto')
                kv.teks(cx, cy + fh + 2, cw, th, r, rata='c' if ket_baris > 1 else 'l', jangkar='t' if ket_baris > 1 else 'm', bungkus=ket_baris > 1)

    def data_harian(self):
        """Deck data harian (laporan harian, Penanganan, atau spek bertanda data_harian): satu-satunya yang boleh memasang pil CUT OFF."""
        return self.spek.get('format') in ('harian', 'penanganan') or bool(self.spek.get('data_harian'))

