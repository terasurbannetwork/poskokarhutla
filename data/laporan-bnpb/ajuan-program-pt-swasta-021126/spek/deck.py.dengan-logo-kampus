def kata_judul(judul):
    """Jumlah kata judul seperti terbaca: token angka = 1 kata, ber-|satuan = 2 kata; penanda tebal dibuang."""
    t = re.sub(r'\{\{angka:[^}]*\|[^}]*satuan[^}]*\}\}', 'N X', judul)
    t = re.sub(r'\{\{[^}]*\}\}', 'N', t).replace('**', '')
    return len(t.split())


class DeckGalat(Exception):
    pass



def cek_logo_transparan(jalur):
    """Logo BNPB wajib PNG berlatar transparan: keempat pojok alfa 0. Kotak putih di atas foto atau gradien ditolak."""
    from PIL import Image
    im = Image.open(jalur).convert('RGBA')
    w, h = im.size
    pojok = [im.getpixel(xy) for xy in ((0, 0), (w - 1, 0), (0, h - 1), (w - 1, h - 1))]
    if any(a > 0 and min(r, g, b) > 230 for r, g, b, a in pojok):   # pojok putih buram = latar kotak
        raise DeckGalat(f'logo {jalur} berlatar tidak transparan (alfa pojok {pojok}); pakai PNG transparan, '
                        'jangan logo berkotak putih (pemilik 1 Nov 2026)')

