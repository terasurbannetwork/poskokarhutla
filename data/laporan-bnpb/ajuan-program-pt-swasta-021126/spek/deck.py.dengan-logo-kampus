def cek_pustaka(out):
    """Putaran 5b: dua modul tidak boleh mengklaim label PUSTAKA yang sama kecuali salah satu menyatakan PUSTAKA_BERBAGI = True."""
    milik = {}
    for nama, m in out.items():
        for lab in m.PUSTAKA:
            lain = milik.get(lab)
            if lain and not (getattr(m, 'PUSTAKA_BERBAGI', False) or getattr(out[lain], 'PUSTAKA_BERBAGI', False)):
                if os.environ.get('DECK_PUSTAKA_BENTROK') == 'peringatan':   # hanya untuk pengembangan modul paralel; bawaan menolak
                    print(f'PERINGATAN label PUSTAKA "{lab}" dobel: {lain} dan {nama}', file=sys.stderr)
                    continue
                raise ImportError(f'label PUSTAKA "{lab}" diklaim dua renderer: {lain} dan {nama}; hapus dari yang lama atau set PUSTAKA_BERBAGI = True')
            milik.setdefault(lab, nama)


def muat_visual():
    """Renderer tambahan di scripts/visual/*.py (integrasi pustaka 3.325 slide, pemilik 31 Okt 2026). Tiap modul memuat
    NAMA (kunci spek, mis. "heatmap"), JENIS ("grafik" atau "tabel", untuk catatan visual halaman S36), PUSTAKA (label
    visual di pustaka/katalog.jsonl yang ia tutup), KAPAN (satu kalimat kapan dipakai), dan
    gambar(d, kv, x, y, w, h, v, asal) -> {"sumber": ...} yang menggambar di bidang isi panel."""
    import importlib.util
    out = {}
    for f in sorted((Path(__file__).resolve().parent / 'visual').glob('*.py')):
        if f.name.startswith('_'):
            continue
        spec = importlib.util.spec_from_file_location(f'visual_{f.stem}', f)
        m = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(m)
        for w in ('NAMA', 'JENIS', 'PUSTAKA', 'KAPAN', 'gambar'):
            if not hasattr(m, w):
                raise ImportError(f'renderer {f.name} tanpa {w}')
        out[m.NAMA] = m
    cek_pustaka(out)
    return out


