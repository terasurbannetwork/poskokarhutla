    def fase_bertaut(self, sp, rek, asal):
        """Aksi tiga fase bertaut ke matriks rekomendasi (B5.12, C7): kode wajib ada; waktu dan lembaga pemimpin diturunkan
        dari baris rekomendasi, dan bila spek menulisnya sendiri harus identik."""
        out = {}
        for kode in ('prabencana', 'tanggap-darurat', 'pascabencana'):
            aksi = sp['fase'][kode]
            if not 3 <= len(aksi) <= 5:
                raise DeckGalat(f'{asal}: fase {kode} butuh 3 sampai 5 aksi (PEDOMAN B5.12), ada {len(aksi)}')
            out[kode] = []
            for a in aksi:
                r = rek.get(a['kode'])
                if r is None:
                    raise DeckGalat(f'{asal}: aksi {a["kode"]} tidak ada di matriks rekomendasi deck ({", ".join(sorted(rek)) or "kosong"}); '
                                    'nomor aksi merujuk matriks (PEDOMAN B5.12)')
                turun = {'waktu': r['waktu'], 'lembaga': r['lembaga'][:1]}
                for k, v in turun.items():
                    if k in a and a[k] != v:
                        raise DeckGalat(f'{asal}: aksi {a["kode"]} {k} {a[k]} beda dengan rekomendasi {a["kode"]} {v} (C7)')
                out[kode].append(dict(a, **turun))
        return out

    def periksa_basi(self):
        """D-49 (putaran 5b): token angka bertanggal_data lebih tua dari 6 bulan sebelum tanggal deck ditolak (logika scripts/tarik/basi.py),
        kecuali spek menulis `basi_boleh` beralasan, atau angkanya sumber tahunan resmi (DIBI, BPS) pada tahun terakhir yang tersedia di
        registri: data tahunan memang baru terbit sekali setahun, jadi tahun terakhir tersedia adalah yang terbaru. Pengecualian dicatat
        sebagai peringatan, bukan diam-diam."""
        sys.path.insert(0, str(Path(__file__).resolve().parent / 'tarik'))
        try:
            import basi as _basi
        finally:
            sys.path.pop(0)
        angka = self.k.angka
        tolak, _, _ = _basi.periksa_spek(self.spek, angka, self.tgl)
        if not tolak:
            return
        def famili(e):
            su = (e.get('sumber') or '').upper()
            return 'DIBI' if 'DIBI' in su else 'BPS' if 'BPS' in su else None
        terakhir = {}
        for e in angka.values():
            f_ = famili(e)
            if f_ and e.get('tanggal_data'):
                terakhir[f_] = max(terakhir.get(f_, 0), int(e['tanggal_data'][:4]))
        kena = []
        for kunci in tolak:
            e = angka[kunci]
            f_ = famili(e)
            if f_ and int(e['tanggal_data'][:4]) == terakhir[f_]:
                self.peringatan.append(f'D-49 {kunci}: data {e["tanggal_data"]} lebih dari 6 bulan, dikecualikan karena sumber tahunan resmi {f_} tahun terakhir tersedia ({terakhir[f_]})')
            else:
                kena.append(f'{kunci} (data {e["tanggal_data"]})')
        if kena:
            raise DeckGalat(f'{self.nama}: {len(kena)} angka basi > 6 bulan (D-49): {"; ".join(kena[:6])}; perbarui lewat scripts/tarik '
                            'atau tulis "basi_boleh": {"kunci*": "alasan"} di spek')

    def periksa_garis_besar(self):
        """Garis besar sebelum membangun (Buku Pegangan S34, S35, S7): satu kalimat pesan_kunci per deck; tiap slide di luar
        sampul, penutup, dan pembatas memuat pesan, jenis_slide dari daftar tertutup S35, dan judul_bentuk temuan|deskriptif.
        Medan S35 "jenis" dan S7 "judul" ditulis jenis_slide dan judul_bentuk, karena "jenis" (tata letak) dan "judul" (teks)
        sudah dipakai spek. Dua slide isi berurutan tidak berjenis sama kecuali lampiran atau satu seri (spek "seri" sama: seri
        berchip S12, profil wilayah S26, lanjutan satu tabel)."""
        pk = self.spek.get('pesan_kunci')
        if not isinstance(pk, str) or not pk.strip():
            raise DeckGalat(f'{self.nama}: spek tanpa "pesan_kunci" (Buku Pegangan S34: satu kalimat pesan kunci per deck sebelum membangun)')
        self.cek_teks(pk, f'{self.nama}#pesan_kunci')
        lalu = None
        for i, sp in enumerate(self.spek['slide']):
            asal, tata = f'{self.nama}#{i + 1}', sp.get('jenis')
            if self.luar_isi(sp):
                continue
            if not isinstance(sp.get('pesan'), str) or not sp['pesan'].strip():
                raise DeckGalat(f'{asal}: slide tanpa "pesan" (Buku Pegangan S34: judul, pesan, dan visual tiap slide ditulis sebelum render)')
            self.cek_teks(sp['pesan'], asal + '/pesan')
            js = sp.get('jenis_slide')
            if js not in JENIS_S35:
                raise DeckGalat(f'{asal}: jenis_slide "{js}" di luar daftar tertutup S35: {", ".join(sorted(JENIS_S35))}')
            if tata in JENIS_S35_TATA and js not in JENIS_S35_TATA[tata]:
                raise DeckGalat(f'{asal}: tata letak "{tata}" hanya sah untuk jenis_slide {sorted(JENIS_S35_TATA[tata])}, tertulis "{js}"')
            jb = sp.get('judul_bentuk')
            if jb not in ('temuan', 'deskriptif'):
                raise DeckGalat(f'{asal}: judul_bentuk "{jb}" harus "temuan" atau "deskriptif" (Buku Pegangan S7, KEPUTUSAN T11)')
            if js in ('navigasi', 'lampiran') and jb != 'deskriptif':
                raise DeckGalat(f'{asal}: slide {js} berjudul deskriptif (S7: Pesan Kunci, Kesimpulan, dan lampiran), tertulis "{jb}"')
            judul = sp.get('judul', '')
            if jb == 'temuan' and '{{angka:' not in judul:
                raise DeckGalat(f'{asal}: judul_bentuk temuan tanpa token {{{{angka:...}}}} di judul (S7: kalimat temuan berangka)')
            nk = kata_judul(judul)
            if jb == 'temuan' and nk < JUDUL_KATA[0]:
                raise DeckGalat(f'{asal}: judul temuan {nk} kata < {JUDUL_KATA[0]}; tulis kalimat kesimpulan utuh: pelaku, kata kerja, angka '
                                '(D-42, riset konsultan 2026: judul isi 9-22 kata)')
            if nk > JUDUL_KATA[1]:
                raise DeckGalat(f'{asal}: judul {nk} kata > {JUDUL_KATA[1]}; pindahkan rincian ke subjudul atau isi (D-42)')
            kb = RE_KODE_BAGIAN.match(judul)
            if kb and kb[1] in 'ABCD' and jb != 'temuan':
                raise DeckGalat(f'{asal}: slide bagian {kb[1]} berjudul_bentuk "{jb}"; slide bagian A sampai D wajib temuan (S7, T11)')
            if js != 'lampiran':
                if lalu and lalu[0] == js and not (sp.get('seri') and sp.get('seri') == lalu[1]):
                    raise DeckGalat(f'{asal}: jenis_slide "{js}" sama dengan slide isi sebelumnya; S35 meminta variasi tata letak '
                                    '(kecuali seri berchip atau profil wilayah: isi "seri" yang sama)')
                lalu = (js, sp.get('seri'))
        self.periksa_ritme()
        self.periksa_navigasi()
        self.periksa_alur()
        self.periksa_keputusan()

    def periksa_navigasi(self):
        """Deck bersampul dengan 6 slide isi atau lebih wajib berbingkai baru dan bernavigasi: gaya_bingkai (atau format),
        daftar "bagian", slide daftar-isi, dan pembatas-seksi tiap bagian (bagian ber-halaman_tetap boleh tanpa pembatas).
        Pemilik 31 Okt 2026, setelah deck usulan satu pintu keluar dengan sampul lama tanpa daftar isi dan penanda bagian:
        "Cover gimana. Penutup gimana. Daftar isi gimana. Section gimana." Laporan harian dan penanganan dikecualikan
        (format generator). Pengecualian lain harus tertulis: spek "tanpa_navigasi": "<alasan>"."""
        jenis = [s_.get('jenis') for s_ in self.spek['slide']]
        n_isi = sum(1 for s_ in self.spek['slide'] if not self.luar_isi(s_))
        if 'sampul' not in jenis or n_isi < 6 or self.spek.get('format') in ('harian', 'penanganan'):
            return
        alasan = self.spek.get('tanpa_navigasi')
        if isinstance(alasan, str) and alasan.strip():
            return
        awal = f'{self.nama}: navigasi deck (pemilik 31 Okt 2026, {n_isi} slide isi)'
        if not (self.spek.get('gaya_bingkai') or self.spek.get('format')):
            raise DeckGalat(f'{awal}: tanpa "gaya_bingkai" atau "format"; sampul dan penutup memakai bingkai lama. '
                            'Tulis "format": "kajian" atau "gaya_bingkai": "tumpuk" dan "panel_sisi"')
        bagian = self.spek.get('bagian') or []
        if not bagian:
            raise DeckGalat(f'{awal}: tanpa "bagian" [{{judul, label}}]; penanda bagian di pita atas tidak terpasang')
        if 'daftar-isi' not in jenis:
            raise DeckGalat(f'{awal}: tanpa daftar isi; tambah {{"jenis": "daftar-isi"}} sesudah sampul')
        ada = {s_.get('bagian') for s_ in self.spek['slide'] if s_.get('jenis') == 'pembatas-seksi'}
        for n, b in enumerate(bagian, 1):
            if n not in ada and not b.get('halaman_tetap'):
                raise DeckGalat(f'{awal}: bagian {n} "{b.get("judul", "")}" tanpa pembatas-seksi; tambah {{"jenis": "pembatas-seksi", "bagian": {n}}}')

    def periksa_alur(self):
        """D-47 (putaran 5, 1 Nov 2026; riset konsultan 2026: ringkasan di depan, ditutup keputusan atau tindakan): deck isi
        wajib punya slide ringkasan (jenis_slide navigasi) di tiga slide ISI pertama, dan slide isi terakhir sebelum
        penutup (lampiran tidak dihitung) harus slide keputusan atau tindakan: rekomendasi, kesimpulan berarahan, atau spek
        "keputusan": true. Cakupan sama dengan periksa_navigasi: bersampul dengan 6 slide isi atau lebih, bukan format harian
        atau penanganan; paparan Presiden (tanpa sampul, 10a.01) dan laporan wilayah pendek tidak kena. Pengecualian harus
        tertulis: spek "tanpa_alur": "<alasan>". Tiga slide ISI, bukan tiga halaman: sampul, daftar isi, dan pembatas bukan isi."""
        jenis = [s_.get('jenis') for s_ in self.spek['slide']]
        n_isi = sum(1 for s_ in self.spek['slide'] if not self.luar_isi(s_))
        if 'sampul' not in jenis or n_isi < 6 or self.spek.get('format') in ('harian', 'penanganan'):
            return
        alasan = self.spek.get('tanpa_alur')
        if isinstance(alasan, str) and alasan.strip():
            return
        isi = [(i, s_) for i, s_ in enumerate(self.spek['slide'], 1) if not self.luar_isi(s_)]
        awal = f'{self.nama}: alur deck (D-47)'
        if not any(s_.get('jenis_slide') == 'navigasi' for _, s_ in isi[:3]):
            raise DeckGalat(f'{awal}: tanpa slide ringkasan di tiga slide isi pertama (nomor {", ".join(str(i) for i, _ in isi[:3])}); '
                            'tambah slide jenis_slide "navigasi" (ringkasan eksekutif, pesan kunci) di depan, atau tulis "tanpa_alur": "<alasan>"')
        ekor = [(i, s_) for i, s_ in isi if s_.get('jenis_slide') != 'lampiran' and s_.get('jenis') != 'lampiran-tabel']
        i, s_ = ekor[-1]
        sah = (s_.get('jenis') == 'rekomendasi' or s_.get('keputusan') is True
               or (s_.get('jenis') == 'kesimpulan' and isinstance(s_.get('arahan'), dict) and s_['arahan'].get('teks')))
        if not sah:
            raise DeckGalat(f'{awal}: slide isi terakhir sebelum penutup (nomor {i}, jenis "{s_.get("jenis")}") bukan keputusan atau tindakan; '
                            'tutup dengan slide rekomendasi, kesimpulan berpita arahan, atau tandai "keputusan": true, atau tulis "tanpa_alur": "<alasan>"')

    def periksa_keputusan(self):
        """D-46 (putaran 5, 1 Nov 2026; riset konsultan 2026: rekomendasi konkret, "Tingkatkan koordinasi" ditolak): tiap butir
        slide rekomendasi memuat penanggung jawab (lembaga), tenggat (waktu atau tenggat), dasar (token {{angka:}} yang ada di
        registri, atau rujukan "slide N" ke slide isi lain), dan risiko atau biaya (medan risiko atau biaya, paling sedikit
        tiga kata). Slide atau spek berpenanda "keputusan": true menolak butir yang kurang satu pun. Slide rekomendasi tanpa
        penanda hanya wajib penanggung jawab; kekurangan lain DILAPORKAN (peringatan CLI dan manifest), karena pemilik memutuskan
        26 Okt 2026 bahwa pil waktu boleh kosong dan deck lama belum bermedan dasar dan risiko. "keputusan": true hanya sah di
        slide rekomendasi atau slide ber-opsi. Medan dasar dan risiko adalah jejak keputusan, bukan teks slide: penulis
        memasukkannya ke rincian bila perlu tampil."""
        horizon, n = self.t['kosakata']['horizon'], len(self.spek['slide'])
        deck_ketat = self.spek.get('keputusan') is True
        for i, sp in enumerate(self.spek['slide'], 1):
            asal, jn = f'{self.nama}#{i}', sp.get('jenis')
            ber_opsi = jn == 'temuan-visual' and any(isinstance(v_, dict) and 'opsi' in v_ for v_ in [sp.get('utama')] + (
                sp.get('panel') if isinstance(sp.get('panel'), list) else [sp.get('panel')]))
            if sp.get('keputusan') and jn != 'rekomendasi' and not ber_opsi:
                raise DeckGalat(f'{asal}: "keputusan": true hanya sah di slide rekomendasi atau temuan-visual ber-opsi, bukan "{jn}" (D-46)')
            if jn != 'rekomendasi':
                continue
            ketat = deck_ketat or sp.get('keputusan') is True
            for r in sp.get('rekomendasi', []):
                kode, kurang = r.get('kode', '?'), []
                lem = r.get('lembaga')
                if not (isinstance(lem, list) and lem and all(isinstance(x, str) and x.strip() for x in lem)):
                    raise DeckGalat(f'{asal} butir {kode}: tanpa penanggung jawab (medan "lembaga" daftar nama tidak kosong) (D-46)')
                tenggat = r.get('waktu') if r.get('waktu') in horizon else (r.get('tenggat') or '').strip() if isinstance(r.get('tenggat'), str) else ''
                if not tenggat:
                    kurang.append('tenggat ("waktu" 100-hari/2026-2027/2028-2030 atau "tenggat")')
                dasar = r.get('dasar')
                if not (isinstance(dasar, str) and dasar.strip()):
                    kurang.append('dasar (token {{angka:...}} atau "slide N")')
                else:
                    for m_ in RE_TOK.finditer(dasar):
                        if m_[1] == 'angka' and m_[2].partition('|')[0].strip() not in self.k.angka:
                            raise DeckGalat(f'{asal} butir {kode}: dasar memakai angka "{m_[2].partition("|")[0].strip()}" yang tidak ada di data/angka.json (D-46)')
                    rujuk = [int(x) for x in re.findall(r'\b(?:slide|halaman)\s+(\d+)\b', dasar, re.I)]
                    for x in rujuk:
                        if not 1 <= x <= n or x == i or self.luar_isi(self.spek['slide'][x - 1]):
                            raise DeckGalat(f'{asal} butir {kode}: dasar merujuk slide {x} yang bukan slide isi lain di deck ini (D-46)')
                    if not rujuk and not any(m_[1] == 'angka' for m_ in RE_TOK.finditer(dasar)):
                        kurang.append('dasar (tidak memuat token {{angka:...}} atau "slide N")')
                rs = r.get('risiko') if isinstance(r.get('risiko'), str) and r.get('risiko').strip() else r.get('biaya')
                if not (isinstance(rs, str) and len(rs.split()) >= 3):
                    kurang.append('risiko atau biaya (kalimat paling sedikit tiga kata)')
                self.keputusan_log.append({'slide': i, 'kode': kode, 'dasar': dasar, 'lembaga': lem, 'tenggat': tenggat or None,
                                           'risiko': r.get('risiko'), 'biaya': r.get('biaya'), 'ketat': ketat})
                if kurang and ketat:
                    raise DeckGalat(f'{asal} butir {kode}: keputusan tanpa medan wajib, kurang: {"; ".join(kurang)} (D-46)')
                if kurang:
                    self.peringatan.append(f'D-46 {asal} butir {kode}: kurang {"; ".join(kurang)}')

    @staticmethod
    def bentuk_slide(sp):
        """Bentuk visual slide isi: (isi utama, ada grup kartu, isi panel samping). jenis_slide hanya label makna; deck RR
        27 Okt lolos S35 padahal 14 halaman datanya sama-sama grup kartu + tabel + panel butir (pemilik 30 Okt)."""
        tata = sp.get('jenis')
        if tata == 'temuan-visual':
            ut = sp.get('utama', {})
            if isinstance(ut, list):   # susun vertikal: bentuknya gabungan kedua panel menurut urutan
                utama = '/'.join(next((Deck.ritme_nama(k, q[k]) for k in Deck.VISUAL_PANEL if k in q), 'visual') for q in ut)
            else:
                utama = next((Deck.ritme_nama(k, ut[k]) for k in Deck.VISUAL_PANEL if k in ut), 'visual')
        else:
            utama = tata
        pan = (sp.get('modul') if tata == 'bebas' else sp.get('panel')) or []
        pan = pan if isinstance(pan, list) else [pan]
        isi = tuple(sorted({Deck.ritme_nama(k, p[k]) if k in Deck.VISUAL_PANEL else k for p in pan
                            for k in ('data', 'grafik', 'foto', 'temuan', 'daftar') + Deck.VISUAL_PANEL if k in p}))
        return (utama, bool(sp.get('grup')), isi)

    def periksa_ritme(self):
        """Gerbang ritme (pemilik 30 Okt 2026: "kenapa selalu formatnya mirip"): slide isi berurutan dengan "seri" sama
        dihitung satu; tiga bentuk sama berturut-turut ditolak, dan satu bentuk paling banyak separuh slide isi."""
        unit, seri_lalu = [], None
        for i, sp in enumerate(self.spek['slide']):
            if self.luar_isi(sp) or sp.get('jenis') in ('lampiran-tabel', 'galeri', 'penutup', 'kesimpulan', 'rekomendasi'):
                seri_lalu = None
                continue
            if sp.get('seri') and sp.get('seri') == seri_lalu:
                continue
            seri_lalu = sp.get('seri')
            unit.append((i + 1, self.bentuk_slide(sp)))
        for a, b, c in zip(unit, unit[1:], unit[2:]):
            if a[1] == b[1] == c[1]:
                raise DeckGalat(f'{self.nama}#{c[0]}: slide {a[0]}, {b[0]}, {c[0]} berbentuk sama {a[1]}; ritme: ganti isi utama '
                                '(temuan-visual corong/progres/tumpuk, temuan-grafik, temuan-peta) atau isi panel samping')
        if len(unit) >= 5:
            from collections import Counter
            bt, n = Counter(u[1] for u in unit).most_common(1)[0]
            if n * 2 > len(unit):
                raise DeckGalat(f'{self.nama}: {n} dari {len(unit)} slide isi berbentuk sama {bt}; ritme: paling banyak separuh')
            ut, nu = Counter(u[1][0] for u in unit).most_common(1)[0]   # isi utama saja, apa pun panel sampingnya
            if nu * 2 > len(unit):
                raise DeckGalat(f'{self.nama}: {nu} dari {len(unit)} slide isi berisi utama {ut}; ritme: paling banyak separuh '
                                '(pilih bentuk dari pustaka: scripts/pustaka_bnpb.py --saran <jenis pesan>)')

    def siapkan(self):
        """Spek -> daftar pekerjaan slide (lampiran-tabel dipecah rata), bernomor, dengan rujukan halaman lampiran."""
        kerja = []
        jenis_sah = {'sampul', 'kartu-angka', 'temuan-grafik', 'temuan-peta', 'tabel-peringkat', 'temuan-visual', 'skenario', 'strategi-tiga-fase', 'galeri',
                     'rekomendasi', 'kesimpulan', 'penutup', 'pembatas-lampiran', 'lampiran-tabel', 'daftar-isi', 'pembatas-seksi', 'impor',
                     'bebas', 'bebas-polos', 'foto-penuh'}
        for i, sp in enumerate(self.spek['slide']):
            if sp.get('jenis') == 'bebas-polos' and not sp.get('pembatas'):
                raise DeckGalat(f'{self.nama}#{i + 1}: tanpa_kepala_slide hanya untuk pembatas; tulis "pembatas": true (slide isi wajib berkepala BNPB)')
            if sp.get('pembatas') and sp.get('jenis') not in ('bebas', 'bebas-polos'):
                raise DeckGalat(f'{self.nama}#{i + 1}: "pembatas" hanya sah di jenis bebas')
            if sp.get('jenis') not in jenis_sah:
                raise DeckGalat(f'{self.nama}#{i + 1}: jenis slide "{sp.get("jenis")}" tidak dikenal: {", ".join(sorted(jenis_sah))}')
        self.periksa_garis_besar()
        self.periksa_basi()
        rek = {}  # matriks rekomendasi deck: kode -> baris (nomor aksi tiga fase merujuk ke sini, B5.12)
        for i, sp in enumerate(self.spek['slide']):
            for r in sp.get('rekomendasi', []) if sp.get('jenis') == 'rekomendasi' else []:
                if r['kode'] in rek:
                    raise DeckGalat(f'{self.nama}#{i + 1}: kode rekomendasi {r["kode"]} dobel')
                rek[r['kode']] = r
        for i, sp in enumerate(self.spek['slide']):
            jn = sp.get('jenis')
            if jn not in jenis_sah:
                raise DeckGalat(f'{self.nama}#{i + 1}: jenis slide "{jn}" tidak dikenal: {", ".join(sorted(jenis_sah))}')
            asal = f'{self.nama}#{i + 1}'
            if jn == 'strategi-tiga-fase':
                kerja.append({'jenis': jn, 'spek': sp, 'asal': asal, 'fase': self.fase_bertaut(sp, rek, asal)})
                continue
            if jn != 'lampiran-tabel':
                kerja.append({'jenis': jn, 'spek': sp, 'asal': asal})
                continue
            tb = self.data(sp['data'], asal + '/data')
            TL = self.K['tabel_lampiran']
            ruang = self.bawah() - self.S['area_isi_y_pt'][0] - TL['kepala_tinggi_pt']
            per = min(sp.get('maks_baris', TL['maks_baris']), int(ruang // TL['baris_pt'][0]))
            n = math.ceil(len(tb['baris']) / per)
            rata = math.ceil(len(tb['baris']) / n)
            for b in range(n):
                kerja.append({'jenis': jn, 'spek': sp, 'asal': f'{asal}.{b + 1}', 'tabel': tb, 'judul': f'{sp["kode"]}. {sp["judul"]}',
                              'judul_akhir': f' (lanjutan {b + 1}/{n})' if b else '',
                              'baris': tb['baris'][b * rata:(b + 1) * rata]})
        for n, kj in enumerate(kerja, start=1):
            kj['nomor'] = n
        self.bagian = [dict(b, halaman=list(b.get('halaman_tetap', []))) for b in self.spek.get('bagian', [])]  # daftar isi, pembatas seksi, penanda kaki; halaman_tetap: deck pendek tanpa pembatas (pemilik 31 Okt)
        aktif = None
        for kj in kerja:
            if kj['jenis'] == 'pembatas-seksi':
                aktif = kj['spek']['bagian']
                if not 1 <= aktif <= len(self.bagian):
                    raise DeckGalat(f'{kj["asal"]}: bagian {aktif} di luar daftar "bagian" spek ({len(self.bagian)})')
            elif kj['jenis'] in ('penutup', 'pembatas-lampiran'):
                aktif = None
            if aktif and kj['jenis'] not in ('penutup', 'pembatas-lampiran'):
                kj['bagian'] = aktif
                self.bagian[aktif - 1]['halaman'].append(kj['nomor'])
        for kj in kerja:   # deck tanpa pembatas: bagian dari halaman_tetap ikut memasang penanda atas (pemilik 31 Okt)
            if not kj.get('bagian') and kj['jenis'] not in ('sampul', 'penutup', 'daftar-isi', 'pembatas-seksi', 'pembatas-lampiran'):
                kj['bagian'] = next((i for i, b in enumerate(self.bagian, 1) if kj['nomor'] in b.get('halaman_tetap', [])), None)
        for i, b in enumerate(self.bagian, 1):
            if not b['halaman']:
                raise DeckGalat(f'{self.nama}: bagian {i} "{b["judul"]}" tanpa pembatas-seksi')
        for i, kj in enumerate(kerja):
            if kj['jenis'] == 'pembatas-lampiran':
                lamp = {}
                for kk in kerja[i + 1:]:
                    if kk['jenis'] == 'lampiran-tabel':
                        lj = lamp.setdefault(kk['spek']['kode'], {'kode': kk['spek']['kode'], 'halaman': [],
                                                                    'judul_daftar': kk['spek'].get('judul_daftar', kk['spek']['judul'])})
                        lj['halaman'].append(kk['nomor'])
                if not lamp:
                    raise DeckGalat(f'{kj["asal"]}: pembatas Lampiran tanpa slide lampiran sesudahnya')
                kj['lampiran'] = list(lamp.values())
        return kerja

    def gambar(self, kj):
        sl = self.prs.slides.add_slide(self.lay['GELAP' if self.gelap(kj) else 'PUTIH'])
        kv = Kanvas(self, sl)
        if kj['jenis'] not in BINGKAI:
            self.bingkai(kv, kj)
        naik = (self.hal or {}).get('naik', 0)
        if naik:  # isi ikut naik bersama garis judul
            a0 = self.S['area_isi_y_pt']
            self.S['area_isi_y_pt'] = [a0[0] - naik, a0[1]]
            try:
                return self._gambar_isi(kv, kj)
            finally:
                self.S['area_isi_y_pt'] = a0
        return self._gambar_isi(kv, kj)

    def foto_sisi(self, kv, fs, asal):
        """Putaran 5c: foto setinggi area isi menempel tepi slide (kiri/kanan); keterangan + kredit di bawah foto. Mengembalikan
        (X0, X1) isi yang menyempit. Kredit wajib: dari spek `kredit` atau kredit.json (self.kredit menolak foto tanpa atribusi)."""
        if not isinstance(fs, dict) or not fs.get('foto'):
            raise DeckGalat(f'{asal}: foto_sisi butuh {{"foto": berkas, "sisi": "kiri|kanan", "lebar": 0.33-0.5, "keterangan", "kredit"}}')
        sisi, lebar = fs.get('sisi', 'kiri'), fs.get('lebar', 0.4)
        if sisi not in ('kiri', 'kanan') or not 0.33 <= lebar <= 0.5:
            raise DeckGalat(f'{asal}: foto_sisi sisi "{sisi}" harus kiri atau kanan dan lebar {lebar} antara 0.33 dan 0.5 lebar slide')
        kred = self.kredit(fs['foto'], fs, asal)   # menolak foto tanpa atribusi
        sw = self.prs.slide_width / EMU
        fw, jarak = round(sw * lebar, 1), self.K['bingkai']['jarak_blok_pt']
        y0, y1 = self.S['area_isi_y_pt'][0], self.bawah()
        x = 0 if sisi == 'kiri' else sw - fw
        ch = 30 if fs.get('keterangan') else 16   # jalur keterangan dan kredit di bawah foto
        self.visual('foto')
        kv.gambar(self.potong_foto(fs['foto'], fw, y1 - y0 - ch, fs.get('klip')), x, y0, fw, y1 - y0 - ch, 'foto')
        yy = y1 - ch + 2
        if fs.get('keterangan'):
            r = self.runs(fs['keterangan'], self.T['isi_daftar'], asal)
            self.muat(r, fw - 8, 1, asal, 'keterangan foto_sisi')
            kv.teks(x + 4, yy, fw - 8, 14, r, bungkus=False, jangkar='m')
            yy += 13
        kv.teks(x + 4, yy, fw - 8, 12, [self.R(self.st(kred), dict(self.T['kredit_foto'], warna='teks-3', ukuran_pt=6.5))], bungkus=False, jangkar='m')
        return (fw + jarak, self.X1) if sisi == 'kiri' else (self.X0, sw - fw - jarak)

    def _gambar_isi(self, kv, kj):
        fs = kj['spek'].get('foto_sisi')
        if fs and kj['jenis'] not in BINGKAI:
            x0, x1 = self.foto_sisi(kv, fs, kj['asal'])
            a0 = (self.X0, self.W, self.X1)
            self.X0, self.X1 = x0, x1
            self.W = x1 - x0
            try:
                self._gambar_isi_inti(kv, kj)
            finally:
                self.X0, self.W, self.X1 = a0
        else:
            self._gambar_isi_inti(kv, kj)
        if kj['spek'].get('hiasan'):   # elemen grafis plug-and-play dari scripts/elemen.py (pemilik 31 Okt)
            import elemen
            elemen.pasang(self, kv, kj['spek']['hiasan'], kj['asal'])

    def s_bebas_polos(self, kv, j):
        self.s_bebas(kv, j)

    def _gambar_isi_inti(self, kv, kj):
        fn = {'kartu-angka': self.s_temuan, 'temuan-grafik': self.s_temuan, 'temuan-peta': self.s_temuan,
              'tabel-peringkat': self.s_temuan, 'temuan-visual': self.s_temuan}.get(kj['jenis']) or getattr(self, 's_' + kj['jenis'].replace('-', '_'))
        sk = kj['spek'].get('skala_huruf') if kj['jenis'] not in ('kartu-angka', 'temuan-grafik', 'temuan-peta', 'tabel-peringkat', 'temuan-visual') else None
        if sk:  # halaman berbahan sedikit: huruf isi diperbesar, judul dan kaki tetap (pemilik 26 Okt, batas 5%)
            asli = {k: self.T[k] for k in ISI_SKALA if k in self.T}
            try:
                for k, g0 in asli.items():
                    self.T[k] = dict(g0, ukuran_pt=pt_dari(g0) * sk)
                fn(kv, kj)
            finally:
                self.T.update(asli)
        else:
            fn(kv, kj)

    def keluarga(self):
        """Keluarga bencana yang tampil di halaman ini, dari peran warna kategori.<k> dan skala.<ramp> yang tercatat."""
        sk = self.t['warna']['skala']
        out = set()
        for _, peran in self.hal['warna']:
            jenis, _, nama = peran.partition('.')
            if jenis == 'kategori':
                out.add(nama)
            elif jenis == 'skala' and sk[nama].get('kategori'):
                out.add(sk[nama]['kategori'])
        return out

    def rapikan_templat(self):
        """Sisa templat pemilik yang ditolak qa/periksa.py: judul dokumen lama (D-10), buFont Arial di master (D-4),
        warna skema dk1 hitam sistem (D-9). Diganti dengan judul kajian, Roboto, dan hex teks tema."""
        cp = self.prs.core_properties  # L71: judul, penerbit BNPB, subjek, kata kunci, bahasa id-ID
        cp.title = self.spek.get('judul_dokumen') or self.kaj['judul']
        cp.subject = self.spek.get('subjek_dokumen') or self.kaj['subjudul']
        cp.author = cp.last_modified_by = self.t['kajian']['penerbit']
        cp.keywords = '; '.join(self.kaj.get('kata_kunci', []))
        cp.language = 'id-ID'
        cp.category = 'Kajian'
        cp.comments = self.spek.get('pesan_kunci', '')
        A = '{http://schemas.openxmlformats.org/drawingml/2006/main}'
        teks = warna(self.t, 'teks').lstrip('#').upper()
        for m in self.prs.slide_masters:
            for bu in m._element.iter(A + 'buFont'):
                if bu.get('typeface') != self.t['font']['keluarga']:
                    bu.set('typeface', self.t['font']['keluarga'])
            th = m.part.part_related_by(RT.THEME)
            th._blob = th.blob.replace(b'<a:sysClr val="windowText" lastClr="000000"/>', f'<a:srgbClr val="{teks}"/>'.encode())

    def bangun(self, keluar):
        """Dua lintasan per halaman isi: lintasan 1 di slide buangan hanya mengenali keluarga warna yang tampil, lintasan 2
        menggambar dengan peran warna halaman itu (arah teks-2, angka judul navy; PEDOMAN B1.5, B1.8)."""
        kerja = self.siapkan()
        for kj in kerja:
            kel = set()
            if kj['jenis'] not in BINGKAI:
                m0, c0 = len(self.k.manifest), len(self.catatan)
                self.hal = {'nomor': kj['nomor'], 'keluarga': set(), 'warna': set(), 'struktur': [], 'pembatas': self.pembatas(kj['spek'])}
                self.gambar(kj)
                kel = self.keluarga()
                sid = self.prs.slides._sldIdLst[-1]
                self.prs.part.drop_rel(sid.rId)
                self.prs.slides._sldIdLst.remove(sid)
                del self.k.manifest[m0:], self.catatan[c0:]
            self.hal = {'nomor': kj['nomor'], 'keluarga': kel, 'warna': set(), 'struktur': [], 'pembatas': self.pembatas(kj['spek'])}
            self.gambar(kj)
            for d_, v_ in self.hal.get('bab_angka', {}).items():   # nomor bab di slide pembatas: angka biasa, tercatat sebagai urutan spek (D-22, D-6)
                self.turunan(f'bab:{d_}', d_, v_, kj['asal'], 'resmi', 'urutan spek')
            self.cek_kartu_ulang(self.prs.slides[-1])
            if kj['jenis'] in ('temuan-grafik', 'temuan-visual', 'tabel-peringkat'):   # slide ber-eksibit; skenario dan kartu merangkum sengaja mengulang
                self.cek_angka_ulang(self.prs.slides[-1], kj['asal'], kj['spek'])
            # D-45: slide isi berangka wajib berbaris Sumber (pemilik: sumber tiap slide berangka; juri 1 Nov menemukan 8 halaman tanpa)
            if (kj['jenis'] not in BINGKAI and not self.hal['pembatas'] and not self.hal.get('sumber_tampil')
                    and any(m.get('naskah') == kj['asal'] for m in self.k.manifest)):
                raise DeckGalat(f"{kj['asal']}: slide berangka tanpa baris Sumber (D-45); tulis \"sumber\" di spek slide ini")
            sp = kj['spek']
            self.halaman.append({'nomor': kj['nomor'], 'jenis': kj['jenis'], 'asal': kj['asal'], 'keluarga': sorted(self.keluarga()),
                                 'judul': self.hal.get('judul'), 'peta': self.hal.get('peta'), 'struktur': self.hal['struktur'],
                                 'warna': sorted(self.hal['warna']), 'judul_spek': (kj.get('judul') or sp.get('judul', '')) + kj.get('judul_akhir', ''),
                                 'pesan': sp.get('pesan'), 'pembatas': self.hal['pembatas'], 'kontras': self.hal.get('kontras'), 'jenis_slide': sp.get('jenis_slide'), 'judul_bentuk': sp.get('judul_bentuk'),
                                 'seri': sp.get('seri'), 'visual': sorted(self.hal.get('visual', ())), 'gambar': self.hal.get('gambar', []),
                                 'panel': self.hal.get('panel', []), 'terisi': self.hal.get('terisi', []), 'naik': self.hal.get('naik', 0), 'subjudul': self.hal.get('subjudul')})
        self.hal = None
        self.cek_bank(self.spek, self.nama)   # lapis ketiga D-10: sesudah gerbang istilah per teks, supaya pesan lama tetap yang pertama
        keluar = Path(keluar)
        keluar.parent.mkdir(parents=True, exist_ok=True)
        self.rapikan_templat()
        self.prs.save(keluar)
        self.masukan |= {self.akar / 'data' / rel for rel in self.k._berkas}
        (keluar.with_suffix('.manifest.json')).write_text(json.dumps(
            {'spek': self.nama, 'pesan_kunci': self.spek.get('pesan_kunci'), 'slide': self.halaman, 'angka': self.k.manifest, 'catatan': self.catatan,
             'keputusan': self.keputusan_log, 'peringatan': self.peringatan,
             'masukan': {os.path.relpath(p.resolve(), keluar.resolve().parent): sha(p) for p in sorted(self.masukan)}},  # relatif ke folder PPTX
            ensure_ascii=False, indent=1, default=str), encoding='utf-8')
        return kerja


def salin_slide(src, shapes, pkg, y_kaki):
    """Salin isi satu slide (bentuk, gambar, grafik, latar) ke slide tujuan beserta relasinya; bagian yang namanya bentrok
    di paket tujuan diberi nama baru. Kaki lama dibuang: garis mendatar lebar di bawah 85% tinggi slide dan semua yang di
    bawahnya. Mengembalikan teks catatan satu baris di atas garis itu ('*...' atau 'Sumber: ...') yang ikut dibuang,
    supaya pindah ke pita kaki deck.py."""
    import copy
    W, H = src.part.package.presentation_part.presentation.slide_width, src.part.package.presentation_part.presentation.slide_height
    ada = {str(p_.partname) for p_ in pkg.iter_parts()}
    sudah = set()

    def unik(part):
        if id(part) in sudah:
            return
        sudah.add(id(part))
        if str(part.partname) in ada:
            pola = re.sub(r'\d*(\.\w+)$', r'%d\1', str(part.partname))
            part.partname = pkg.next_partname(pola) if '%d' in pola else part.partname
            while str(part.partname) in ada:
                part.partname = type(part.partname)(re.sub(r'(\d*)(\.\w+)$', lambda m: str(int(m.group(1) or 0) + 1) + m.group(2), str(part.partname)))
        ada.add(str(part.partname))
        for rel in part.rels.values():
            if not rel.is_external:
                unik(rel.target_part)
    dst_part = shapes.part
    peta = {}
    for rid, rel in src.part.rels.items():
        if rel.reltype in (RT.SLIDE_LAYOUT, RT.NOTES_SLIDE):
            continue
        if rel.is_external:
            peta[rid] = dst_part.relate_to(rel.target_ref, rel.reltype, is_external=True)
        else:
            unik(rel.target_part)
            peta[rid] = dst_part.relate_to(rel.target_part, rel.reltype)
    for el in list(shapes._spTree):
        if not (el.tag.endswith('}nvGrpSpPr') or el.tag.endswith('}grpSpPr')):
            shapes._spTree.remove(el)
    bg = src._element.cSld.find(qn('p:bg'))
    if bg is not None:
        shapes._spTree.getparent().insert(0, copy.deepcopy(bg))
    def kotak(el):
        off = el.find('.//' + qn('a:off'))
        ext = el.find('.//' + qn('a:ext'))
        return (int(off.get('x')), int(off.get('y')), int(ext.get('cx')), int(ext.get('cy'))) if off is not None and ext is not None else None
    anak = [el for el in src.shapes._spTree if not (el.tag.endswith('}nvGrpSpPr') or el.tag.endswith('}grpSpPr'))]
    garis_y = None
    for el in anak:
        k = kotak(el)
        if k and k[3] == 0 and k[2] >= 0.7 * W and k[1] >= 0.85 * H:
            garis_y = k[1] if garis_y is None else min(garis_y, k[1])
    catatan = None
    if garis_y is not None:
        tetap = []
        for el in anak:
            k = kotak(el)
            if k and k[1] >= garis_y:
                continue   # garis kaki lama, (c) lama, nomor lama
            teks = ''.join(t.text or '' for t in el.iter(qn('a:t'))).strip()
            if k and teks and k[1] + k[3] <= garis_y + 1 and k[1] >= garis_y - Pt(36) and k[3] <= Pt(20) and (teks.startswith('*') or teks.lower().startswith('sumber')):
                catatan = re.sub(r'^\*\s*|^sumber\s*:\s*', '', teks, flags=re.I)
                continue
            if k and not teks and k[2] <= Pt(6) and k[1] >= garis_y - Pt(36) and k[1] < garis_y:
                continue   # bilah penanda catatan lama
            tetap.append(el)
        anak = tetap
    elif y_kaki:
        anak = [el for el in anak if not ((kotak(el) or (0, 0, 0, 0))[1] >= y_kaki)]
    for el in anak:
        e = copy.deepcopy(el)
        for n in e.iter():
            for k_, v in list(n.attrib.items()):
                if k_.startswith('{http://schemas.openxmlformats.org/officeDocument/2006/relationships}') and v in peta:
                    n.set(k_, peta[v])
        shapes._spTree.append(e)
    return catatan


def ringkas_sumber(daftar, awalan, label_olah):
    """Gabung sumber per lembaga: 'InaRISK BNPB, IRBI 2024' + 'InaRISK BNPB, IRBI 2015 dan 2024' -> 'InaRISK BNPB, IRBI 2015, 2024'."""
    olah, grup = False, {}
    for s in daftar:
        for bag in (b.strip() for b in s.split(';')):
            if bag.startswith(awalan):
                olah, bag = True, bag[len(awalan):].strip()
            lembaga, _, rinci = bag.partition(', ')
            grup.setdefault(lembaga, [])
            if rinci and rinci not in grup[lembaga]:
                grup[lembaga].append(rinci)
    out = []
    for lembaga, rinci in grup.items():
        kata = {r.split(' ')[0] for r in rinci}
        if len(kata) == 1 and len(rinci) > 1:  # 'IRBI 2015 dan 2024', 'IRBI 2023' -> 'IRBI 2015, 2023, 2024'
            tahun = sorted({t for r in rinci for t in re.findall(r'(?:19|20)\d{2}(?:–(?:19|20)\d{2})?', r)})
            rentang = [tuple(map(int, t.split('–'))) for t in tahun if '–' in t]
            tahun = [t for t in tahun if '–' in t or not any(a <= int(t) <= b for a, b in rentang)]
            sisa = {re.sub(r'(?:19|20)\d{2}(?:–(?:19|20)\d{2})?|\bdan\b|,', '', r).strip() for r in rinci}
            rinci = [f'{kata.pop()} {", ".join(tahun)}'] if sisa == {next(iter(sisa))} and len(next(iter(sisa)).split()) == 1 else rinci
        out.append(lembaga + (', ' + ', '.join(rinci) if rinci else ''))
    return '; '.join(out) + (f'; {label_olah}' if olah else '')


def ke_pdf(pptx, outdir=None):
    """PPTX -> PDF dengan soffice berprofil terpisah (tidak bentrok dengan LibreOffice yang sedang terbuka)."""
    pptx = Path(pptx).resolve()
    outdir = Path(outdir or pptx.parent).resolve()
    import tempfile
    profil = Path(tempfile.gettempdir()) / f'deck-bnpb-profil-lo-{os.getpid()}'
    # Roboto skill dipasang di profil LibreOffice ini saja: PDF benar tanpa memasang font ke sistem
    (profil / 'user/fonts').mkdir(parents=True, exist_ok=True)
    for f in FONT_SKILL.glob('Roboto-*.ttf'):
        if not (profil / 'user/fonts' / f.name).exists():
            shutil.copy(f, profil / 'user/fonts' / f.name)
    pdf = outdir / (pptx.stem + '.pdf')
    pdf.unlink(missing_ok=True)  # PDF lama tidak boleh lolos sebagai hasil konversi yang gagal
    subprocess.run([soffice(), f'-env:UserInstallation={profil.as_uri()}', '--headless',   # as_uri: file:///C:/... sah di Windows (2 Nov 2026)
                    '--convert-to', 'pdf', '--outdir', str(outdir), str(pptx)], check=True, capture_output=True, timeout=300)
    if not pdf.exists():
        raise DeckGalat(f'soffice tidak menghasilkan {pdf}')
    return pdf


def _terbitkan(gagal, pdf, final):
    """Gerbang lolos: ganti nama berkas `.gagal` (pptx, pdf, manifest) ke nama final; berkas final lama ditimpa."""
    gm = gagal.with_suffix('.manifest.json')
    gm.replace(final.with_suffix('.manifest.json'))
    gagal.replace(final)
    if pdf:
        pdf = Path(pdf)
        pdf.replace(final.with_suffix('.pdf'))
        pdf = final.with_suffix('.pdf')
    return final, pdf


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument('spek')
    ap.add_argument('keluar', nargs='?', help='bawaan: <akar>/keluaran/<nama berkas kajian DDMMYY>.pptx')
    ap.add_argument('--pdf', action='store_true', help='juga ekspor PDF lewat soffice dan periksa PDF-nya (D-4, D-17)')
    ap.add_argument('--akar', help='akar proyek: tema.json, pustaka.json, data/angka.json, csv, peta, foto (bawaan DECK_AKAR, lalu assets/proyek-contoh)')
    ap.add_argument('--registri', help='registri angka lain selain <akar>/data/angka.json')
    a = ap.parse_args(argv)
    akar = Path(a.akar or os.environ.get('DECK_AKAR') or AKAR).resolve()
    os.environ['DECK_AKAR'] = str(akar)  # qa_periksa dan tema.muat membaca akar yang sama
    sp = json.loads(Path(a.spek).read_text(encoding='utf-8'))
    d = Deck(sp, Path(a.spek).stem, akar=akar, berkas_spek=a.spek, registri=a.registri)
    keluar = Path(a.keluar or akar / 'keluaran' / (d.kaj['nama_berkas'].replace('{DDMMYY}', d.tgl.strftime('%d%m%y')) + '.pptx'))
    d.keluaran = keluar.resolve().parent / '.deck-cache'  # ikon PNG dan potongan foto di samping keluaran, bukan di folder skill
    final = keluar
    keluar = final.with_name(final.stem + '.gagal.pptx')   # PPTX/PDF final hanya ada bila gerbang lolos
    kerja = d.bangun(keluar)
    for w in d.peringatan:
        print('PERINGATAN', w, file=sys.stderr)
    from periksa import laporan, periksa
    pdf = ke_pdf(keluar) if a.pdf else None
    hasil = periksa(keluar, d.t, pdf)
    keluar, pdf = _terbitkan(keluar, pdf, final)
    print('ok', keluar, pdf or '', json.dumps(hasil, ensure_ascii=False))
    if pdf:  # laporan QA per deck (Buku Pegangan S39): font, ikon, tata letak, anti-AI ke keluaran/qa/
        jalur, vonis = laporan(keluar, d.t, pdf)
        print(f'laporan QA deck: {jalur} ({vonis})')
        if vonis != 'LOLOS':
            sys.exit(f'laporan QA deck GAGAL: {jalur}')


if __name__ == '__main__':
    try:
        main()
    except Exception as e:   # termasuk GerbangGagal dari modul `deck` (kelas berbeda bila deck.py dijalankan sebagai skrip)
        if not isinstance(e, DeckGalat) and not hasattr(e, 'temuan'):
            raise
        if getattr(e, 'temuan', None):   # gerbang render gagal: berkas ditinggal di nama `.gagal`, keluar 2 dengan peta per halaman
            for t_ in e.temuan:
                print(f"GALAT {t_['kode']} halaman {t_['halaman']}: {t_['pesan']}", file=sys.stderr)
            print(f'DeckGalat: {len(e.temuan)} temuan gerbang render; berkas ditinggal di nama .gagal, tidak diterbitkan', file=sys.stderr)
            sys.exit(2)
        sys.exit(f'DeckGalat: {e}')
