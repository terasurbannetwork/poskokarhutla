def judul_kapital(teks):
    """Huruf kapital di awal tiap kata, kecuali kata tugas di tengah judul; singkatan dan kata berhuruf besar dibiarkan."""
    out = []
    for i, w in enumerate(teks.split(' ')):
        if not w or any(c.isupper() for c in w) or (i and w.lower() in KATA_KECIL) or w[0].isdigit() or w.startswith(('{{', '(')):
            out.append(w)
        else:
            out.append('/'.join(b[:1].upper() + b[1:] for b in w.split('/')))
    return ' '.join(out)


