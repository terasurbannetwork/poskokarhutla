{"dibuat":"2026-10-24T10:41+07:00","versi":1,"hari":"2026-10-24","label":"perkiraan, belum diuji balik","rumus":{"titik":"rerata jumlah titik panas pada jendela H hari yang sama, atas tahun skenario (2019–2025)","kompleks":"titik ÷ titik per cluster provinsi (rerata titik per kluster pada cluster operasi)","jam_terbang":"cluster × porsi cluster prioritas (tingkat 3) × jam heli per cluster","regu_hari":"cluster × regu-hari per cluster (rerata skenario tengah rencana operasi) × rotasi","regu_rata":"regu-hari ÷ jumlah hari","terdampak":"penduduk kecamatan dengan cluster tingkat ≥ 2 × min(1, cluster ÷ cluster operasi)","masker":"terdampak × masker per orang","rp_heli":"jam terbang × tarif heli per jam","rp_regu":"regu-hari × 15 orang × biaya orang-hari (0,4 × uang harian + 0,4 × honor MPA + konsumsi)","rp_masker":"masker × harga masker","rp_total":"rupiah heli + rupiah regu + rupiah masker (komponen tanpa data tidak dijumlah)","rp_rendah":"total dengan titik panas tahun paling sepi di skenario dan 1,5 jam heli per cluster prioritas","rp_tinggi":"total dengan titik panas tahun paling ramai di skenario dan 6 jam heli per cluster prioritas; rentang nasional = jumlah rentang provinsi"},"tarif":{"heli_jam":{"nilai":150000000.0,"satuan":"Rp/jam terbang","sumber":"asumsi kerja tim Pantau Bencana: sewa helikopter water bombing, acuan Dana Siap Pakai BNPB"},"uang_harian":{"nilai":{"14":370000.0,"15":370000.0,"16":380000.0,"61":380000.0,"62":360000.0,"63":380000.0,"64":430000.0,"53":430000.0,"93":580000.0},"bawaan":380000.0,"satuan":"Rp/orang/hari","sumber":"SBM 2026 (Kemenkeu), uang harian luar kota per provinsi; provinsi lain memakai nilai bawaan (asumsi)"},"porsi_bko":{"nilai":0.4,"satuan":"porsi personel","sumber":"asumsi kerja tim Pantau Bencana: porsi personel yang dibayar uang harian penuh"},"porsi_mpa":{"nilai":0.4,"satuan":"porsi personel","sumber":"asumsi kerja tim Pantau Bencana: porsi Masyarakat Peduli Api"},"honor_mpa":{"nilai":100000.0,"satuan":"Rp/orang/hari","sumber":"asumsi kerja tim Pantau Bencana"},"konsumsi":{"nilai":150000.0,"satuan":"Rp/orang/hari","sumber":"asumsi kerja tim Pantau Bencana"},"harga_masker":{"nilai":15000.0,"satuan":"Rp/masker N95","sumber":"estimasi harga pasar, asumsi kerja tim Pantau Bencana"}},"koefisien":{"orang_per_regu":{"nilai":15,"satuan":"orang/regu","sumber":"Permen LHK P.32/2016"},"jam_heli_per_api":{"nilai":3,"rendah":1.5,"tinggi":6,"satuan":"jam terbang/cluster prioritas","sumber":"asumsi kerja tim Pantau Bencana; rentang rendah 1,5 dan tinggi 6 dipakai untuk batas rupiah"},"rotasi":{"nilai":1.5,"satuan":"kali","sumber":"skenario tengah rencana operasi: tiga giliran, dua regu bekerja"},"masker_per_orang":{"nilai":2,"satuan":"masker/orang terdampak","sumber":"ASUMSI platform: dua masker per orang untuk satu episode asap"}},"asumsi":true,"dasar":{"titik_panas":"Titik panas 2019–2025 sampai 24 Okt 2026","operasi":"Cluster operasi per 24 Okt 2026","kluster":"Kluster titik panas","penduduk":"Penduduk WorldPop 2026","tahun_el_nino":[2019,2023],"roni_sekarang":1.69,"analog_relevan":true,"umur_titik_hari":0},"batas":["Klimatologi titik panas 2019-2025 pada jendela yang sama, bukan prakiraan; ENSO dan IOD diwakili hanya lewat skenario tahun El Nino.","Koefisien operasional dan tarif adalah asumsi kerja, bukan RAB; Manggala Agni yang sudah dibiayai DIPA tetap dihitung agar skala kebutuhan terlihat.","Rentang rupiah hanya memvariasikan tahun (paling sepi sampai paling ramai) dan jam heli (1,5 sampai 6); tarif dan koefisien lain tetap, jadi bukan selang kepercayaan.","Skenario analog = tahun El Nino di 2019-2025 (jumlahnya sedikit). Titik per cluster, porsi prioritas, dan regu-hari per cluster berasal dari kondisi cluster saat ini, bukan dari tahun analog.","Provinsi dengan kurang dari 5 cluster operasi tidak punya koefisien yang layak: komponennya kosong, bukan nol."],"horizon":[30,60,90],"skenario":[{"id":"rata","nama":"Rerata 2019-2025"},{"id":"analog","nama":"Tahun El Nino"}],"tahun_dipakai":{"rat