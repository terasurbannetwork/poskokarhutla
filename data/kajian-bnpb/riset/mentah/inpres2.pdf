        <!-- popup login and register -->
        <script type="text/javascript">
            var registerSuccess = "";
            var failedLogin     = "";
            var projectalert    = "";
            var succsess    = "";
            var errorStore    = "";

            if (registerSuccess)
            {
                window.onload = function(){ 
                    openPopup('#popup-thanks');
                    return false;
                };
            }

            if (succsess)
            {
                window.onload = function(){ 
                    openPopup('#popup-thanksform');
                    return false;
                };
            }

            if (failedLogin)
            {
                window.onload = function(){ 
                    openPopup('#popup-failedlogin');
                    return false;
                };
            }


            if (projectalert)
            {
                window.onload = function(){ 
                    openPopup('#popup-projectalert');
                    return false;
                };
            }

            if (errorStore)
            {
                window.onload = function(){ 
                    openPopup('#popup-errorstore');
                    return false;
                };
            }
        </script>
