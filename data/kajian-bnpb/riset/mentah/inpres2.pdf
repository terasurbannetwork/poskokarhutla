        <!-- popup login and register -->
        <div class="popup" id="popup-login">
            <div class="inner-popup log-popup">
                <div class="close-popup" id="close-login">
                    <span></span><span></span>
                </div>
                <div class="side-icon">
                    <img src="https://jdih.kemenkoinfra.go.id/fe/images/content/icon-user.svg" alt="">
                    <h4>Login</h4>
                </div>
                <p>Silakan memasukkan email &amp; password dibawah ini</p>
                <div class="box-form">
                    <form action="https://jdih.kemenkoinfra.go.id/login" method="post" class="formpopuplogin">
                        <input type="hidden" name="_token" value="F5NLKLyOY4q4VNbgA1jOmmzSJmant5vTE4pwOk7h">                        <div class="row">
                            <div class="column">
                                <label>Email <i class="rq">*</i></label>
                                <input type="email" placeholder="Email" name="email" class="" required>
                                <span class="note-text error"></span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="column">
                                <label>Password <i class="rq">*</i></label>
                                <div class="text-password">
                                    <input type="password" placeholder="Password" name="password" class="" required>
                                    <div class="show-pass"></div>
                                </div>
                                <span class="note-text error"></span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="column">
                                <div id="captcha-login">
									<input type="text" style="display:none" class="hiddenRecaptcha required" name="hiddenRecaptcha" >
									<script src="https://www.google.com/recaptcha/api.js?hl=id"></script>
        <div class="g-recaptcha" data-sitekey="6LeUsnMrAAAAAF5QkZcT5CERd-IiyYLhMJVTEKT6"></div>
									<span class="note-text" style="color:#fff;"></span>
								</div>
                            </div>
                        </div>
                        <div class="row remember-login">
                            <div class="column">
                                <div class="checkbox">
                                    <input type="checkbox" name="remember">
                                    <i></i>
                                    <span>Ingat saya</span>
                                </div>
                            </div>
                            <div class="column text-right">
                                <a onclick="closePopup('.popup');openPopup('#popup-forgot-password');">Forgot Password</a>
                            </div>
                        </div>
                        <div class="row">
                            <div class="column">
                                <input type="submit" value="LOGIN" class="button button-blue-light type2 full-width submitlogin">
                            </div>
                        </div>
                        <!-- <p class="text-center">Belum punya akun? <a onclick="closePopup('.popup');openPopup('#popup-register');"><b>DAFTAR SEKARANG</a></b></p> -->
                    </form>
                </div>
            </div>
        </div>

        <div class="popup" id="popup-forgot-password">
            <div class="inner-popup log-popup">
                <div class="close-popup">
                    <span></span><span></span>
                </div>
                <div class="side-icon">
                    <img src="https://jdih.kemenkoinfra.go.id/fe/images/content/icon-user.svg" alt="">
                    <h4>Forgot Password</h4>
                </div>
                <p>Masukkan alamat email yang Anda gunakan saat bergabung dan kami akan mengirimkan instruksi untuk mereset kata sandi Anda.</p>
                <div class="box-form">
                    <form action="https://jdih.kemenkoinfra.go.id/fogot-password" method="post" class="formpopupforgot">
                        <input type="hidden" name="_token" value="F5NLKLyOY4q4VNbgA1jOmmzSJmant5vTE4pwOk7h">                        <div class="row">
                            <div class="column">
                                <label>Email <i class="rq">*</i></label>
                                <input type="email" name="email" placeholder="Email" required>
                            </div>
                        </div>
                        <div class="row">
                            <div class="column">
                                <input type="submit" value="KIRIM RESET INSTRUKSI" class="button button-blue-light type2 full-width submitforgot">
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="popup" id="popup-register">
            <div class="inner-popup log-popup">
                <div class="close-popup">
                    <span></span><span></span>
                </div>
                <div class="side-icon">
                    <img src="https://jdih.kemenkoinfra.go.id/fe/images/content/icon-user.svg" alt="">
                    <h4>Register</h4>
                </div>
                <p>Hanya untuk Perancang di lingkungan Kemenko Bidang Kemaritiman dan Investasi</p>
                <div class="box-form">
                    <form action="https://jdih.kemenkoinfra.go.id/register" method="post" class="formpopupregister">
                        <input type="hidden" name="_token" value="F5NLKLyOY4q4VNbgA1jOmmzSJmant5vTE4pwOk7h">                        <div class="row">
                            <div class="column">
                                <label>Nama Lengkap <i class="rq">*</i></label>
                                <input type="text" placeholder="Nama Lengkap Anda" name="nama" class="" required>
                                <span class="note-text error"></span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="column">
                                <label>No. Telepon <i class="rq">*</i></label>
                                <input type="text" placeholder="No. Telepon Anda" name="no_tlp" class=" numberonly" required>
                                <span class="note-text error"></span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="column">
                                <label>Email <i class="rq">*</i></label>
                                <input type="email" placeholder="Email Anda" name="emails" class="" required>
                                <span class="note-text error"></span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="column">
                                <label>Password <i class="rq">*</i></label>
                                <input type="password" placeholder="Password Anda" name="password" class="" required>
                                <span class="note-text error"></span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="column">
                                <input type="submit" value="REGISTER" class="button button-blue-light type2 full-width submitregister">
                            </div>
                        </div>
                        <p class="text-center">Sudah punya akun? <a onclick="closePopup('.popup');openPopup('#popup-login');"><b>LOGIN DISINI</a></b></p>
                    </form>
                </div>
            </div>
        </div>

        <script type="text/javascript">
            $(".formpopuplogin").each(function(){
                $(this).validate({
                    rules: {
                        validationField: {              
                            required: true
                        }
                    },  
                    errorElement: 'div',
                    errorClass: 'error note-text',
                    highlight: function(element) {
                        $(element).addClass('error');
                    },
                    unhighlight: function(element) {
                        $(element).removeClass('error');
                    },
                    submitHandler: function(form) { // <- pass 'form' argument in
                        $(".submitlogin").attr("disabled", true);
                        form.submit(); // <- use 'form' argument here.
                    }
                });
            });

            $(".formpopupforgot").each(function(){
                $(this).validate({
                    rules: {
                        validationField: {              
                            required: true
                        }
                    },  
                    errorElement: 'div',
                    errorClass: 'error note-text',
                    highlight: function(element) {
                        $(element).addClass('error');
                    },
                    unhighlight: function(element) {
                        $(element).removeClass('error');
                    },
                    submitHandler: function(form) { // <- pass 'form' argument in
                        $(".submitforgot").attr("disabled", true);
                        form.submit(); // <- use 'form' argument here.
                    }
                });
            });

            $(".formpopupregister").each(function(){
                $(this).validate({
                    rules: {
                        validationField: {              
                            required: true,
                        },

                    },  
                    errorElement: 'div',
                    errorClass: 'error note-text',
                    highlight: function(element) {
                        $(element).addClass('error');
                    },
                    unhighlight: function(element) {
                        $(element).removeClass('error');
                    },
                    submitHandler: function(form) { // <- pass 'form' argument in
                        $(".submitregister").attr("disabled", true);
                        form.submit(); // <- use 'form' argument here.
                    }
                });
            });

        </script>

        
