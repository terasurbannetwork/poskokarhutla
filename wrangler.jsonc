{
  // Nama worker = worker yang memegang domain pantau.terasurban.com, secret, dan jadwal cron. 16 Okt 2026 worker
  // aslinya berganti nama jadi centurisk97 di dasbor; terbit berikutnya membuat worker "poskokarhutla" baru tanpa
  // domain dan secret, dan situs publik membeku sejak 17 Okt 00.42 WIB. Jangan ganti nama ini tanpa memindah domain + secret.
  "name": "centurisk97",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "html_handling": "none", "run_worker_first": ["/*.html"] },
  // run_worker_first larik (wrangler >= 4; wrangler@3 menolaknya, jadi SEMUA workflow deploy memakai wrangler@4.42.0): "*" mencocokkan
  // dalam sampai subfolder, jadi hanya berkas .html yang lewat Worker (gerbang centurisk97.id, halamanTerkunci di src/worker.js);
  // JS/CSS/JSON/gambar tetap dilayani aset tanpa memanggil Worker.
  "d1_databases": [
    { "binding": "DB", "database_name": "poskowarga", "database_id": "2357f51f-540c-482c-8bf1-3130ddb7f196", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "poskokarhutla-foto" }],
  // Workers AI: hitung orang di foto/video lapangan instansi (src/instansi.js, @cf/facebook/detr-resnet-50). Tanpa binding, hitungan kosong dan isian tetap tersimpan.
  "ai": { "binding": "AI" },
  "triggers": { "crons": ["* * * * *"] },
  /* WA_NOMOR = nomor bot WhatsApp Fonnte, tampil sebagai tombol kontak WA di ringkasan /api/pantau/ringkas; isi di dashboard/secret per lingkungan */
  "vars": { "SIHKA_CADANGAN": "1", "TURNSTILE_SITEKEY": "", "FOTO_DUMMY_PUBLIK": "1", "EMAIL_TO": "terasurbannetwork@gmail.com", "EMAIL_FROM": "Centurisk97 <onboarding@resend.dev>", "WA_NOMOR": "" },
  "observability": { "enabled": true }
}
