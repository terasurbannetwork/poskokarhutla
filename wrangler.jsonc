{
  // Nama worker = worker yang memegang domain pantau.terasurban.com, secret, dan jadwal cron. 16 Okt 2026 worker
  // aslinya berganti nama jadi centurisk97 di dasbor; terbit berikutnya membuat worker "poskokarhutla" baru tanpa
  // domain dan secret, dan situs publik membeku sejak 17 Okt 00.42 WIB. Jangan ganti nama ini tanpa memindah domain + secret.
  "name": "centurisk97",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "html_handling": "none" },
  // BELUM AKTIF (butuh wrangler >= 4.x di deploy; wrangler@3 terbaru, 3.114.17, menolak larik): tambahkan ke "assets" `"run_worker_first": ["/*.html"]`
  // agar berkas .html dibuka langsung (/laporan.html, /index.html, ...) juga melewati gerbang centurisk97.id di src/worker.js (halamanTerkunci). Uji posko.test.mjs sudah menjaga sisi Worker.
  "d1_databases": [
    { "binding": "DB", "database_name": "poskowarga", "database_id": "2357f51f-540c-482c-8bf1-3130ddb7f196", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "poskokarhutla-foto" }],
  "triggers": { "crons": ["* * * * *"] },
  "vars": { "TURNSTILE_SITEKEY": "", "FOTO_DUMMY_PUBLIK": "1", "EMAIL_TO": "terasurbannetwork@gmail.com", "EMAIL_FROM": "Pantau Bencana <onboarding@resend.dev>" },
  "observability": { "enabled": true }
}
