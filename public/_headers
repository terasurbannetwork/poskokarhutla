# Header keamanan untuk aset statis (Workers Static Assets membaca berkas ini; tidak ikut terunggah sebagai aset).
# Respons /api/* dari src/worker.js tidak melewati berkas ini. CSP masih Report-Only: pelanggaran hanya muncul di konsol
# browser. Setelah seminggu konsol bersih di semua halaman/tab, ganti nama header menjadi Content-Security-Policy.
# 'unsafe-inline' wajib selama index.html memuat <script>/<style> inline dan handler onerror=; img-src https: untuk
# thumbnail berita dan favicon dari domain mana saja.
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(), usb=()
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://tiles.openfreemap.org https://server.arcgisonline.com https://tiles.globalforestwatch.org https://gibs.earthdata.nasa.gov https://api.open-meteo.com https://archive-api.open-meteo.com; worker-src 'self' blob:; child-src blob:; frame-src https://challenges.cloudflare.com https://www.instagram.com https://platform.twitter.com https://www.threads.com; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'

# Cache (dibaca Workers Static Assets; aturan yang cocok digabung dengan /* di atas).
# Data diperbarui tiap 3 jam (titik.yml) / harian: 5 menit segar, sesudahnya disajikan lama sambil diperbarui di belakang.
# JS/CSS: scripts/terbit/versi.py (dijalankan di Actions sebelum deploy) memberi ?v=<hash isi> dan menambah aturan immutable
# per berkas di bawah blok ini; berkas tanpa versi tetap pakai bawaan Cloudflare (revalidasi ETag).
/data/*
  Cache-Control: public, max-age=300, stale-while-revalidate=3600
/banjir/data/*
  Cache-Control: public, max-age=300, stale-while-revalidate=3600
/geo/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/lambang/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
