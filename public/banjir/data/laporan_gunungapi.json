h Airport: pada skenario bila gunung meletus sekarang, abu di atas ambang penerbangan 2 mg/m³ tiba sekitar 1 jam lagi. Skenario Pantau Bencana, bukan prakiraan letusan dan bukan VAAC.","prov":"35","tautan":"/gunungapi/"},{"tingkat":"waspada","judul":"Skenario: abu G. Merapi bisa tiba di CXP","teks":"Tunggul Wulung Airport: pada skenario bila gunung meletus sekarang, abu di atas ambang penerbangan 2 mg/m³ tiba sekitar 10 jam lagi. Skenario Pantau Bencana, bukan prakiraan letusan dan bukan VAAC.","prov":"33","tautan":"/gunungapi/"}],"prakiraan":{"judul":"Skenario jangkauan abu pada jam ke-24, 48, dan 72 (km dari puncak, bukan VAAC)","label_kolom":["jam ke-24","jam ke-48","jam ke-72"],"hari":["2026-10-20","2026-10-21","2026-10-22"],"baris":[{"label":"G. Anak Krakatau","prov":"18","nilai":[213,null,null],"satuan":"km"}]},"tambahan":[{"id":"perubahan","judul":"Perubahan level 30 hari","kolom":["Tanggal","Gunung","Dari","Ke"],"baris":[["2026-10-19","Sinabung","III (Siaga)","II (Waspada)"]]}],"sumber":[{"nama":"MAGMA Indonesia, PVMBG (Badan Geologi)","url":"https://magma.esdm.go.id/","catatan":"level, radius rekomendasi, erupsi"},{"nama":"Open-Meteo","url":"https://open-meteo.com/","catatan":"angin untuk skenario jangkauan abu (Pantau Bencana, bukan VAAC)"}]}