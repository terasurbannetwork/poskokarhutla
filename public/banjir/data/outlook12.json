":1.07,"p_perm":0.333},{"a":"cuaca","b":"rob","n_a":2581,"n_lalu_b":74,"frac":0.029,"peluang_acak_bulan_sama":0.027,"lift":1.04,"p_perm":0.429},{"a":"longsor","b":"cuaca","n_a":1289,"n_lalu_b":1088,"frac":0.844,"peluang_acak_bulan_sama":0.824,"lift":1.02,"p_perm":0.048}]},"uji_balik":{"karhutla":{"skill":0.426,"skill_bulan":[-0.262,-0.068,-0.062,-0.062,-0.245,-0.139,0.138,0.653,0.414,0.381,0.355,0.126],"n_tahun":24,"bulan_skill_positif":6}},"batasan":["DIBI 2008-kini tidak terjangkau saat dibuat: banjir/longsor memakai klimatologi riwayat.json tanpa tahun pembanding; cuaca, kekeringan, gelombang, rob tidak ada tabel. Berantai memakai 3 tahun terakhir saja.","Pendorong 12 bulan ke depan = persistensi nilai terakhir (lihat iklim_outlook.json); bila El Nino/IOD berubah, tahun pembanding berubah.","Tahun pembanding hanya 5 tahun dari 18 (DIBI 2008-2025) atau 24 (MODIS 2002-2025): satu tahun luar biasa menggeser angka. Uji balik leave-one-out menentukan apakah analog dipakai.","DIBI hanya mencatat kejadian yang dilaporkan dan per kabupaten (satu kejadian lintas kabupaten bisa terhitung berkali-kali); indeks dinormalkan tren, bukan koreksi bias pelaporan.","Gempa tidak diprakirakan; angka adalah laju historis M>=6 dangkal 1990-2025 (laju.json, sudah di-declustering Gardner-Knopoff, satu sumber dengan peluang_gempa.py), dianggap tetap sepanjang tahun.","Gunung api tidak masuk: repo belum punya riwayat erupsi bulanan.","Pasang tertinggi adalah indeks gaya astronomis, bukan tinggi air dan bukan prakiraan rob.","Berantai: korban satu kejadian besar dihitung ulang di tiap pasangan yang jendelanya menjangkaunya (gelombang banjir Sumatra Nov 2025 mendominasi data 3 tahun); jangan dibaca sebagai jumlah korban unik. Berantai = kebersamaan statistik dalam 30 hari di provinsi yang sama, bukan sebab-akibat; lift mendekati 1 berarti hampir sama dengan kebetulan. Korban hanya meninggal dari DIBI; gempa tanpa korban di sini."]}