# Salin ke scripts/wa/.env (gitignored). Jangan commit nilai asli.
WORKER_URL=https://centurisk97.id
# Kunci gerbang POST /api/wa/gateway, dikirim sebagai header x-wa-kunci
WA_KUNCI=
# Token mesin untuk GET /api/wa/masuk dan /api/wa/berkas (Authorization: Bearer)
WA_MESIN=
# Nomor pengirim bahan yang diizinkan, pisah koma (08.. atau 62..)
WA_IZIN=
# Penerima PDF dan PPTX: nomor atau JID grup (...@g.us), pisah koma
PENERIMA=
# Nomor pemilik: HANYA menerima kabar galat
PEMILIK=
# Token API lokal gateway (header Authorization), bebas, panjang
GATEWAY_TOKEN=
PORT=3101
# Opsional
# WA_AUTH_DIR=~/.wa-bot/auth
# WA_PYTHON=python3
