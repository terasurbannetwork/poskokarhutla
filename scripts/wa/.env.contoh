# Salin ke scripts/wa/.env (gitignored). Jangan commit nilai asli.
WORKER_URL=https://centurisk97.id
# Kunci gerbang POST /api/wa/gateway, dikirim sebagai header x-wa-kunci
WA_KUNCI=
# Token mesin untuk GET /api/wa/masuk dan /api/wa/berkas (Authorization: Bearer)
WA_MESIN=
# Nomor pengirim bahan yang diizinkan, pisah koma (08.. atau 62..)
WA_IZIN=
# Penerima PDF dan PPTX: nomor atau JID grup (...@g.us), pisah koma
PENERIMA=
# Nomor pemilik: HANYA menerima kabar galat
PEMILIK=
# Token API lokal gateway (header Authorization), bebas, panjang
GATEWAY_TOKEN=
PORT=3101
# Google Drive (opsional; kosong = semua alur Drive mati). Refresh token ada di ~/.wa-bot/drive.json, bukan di sini
DRIVE_CLIENT_ID=
DRIVE_CLIENT_SECRET=
# Id folder root di Drive pemilik (bagian akhir URL folder)
DRIVE_ROOT=
# Id folder "1. Laporan Harian" (Tim IT BNPB). Laporan harian/karhutla dan Laporan Harian Dirdalops yang diteruskan ke WA
# disimpan di subfolder bernomornya, bersusun Tahun/Bulan/Minggu/Hari. Kosong = laporan ke <root>/Laporan
DRIVE_LAPORAN=
# Opsional
# WA_AUTH_DIR=~/.wa-bot/auth
# WA_PY_BIN=~/.wa-bot/py/bin
# Laporan Penanganan Banjir, Longsor dan Rob (penanganan_banjir.py) ikut dikirim ke PENERIMA sesudah 17.00 WIB; isi 0 untuk mematikan
# LAPORAN_BANJIR=1   (mati bawaan; 1 = kirim deck penanganan banjir harian)
# Peringatan dini hujan lebat per kabupaten H+1..H+3 (teks harian, sesudah 07.00 WIB). Kosong = MATI. Nomor atau JID grup, pisah koma
PENERIMA_PERINGATAN_BANJIR=
# G5 logbook (kosong = mati). Grup BPBD yang dipantau (JID ...@g.us, pisah koma) dan staf piket (NOMOR perorangan, pisah koma; JID grup ditolak dan fitur mati) yang mengonfirmasi draf
# LOGBOOK_GRUP=
# Operasi Lapangan (OP-2): grup WA satgas udara yang dibaca penuh tanpa forward (JID ...@g.us, pisah koma). Bot diam di grup; kosong = mati
# OPERASI_GRUP=
# LOGBOOK_STAF=
# Akun staf (peran pusdalops) untuk POST /api/logbook/*; dibuat pemilik di /admin, sandi hanya di .env lokal
# LOGBOOK_USER=
# LOGBOOK_SANDI=
# Renlap Operasi Lapangan: malam sesudah 20.00 WIB, pagi sesudah 07.00 WIB (renlap.py buat --kirim-api; draf tampil di layar; PDF per base ke PEMILIK saja, TIDAK ke grup WA, keputusan K2). Gagal = kabar PEMILIK sekali. Kosong = MATI
# RENLAP=1
# Jarak pandang BMKG tiap jam, 05-18 WIB (metar.py lalu POST /api/jarak-pandang; BMKG menolak IP GitHub Actions). Hanya dikirim bila sumber BMKG. Gagal = kabar PEMILIK sekali sehari. Kosong = MATI
# JARAK_PANDANG=1
# Bot laporan dengan Claude API (data/kajian-bnpb/bot-laporan). Kunci hanya di .env mesin (0600), tidak di Worker atau repo
# ANTHROPIC_API_KEY=
# Router API di depan beberapa akun Anthropic (mis. 9router, pemilik 19 Nov 2026). Isi alamatnya di sini dan kunci router di ANTHROPIC_API_KEY.
# Kosong = API Anthropic langsung. Uji dulu: node scripts/wa/uji_router.mjs
# ANTHROPIC_BASE_URL=
# Batas belanja Claude per hari WIB dalam USD; lewat batas, panggilan baru ditolak dan pemilik dikabari sekali
# BL_BATAS_USD=10
# Nyalakan perintah buat, status, dan bantuan untuk bot proyek (BL-08). Kosong = perintah lama tetap jalan.
# BL_PROYEK=1
# Anggaran Claude per bulan dalam USD untuk baris "sisa sekitar" di pesan final dan perintah *biaya* pemilik (K25). Kosong = pemakaian saja
# BL_ANGGARAN_BULAN=200
# Bot V2: agen Claude Code (data/kajian-bnpb/bot-laporan K22-K24, K40). 2 = semua nomor terdaftar memakai V2 (BL_V2_NOMOR terisi = hanya nomor itu); kosong = semua V1
# BL_VERSI=2
# Batasi V2 ke nomor tertentu, pisah koma (kosong = semua nomor terdaftar, K40)
# BL_V2_NOMOR=
# Biaya agen V2 per jalan dalam USD (Q15); batas harian tetap BL_BATAS_USD (naikkan ke 25 bila memakai V2)
# BL_AGEN_USD=4
# Batas biaya per laporan dalam USD; kosong = tanpa batas (K40, pemilik 19 Nov 2026)
# BL_AGEN_PROYEK_USD=
# Kunci API khusus V2 dari workspace Console tersendiri dengan batas belanja (dianjurkan, Q17); kosong = ANTHROPIC_API_KEY
# BL_AGEN_KUNCI=
# Bot V2.1 (K29, D30-D35): 0 = matikan pemahaman kalimat bebas (BL_MAKSUD) atau rapikan bahan saat generator gagal (BL_RAPIKAN). Kosong = nyala
# BL_MAKSUD=1
# BL_RAPIKAN=1
# Model pemahaman kalimat bebas (D32); kosong = claude-haiku-5-5
# BL_MODEL_MAKSUD=
# Matikan laporan terjadwal (harian 12.00, penanganan 18.00) supaya semua laporan lewat bot proyek (K16). Renlap tetap jalan.
# WA_OTOMATIS=0
# Lapor Bencana BNPB (LA-20): pintu WA memakai WORKER_URL dan WA_MESIN yang sama. Nomor penguji didaftarkan PEMILIK lewat WA:
#   lapor izin <nomor> [bpbd <kab>]   |   lapor cabut <nomor>
# Python untuk scripts/lapor/dokumen.py (butuh python-docx dan LibreOffice); kosong = python3 di PATH
# LAPOR_PY=
