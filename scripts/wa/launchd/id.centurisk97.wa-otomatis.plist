<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- TEMPLATE, belum terpasang. Ganti __REPO__ (path repo) dan __NODE__ (hasil: which node) lalu salin ke ~/Library/LaunchAgents/. Lihat scripts/wa/README.md. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>id.centurisk97.wa-otomatis</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__REPO__/scripts/wa/otomatis.mjs</string>
  </array>
  <key>StartInterval</key>
  <integer>600</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/.wa-bot/log/otomatis.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.wa-bot/log/otomatis.err.log</string>
</dict>
</plist>
