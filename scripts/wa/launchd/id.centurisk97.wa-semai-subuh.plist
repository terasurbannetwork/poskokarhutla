<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- TEMPLATE, belum terpasang. SA-24 Peringatan sebelum subuh: 05.15 WIB, lalu 05.45, 06.15, 06.45 bila putaran pagi belum terbit (idempoten per hari, jam lokal mesin = WIB). Mati bila PENERIMA_SEMAI kosong. Ganti __REPO__ __NODE__ __HOME__. Lihat scripts/wa/README.md. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>id.centurisk97.wa-semai-subuh</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__REPO__/scripts/wa/semai_subuh.mjs</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>5</integer><key>Minute</key><integer>15</integer></dict>
    <dict><key>Hour</key><integer>5</integer><key>Minute</key><integer>45</integer></dict>
    <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>15</integer></dict>
    <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>45</integer></dict>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/.wa-bot/log/semai-subuh.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.wa-bot/log/semai-subuh.err.log</string>
</dict>
</plist>
