<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- TEMPLATE, belum terpasang. Ganti __REPO__ (path repo), __NODE__ (hasil: which node), __HOME__ lalu salin ke ~/Library/LaunchAgents/. Lihat scripts/wa/README.md (Lapor Bencana). -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>id.centurisk97.wa-lapor-pdf</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__REPO__/scripts/wa/lapor_pdf.mjs</string>
  </array>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/Applications/LibreOffice.app/Contents/MacOS</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/.wa-bot/log/lapor-pdf.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.wa-bot/log/lapor-pdf.err.log</string>
</dict>
</plist>
