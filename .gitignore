.env
data/raw/*
!data/raw/banjir/
data/raw/banjir/*
# titik & ambang sungai/rob mahal dibuat ulang (kuota Open-Meteo): ikut di-commit
!data/raw/banjir/sungai_titik.json
!data/raw/banjir/sungai_ambang.json
!data/raw/banjir/rob/
data/raw/banjir/rob/*
!data/raw/banjir/rob/titik.json
!data/raw/banjir/rob/ambang.json
# berita: label tangan untuk validasi sentimen ikut di-commit; arsip.json lewat cache Actions, pusat.json dibuat ulang
!data/raw/berita/
data/raw/berita/*
!data/raw/berita/label_uji.json
!data/raw/berita/label_uji_en.json
# label AI (pedoman scripts/data/PEDOMAN-LABEL.md) + sampel periksa manusia
!data/raw/berita/label_ai.json
!data/raw/berita/periksa_manusia.json
# konsesi: data bernama (pemegang izin, grup) hanya di sini, TIDAK diterbitkan di situs (keputusan pemilik 14 Okt 2026).
# Yang di-commit: daftar sanksi (kurasi tangan, bersumber) dan profil grup; batas & cache unduhan dibuat ulang.
!data/raw/konsesi/
data/raw/konsesi/*
!data/raw/konsesi/sanksi_karhutla.json
!data/raw/konsesi/grup_perusahaan.json
__pycache__/
.DS_Store
data/graf_jalan.json.gz

# Lapor Warga
node_modules/
.dev.vars

# citra satelit: dibuat ulang tiap hari di Actions (cache data-), tidak di-commit
public/data/citra/
public/data/citra.json
# cuaca per jam per sel (scripts/data/cuaca_jam.py): dibuat ulang di Actions, lewat cache data-
public/data/cuaca/

# state lokal wrangler (D1 miniflare dll.)
.wrangler/
scripts/data/.cache/

# gambar pratinjau tautan dibuat di Actions
public/data/og/
